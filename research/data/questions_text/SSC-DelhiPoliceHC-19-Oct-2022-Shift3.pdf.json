{"paper": "SSC-DelhiPoliceHC-19-Oct-2022-Shift3.pdf", "status": "ok", "mode": "sequential", "splitter": "qdot", "section_slice": true, "extracted_count": 20, "tagged_count": 20, "questions": [{"n": 1, "text": "", "options": [], "options_source": "missing", "image_only": true, "topic": "Trigonometry", "sub": "identities", "key_answer": null}, {"n": 2, "text": "A person borrowed some money on compound interest and returned it in 3 equal annual instalments. If the rate of interest is 15% per annum and the annual instalment is ₹12,167, then find the sum borrowed.", "options": [{"text": "₹27,780", "added": false}, {"text": "₹25,780", "added": false}, {"text": "₹26,970", "added": false}, {"text": "₹28,530", "added": false}], "options_source": "real", "image_only": false, "topic": "Compound Interest", "sub": "ci-instalments", "key_answer": null}, {"n": 3, "text": "If a person’s weight decreases from 160 pounds to 152 pounds, what is the percentage decrease in the person’s weight?", "options": [{"text": "7%", "added": false}, {"text": "5%", "added": false}, {"text": "4%", "added": false}, {"text": "6%", "added": false}], "options_source": "real", "image_only": false, "topic": "Percentage", "sub": "increase-decrease", "key_answer": null}, {"n": 4, "text": "A tradesman marks his goods at 40% above the cost price. He allows his customers a discount of 16% on the marked price. The profit percentage is:", "options": [{"text": "17.6%", "added": false}, {"text": "16.6%", "added": false}, {"text": "15.6%", "added": false}, {"text": "17.1%", "added": false}], "options_source": "real", "image_only": false, "topic": "Discount", "sub": "mp-sp-relation", "key_answer": null}, {"n": 5, "text": "The ratio of two integers is 3 ∶ 5 such that their sum is 64. Find the largest integer.", "options": [{"text": "40", "added": false}, {"text": "44", "added": false}, {"text": "24", "added": false}, {"text": "48", "added": false}], "options_source": "real", "image_only": false, "topic": "Ratio-Proportion", "sub": "ratio-basics", "key_answer": null}, {"n": 6, "text": "", "options": [{"text": "1", "added": false}, {"text": "3", "added": false}, {"text": "0", "added": false}, {"text": "2", "added": false}], "options_source": "real", "image_only": true, "topic": "Algebra", "sub": "identities", "key_answer": null}, {"n": 7, "text": "A dishonest tradesman sells rice at Rs.40 per kg, which he has bought at Rs.30 per kg, and he gives 600 gm to the customer instead of 1 kg. Find his overall profit percentage.", "options": [{"text": "122.22%", "added": false}, {"text": "73.33%", "added": false}, {"text": "105.55%", "added": false}, {"text": "94.44%", "added": false}], "options_source": "real", "image_only": false, "topic": "Profit-Loss", "sub": "dishonest-dealer", "key_answer": null}, {"n": 8, "text": "What is the volume of a hemisphere having a diameter of 4.2 cm? (Take π = 22/7)", "options": [], "options_source": "missing", "image_only": false, "topic": "Mensuration 3D", "sub": "sphere-hemisphere", "key_answer": null}, {"n": 9, "text": "", "options": [{"text": "(-316)", "added": false}, {"text": "(216)", "added": false}, {"text": "(-216)", "added": false}, {"text": "(316)", "added": false}], "options_source": "real", "image_only": true, "topic": "Simplification", "sub": "bodmas", "key_answer": null}, {"n": 10, "text": "", "options": [], "options_source": "missing", "image_only": true, "topic": "Number System", "sub": "fractions-decimals", "key_answer": null}, {"n": 11, "text": "", "options": [{"text": "10,000 tons", "added": false}, {"text": "40,000 tons", "added": false}, {"text": "20,000 tons", "added": false}, {"text": "30,000 tons", "added": false}], "options_source": "real", "image_only": true, "topic": "Data Interpretation", "sub": "bar-graph", "key_answer": null}, {"n": 12, "text": "15 men take 6 days to complete a job working 5 hours a day. How many hours a day should 18 men take to complete the job in 6 days?", "options": [], "options_source": "missing", "ima