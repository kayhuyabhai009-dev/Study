text": "441", "added": false}, {"text": "17", "added": false}, {"text": "21", "added": false}], "options_source": "real", "image_only": false, "topic": "Ratio-Proportion", "sub": "proportion", "key_answer": null}, {"n": 8, "text": "A motor boat can travel 40 km downstream and 30 kmupstream in 10 hours. It can travel 80 km downstream and 40 km upstream in 15 hours. Find the speed of the boat in still water.", "options": [{"text": "4 km/h", "added": false}, {"text": "10 km/h", "added": false}, {"text": "16 km/h", "added": false}, {"text": "8 km/h", "added": false}], "options_source": "real", "image_only": false, "topic": "Boats-Streams", "sub": "upstream-downstream", "key_answer": null}, {"n": 9, "text": "A solid hemisphere of radius 12 cm is melted into ‘n’ identical cones, whose radius is 6 cm and height is 8cm. What is the value of ‘n’?", "options": [{"text": "14", "added": false}, {"text": "13", "added": false}, {"text": "15", "added": false}, {"text": "12", "added": false}], "options_source": "real", "image_only": false, "topic": "Mensuration 3D", "sub": "conversion-and-melting", "key_answer": null}, {"n": 10, "text": "", "options": [], "options_source": "missing", "image_only": true, "topic": "Time-Work", "sub": "together-apart", "key_answer": null}, {"n": 11, "text": "The population of a city increases at the rate of 10% per annum. If its population in 2005 was 2 crore, the population of the city in the year 2007 would be:", "options": [{"text": "2.22 crore", "added": false}, {"text": "2.42 crore", "added": false}, {"text": "2.20 crore", "added": false}, {"text": "2.40 crore", "added": false}], "options_source": "real", "image_only": false, "topic": "Percentage", "sub": "population-and-depreciation", "key_answer": null}, {"n": 12, "text": "If 3 is added to two numbers, the ratio is 4 : 5 and if the same number is subtracted from the two numbers, the ratio is 1 : 2. The numbers are:", "options": [{"text": "5 and 7", "added": false}, {"text": "7 and 5", "added": 