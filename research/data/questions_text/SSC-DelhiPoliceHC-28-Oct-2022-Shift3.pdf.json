aces) is:", "options": [{"text": "17.34", "added": false}, {"text": "18.37", "added": false}, {"text": "15.23", "added": false}, {"text": "16.25", "added": false}], "options_source": "real", "image_only": false, "topic": "Average", "sub": "weighted-average", "key_answer": null}, {"n": 14, "text": "One boy and one girl together can complete a piece of work in 4 days. One boy alone can complete the work in 5 days. In how many days can one girl alone complete the work?", "options": [{"text": "22 days", "added": false}, {"text": "10 days", "added": false}, {"text": "20 days", "added": false}, {"text": "15days", "added": false}], "options_source": "real", "image_only": false, "topic": "Time-Work", "sub": "together-apart", "key_answer": null}, {"n": 15, "text": "", "options": [], "options_source": "missing", "image_only": true, "topic": "Permutation and Combination", "sub": "selections-with-restrictions", "key_answer": null}, {"n": 16, "text": "", "options": [{"text": "y2", "added": false}, {"text": "x", "added": false}, {"text": "y", "added": false}, {"text": "x2", "added": false}], "options_source": "real", "image_only": true, "topic": "Ratio-Proportion", "sub": "proportion", "key_answer": null}, {"n": 17, "text": "Find the compound interest on Rs.15,625 in 2 years at 8% per annum, the interest being compounded half-yearly.", "options": [{"text": "Rs.8,279.04", "added": false}, {"text": "Rs.8,654.04", "added": false}, {"text": "Rs.18,279.04", "added": false}, {"text": "Rs.2,654.04", "added": false}], "options_source": "real", "image_only": false, "topic": "Compound Interest", "sub": "compounding-frequency", "key_answer": null}, {"n": 18, "text": "", "options": [], "options_source": "missing", "image_only": true, "topic": "Sequences and Series", "sub": "geometric-progression", "key_answer": null}, {"n": 19, "text": "", "options": [], "options_source": "missing", "image_only": true, "topic": "Trigonometry", "sub": "ratios-and-tables", "key_answer": null}, {"n": 20, "text"