{"paper": "2025-Tier1-19-Sep-2025-Shift2.pdf", "status": "ok", "mode": "letter-sequence", "splitter": "qn", "section_slice": false, "extracted_count": 94, "tagged_count": 25, "questions": [{"n": 1, "text": "Which ISRO mission achieved the first soft landing near the lunar south pole?", "options": [{"text": "Chandrayaan-1", "added": false}, {"text": "Chandrayaan-2", "added": false}, {"text": "Chandrayaan-3", "added": false}, {"text": "Aditya-L1", "added": false}], "options_source": "real", "image_only": false, "topic": "Profit-Loss", "sub": "profit-loss-percent", "key_answer": "a"}, {"n": 2, "text": "A shopkeeper mixes two types of pulses – one costing ₹80 per kg and the other costing ₹120 per kg, in the ratio 3 : 2. If he sells the mixture at ₹105.60 per kg, find his profit or loss percent.", "options": [{"text": "10% Profit", "added": false}, {"text": "10% Loss", "added": false}, {"text": "12% Profit", "added": false}, {"text": "12% Loss", "added": false}], "options_source": "real", "image_only": false, "topic": "Circles-Polygons", "sub": "polygons", "key_answer": "a"}, {"n": 3, "text": "What is the ratio of the area of a regular hexagon to the area of an equilateral triangle if both have the same side length?", "options": [{"text": "6:1", "added": false}, {"text": "3:1", "added": false}, {"text": "2:1", "added": false}, {"text": "4:1", "added": false}], "options_source": "real", "image_only": false, "topic": "Discount", "sub": "successive-discounts", "key_answer": "a"}, {"n": 4, "text": "A laptop, originally priced at ₹40,000, is sold after two successive discounts of 15% and 10%. Find the final selling price.", "options": [{"text": "₹30,600", "added": false}, {"text": "₹31,200", "added": false}, {"text": "₹34,000", "added": false}, {"text": "₹30,000", "added": false}], "options_source": "real", "image_only": false, "topic": "Coordinate Geometry", "sub": "slope-and-line", "key_answer": "a"}, {"n": 5, "text": "Find the equation of the line passing through the point