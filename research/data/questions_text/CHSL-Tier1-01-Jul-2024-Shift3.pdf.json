{"paper": "CHSL-Tier1-01-Jul-2024-Shift3.pdf", "status": "ok", "mode": "sequential", "splitter": "qdot", "section_slice": true, "extracted_count": 25, "tagged_count": 25, "questions": [{"n": 1, "text": "A man can row 18 km/h in still water. It takes him two times as long to row up as to row down the river. Find the rate of the stream.", "options": [{"text": "12 km/h", "added": false}, {"text": "6 km/h", "added": false}, {"text": "24 km/h", "added": false}, {"text": "9 km/h", "added": false}], "options_source": "real", "image_only": false, "topic": "Boats-Streams", "sub": "upstream-downstream", "key_answer": null}, {"n": 2, "text": "CD is a tangent to a circle of circumference of 88 cm with its centre at O. OC cuts the circle at P while OD cuts circle at V such that ∠ COD = 90°. Length of PC is 6 cm. What is half of CD (in cm) if OD exceeds OC by 1 cm?", "options": [{"text": "15.5", "added": false}, {"text": "14.5", "added": false}, {"text": "31", "added": false}, {"text": "16.5", "added": false}], "options_source": "real", "image_only": false, "topic": "Circles-Polygons", "sub": "tangents-and-chords", "key_answer": null}, {"n": 3, "text": "If 1234567y is divisible by 11, then what is the value of y?", "options": [{"text": "3", "added": false}, {"text": "1", "added": false}, {"text": "4", "added": false}, {"text": "2", "added": false}], "options_source": "real", "image_only": false, "topic": "Number System", "sub": "divisibility-rules", "key_answer": null}, {"n": 4, "text": "", "options": [], "options_source": "missing", "image_only": true, "topic": "Simplification", "sub": "other", "key_answer": null}, {"n": 5, "text": "If the selling price of 100 pens is equal to the cost price of 140 pens, find the profit percentage.", "options": [{"text": "30%", "added": false}, {"text": "45%", "added": false}, {"text": "40%", "added": false}, {"text": "36%", "added": false}], "options_source": "real", "image_only": false, "topic": "Profit-Loss", "sub": "basic-cp-sp", "key_answer