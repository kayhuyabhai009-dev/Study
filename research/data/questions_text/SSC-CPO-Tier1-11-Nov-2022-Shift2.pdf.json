{"paper": "SSC-CPO-Tier1-11-Nov-2022-Shift2.pdf", "status": "ok", "mode": "sequential", "splitter": "qdot", "section_slice": true, "extracted_count": 50, "tagged_count": 50, "questions": [{"n": 1, "text": "", "options": [{"text": "42", "added": false}, {"text": "45", "added": false}, {"text": "40", "added": false}, {"text": "41", "added": false}], "options_source": "real", "image_only": true, "topic": "Data Interpretation", "sub": "table", "key_answer": null}, {"n": 2, "text": "The price of a car is first increased by 35% and after that the price is decreased by 25% due to reduction in sales. What is the net percentage change in final price of the car?", "options": [], "options_source": "missing", "image_only": false, "topic": "Percentage", "sub": "increase-decrease", "key_answer": null}, {"n": 3, "text": "The average age of 10 students and their class teacher is 17 years. If the age of the class teacher is excluded, the average age of the 10 students is reduced by 2 years. What is the age of the class teacher?", "options": [{"text": "38 years", "added": false}, {"text": "36 years", "added": false}, {"text": "37 years", "added": false}, {"text": "35 years", "added": false}], "options_source": "real", "image_only": false, "topic": "Ages", "sub": "average-age", "key_answer": null}, {"n": 4, "text": "A six-digit number is divisible by 198. If the digits are rearranged, even then the number will be divisible by:", "options": [{"text": "3", "added": false}, {"text": "6", "added": false}, {"text": "2", "added": false}, {"text": "66", "added": false}], "options_source": "real", "image_only": false, "topic": "Number System", "sub": "divisibility-rules", "key_answer": null}, {"n": 5, "text": "Which of the following is the lowest ratio?", "options": [{"text": "3 : 22", "added": false}, {"text": "23 : 29", "added": false}, {"text": "17 : 5", "added": false}, {"text": "5 : 19", "added": false}], "options_source": "real", "image_only": false, "topic": "Ratio-Proportion", "sub": 