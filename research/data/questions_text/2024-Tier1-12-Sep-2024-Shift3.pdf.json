text": "4.75", "added": false}, {"text": "4.21", "added": false}], "options_source": "real", "image_only": false, "topic": "Mensuration 2D", "sub": "circle-sector-ring", "key_answer": null}, {"n": 21, "text": "The proportion of Suresh's spending to saving is 3 : 1. His salary rises by 25%. What percentage of his expenditure will increase if his saving grows by 10%?", "options": [{"text": "40%", "added": false}, {"text": "20%", "added": false}, {"text": "10%", "added": false}, {"text": "30%", "added": false}], "options_source": "real", "image_only": false, "topic": "Profit-Loss", "sub": "profit-loss-percent", "key_answer": null}, {"n": 22, "text": "", "options": [{"text": "36.6%", "added": false}, {"text": "26.6%", "added": false}, {"text": "28.4%", "added": false}, {"text": "25.5%", "added": false}], "options_source": "real", "image_only": true, "topic": "Percentage", "sub": "income-expenditure", "key_answer": null}, {"n": 23, "text": "If , then the numerical value of is:", "options": [{"text": "1", "added": false}, {"text": "0", "added": false}, {"text": "13", "added": false}, {"text": "−13", "added": false}], "options_source": "real", "image_only": false, "topic": "Percentage", "sub": "basic-percentage", "key_answer": null}, {"n": 24, "text": "If the sectorial angle with radius 9.6 units is 75°, what is the length of the arc?", "options": [{"text": "2π", "added": false}, {"text": "4π", "added": false}, {"text": "π", "added": false}, {"text": "3π", "added": false}], "options_source": "real", "image_only": false, "topic": "Simplification", "sub": "bodmas", "key_answer": null}]}