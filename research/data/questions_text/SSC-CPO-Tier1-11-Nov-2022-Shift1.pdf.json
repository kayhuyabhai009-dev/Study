{"paper": "SSC-CPO-Tier1-11-Nov-2022-Shift1.pdf", "status": "ok", "mode": "sequential", "splitter": "qdot", "section_slice": true, "extracted_count": 50, "tagged_count": 50, "questions": [{"n": 1, "text": "A cone-shaped storage tank's height and radius are 9 and 7 feet, respectively. Determine how much liquid the tank can contain. (Take π = 3.14)", "options": [{"text": "471 cubic feet", "added": false}, {"text": "450 cubic feet", "added": false}, {"text": "435.32 cubic feet", "added": false}, {"text": "461.58 cubic feet", "added": false}], "options_source": "real", "image_only": false, "topic": "Mensuration 3D", "sub": "cone", "key_answer": null}, {"n": 2, "text": "", "options": [{"text": "10000", "added": false}, {"text": "9000", "added": false}, {"text": "8500", "added": false}, {"text": "9500", "added": false}], "options_source": "real", "image_only": true, "topic": "Data Interpretation", "sub": "pie-chart", "key_answer": null}, {"n": 3, "text": "", "options": [{"text": "2 : 1", "added": false}, {"text": "1 : 1", "added": false}, {"text": "1 : 2", "added": false}, {"text": "3 : 1", "added": false}], "options_source": "real", "image_only": true, "topic": "Data Interpretation", "sub": "table", "key_answer": null}, {"n": 4, "text": "The ratio of the third proportional to 16 & 40 and the mean proportional between 10 & 40 is:", "options": [{"text": "5 : 1", "added": false}, {"text": "1 : 5", "added": false}, {"text": "4 : 1", "added": false}, {"text": "1 : 4", "added": false}], "options_source": "real", "image_only": false, "topic": "Ratio-Proportion", "sub": "proportion", "key_answer": null}, {"n": 5, "text": "If cos A = sin2A, and a sin12A + b sin10A + c sin8A + sin6A = 1, then a + b + c = ?", "options": [{"text": "7", "added": false}, {"text": "8", "added": false}, {"text": "9", "added": false}, {"text": "6", "added": false}], "options_source": "real", "image_only": false, "topic": "Trigonometry", "sub": "ratios-and-tables", "key_answer": null}, {"n": 6, "text": "If a man goes from place A to B at a speed of 12 km/h and return at a speed of 18 km/h, then the average speed for the whole journey is:", "options": [], "options_source": "missing", "image_only": false, "topic": "Time-Speed-Distance", "sub": "average-speed", "key_answer": null}, {"n": 7, "text": "Ravi buys salt at ₹16 per kg and sells it at ₹18 per kg. He also uses the weight of 900 gm instead of 1000 gm. What is Ravi’s actual profit percentage?", "options": [], "options_source": "missing", "image_only": false, "topic": "Profit-Loss", "sub": "profit-loss-percent", "key_answer": null}, {"n": 8, "text": "What is the length of the longest rod that can be placed in a room of dimensions 12 m × 9 m × 8 m?", "options": [{"text": "15 m", "added": false}, {"text": "17 m", "added": false}, {"text": "16 m", "added": false}, {"text": "14 m", "added": false}], "options_source": "real", "image_only": false, "topic": "Simplification", "sub": "bodmas", "key_answer": null}, {"n": 9, "text": "The speeds of A and B are in the ratio 3 : 5. A takes 30 minutes more than B to reach the destination. In how much time does A reach the destination?", "options": [{"text": "1 hour 15 minutes", "added": false}, {"text": "1 hour 10 minutes", "added": false}, {"text": "1 hour", "added": false}, {"text": "1 hour 5 minutes", "added": false}], "options_source": "real", "image_only": false, "topic": "Ratio-Proportion", "sub": "ratio-basics", "key_answer": null}, {"n": 10, "text": "A shopkeeper claims to sell his articles at ₹20 per kg which cost him ₹23 per kg. But while selling, he uses a false weight and gives only 800 gm instead of 1 kg. What is his profit percentage?", "options": [], "options_source": "missing", "image_only": false, "topic": "Profit-Loss", "sub": "dishonest-dealer", "key_answer": null}, {"n": 11, "text": "", "options": [], "options_source": "missing", "image_only": true, "topic": "Data Interpretation", "sub": "bar-graph", "key_answer": null}, {"n": 12, "text": "", "options": [{"text": "135", "added": false}, {"text": "125", "added": false}, {"text": "150", "added": false}, {"text": "155", "added": false}], "options_source": "real", "image_only": true, "topic": "Data Interpretation", "sub": "pie-chart", "key_answer": null}, {"n": 13, "text": "", "options": [{"text": "64", "added": false}, {"text": "68", "added": false}, {"text": "76", "added": false}, {"text": "80", "added": false}], "options_source": "real", "image_only": true, "topic": "Number System", "sub": "divisibility-rules", "key_answer": null}, {"n": 14, "text": "", "options": [{"text": "60 Percent", "added": false}, {"text": "30 Percent", "added": false}, {"text": "50 Percent", "added": false}, {"text": "45 Percent", "added": false}], "options_source": "real", "image_only": true, "topic": "Data Interpretation", "sub": "bar-graph", "key_answer": null}, {"n": 15, "text": "A hall of 10 m length, 5 m width and 6 m height is to be painted (one side only). Determine the total surface area to be painted. (neglect the area of windows and doors)(floor area is NOT to be painted)", "options": [{"text": "300 m2", "added": false}, {"text": "280 m2", "added": false}, {"text": "330 m2", "added": false}, {"text": "230 m2", "added": false}], "options_source": "real", "image_only": false, "topic": "Mensuration 3D", "sub": "frustum-prism-pyramid", "key_answer": null}, {"n": 16, "text": "", "options": [{"text": "cos A", "added": false}, {"text": "sin 2A ⁡", "added": false}, {"text": "cos 2A", "added": false}, {"text": "sin A", "added": false}], "options_source": "real", "image_only": true, "topic": "Trigonometry", "sub": "identities", "key_answer": null}, {"n": 17, "text": "", "options": [], "options_source": "missing", "image_only": true, "topic": "Data Interpretation", "sub": "pie-chart", "key_answer": null}, {"n": 18, "text": "The average height of three kids is 56 cm and their heights are in the proportion of 7 : 8 : 9. Find the heights of all the three.", "options": [{"text": "42 cm, 48 cm, 54 cm", "added": false}, {"text": "56 cm, 64 cm, 72 cm", "added": false}, {"text": "35 cm, 40 cm, 45 cm", "added": false}, {"text": "49 cm, 56 cm, 63 cm", "added": false}], "options_source": "real", "image_only": false, "topic": "Average", "sub": "simple-average", "key_answer": null}, {"n": 19, "text": "P and Q can do a piece of work in 14 days. Q and R together can do it in 21 days. If P is twice as good a workman as R, then in how many days Q alone can do the work?", "options": [{"text": "42 days", "added": false}, {"text": "40 days", "added": false}, {"text": "35 days", "added": false}, {"text": "38 days", "added": false}], "options_source": "real", "image_only": false, "topic": "Time-Work", "sub": "together-apart", "key_answer": null}, {"n": 20, "text": "Rajkumar decides to sell his watch at a discount of 5%. However, his brother purchases it from him and receives an 8% discount. Raj loses Rs.45 in profit as a result of this. What was the watch's marked price?", "options": [{"text": "Rs.1,500", "added": false}, {"text": "Rs.1,410", "added": false}, {"text": "Rs.1,430", "added": false}, {"text": "Rs.1,560", "added": false}], "options_source": "real", "image_only": false, "topic": "Discount", "sub": "single-discount", "key_answer": null}, {"n": 21, "text": "A man spends 65% of his income. His income increases by 20% and his expenditure also increases by 10%. The percentage of increase in his savings is ________.", "options": [{"text": "38.5%", "added": false}, {"text": "35.8%", "added": false}, {"text": "10%", "added": false}, {"text": "20%", "added": false}], "options_source": "real", "image_only": false, "topic": "Percentage", "sub": "income-expenditure", "key_answer": null}, {"n": 22, "text": "", "options": [{"text": "51.25", "added": false}, {"text": "16.27", "added": false}, {"text": "36.27", "added": false}, {"text": "46.25", "added": false}], "options_source": "real", "image_only": true, "topic": "Mensuration 2D", "sub": "circle-sector-ring", "key_answer": null}, {"n": 23, "text": "If a + b = 10 and ab = 9, then the value of a – b is:", "options": [{"text": "7", "added": false}, {"text": "5", "added": false}, {"text": "8", "added": false}, {"text": "6", "added": false}], "options_source": "real", "image_only": false, "topic": "Simplification", "sub": "bodmas", "key_answer": null}, {"n": 24, "text": "Due to fall in manpower, the production in a company decreases by 35%. By what percentage should the working hours be increased to restore the original production?", "options": [{"text": "58.35%", "added": false}, {"text": "55.83%", "added": false}, {"text": "53.85%", "added": false}, {"text": "55.38%", "added": false}], "options_source": "real", "image_only": false, "topic": "Percentage", "sub": "increase-decrease", "key_answer": null}, {"n": 25, "text": "", "options": [], "options_source": "missing", "image_only": true, "topic": "Algebra", "sub": "linear-equations", "key_answer": null}, {"n": 26, "text": "Two trains with a speed of 80 km/h and 120 km/h, respectively, are 500 km apart and face each other. Find the distance between them 10 minutes before crossing.", "options": [{"text": "72.33 km", "added": false}, {"text": "33.33 km", "added": false}, {"text": "63.33 km", "added": false}, {"text": "52.74 km", "added": false}], "options_source": "real", "image_only": false, "topic": "Trains", "sub": "two-trains", "key_answer": null}, {"n": 27, "text": "", "options": [{"text": "0", "added": false}, {"text": "-1", "added": false}, {"text": "2", "added": false}, {"text": "1", "added": false}], "options_source": "real", "image_only": true, "topic": "Trigonometry", "sub": "complementary-angles", "key_answer": null}, {"n": 28, "text": "In a race of 1200 m, Ram can beat Shyam by 200 m or by 20 sec. What must be the speed of Ram?", "options": [{"text": "14 m/sec", "added": false}, {"text": "12 m/sec", "added": false}, {"text": "10 m/sec", "added": false}, {"text": "16 m/sec", "added": false}], "options_source": "real", "image_only": false, "topic": "Time-Speed-Distance", "sub": "basic-tsd", "key_answer": null}, {"n": 29, "text": "If the sum of the diagonals of a rhombus is L and the perimeter is 4P, find the area of the rhombus?", "options": [], "options_source": "missing", "image_only": false, "topic": "Mensuration 2D", "sub": "triangle-and-quadrilaterals", "key_answer": null}, {"n": 30, "text": "Find the least value of p so that 246p48 is divisible by 8.", "options": [{"text": "2", "added": false}, {"text": "1", "added": false}, {"text": "4", "added": false}, {"text": "0", "added": false}], "options_source": "real", "image_only": false, "topic": "Simplification", "sub": "bodmas", "key_answer": null}, {"n": 31, "text": "Find the HCF of 69, 96 and 99.", "options": [{"text": "3", "added": false}, {"text": "9", "added": false}, {"text": "1", "added": false}, {"text": "6", "added": false}], "options_source": "real", "image_only": false, "topic": "HCF-LCM", "sub": "hcf-lcm-of-numbers", "key_answer": null}, {"n": 32, "text": "The income of Raju is 25% more than that of Manju. Raju got a 25% rise in his income, and Manju got a 40% rise in his income, the percentage increase in their combined incomes is:", "options": [{"text": "51.72%", "added": false}, {"text": "31.67%", "added": false}, {"text": "22.43%", "added": false}, {"text": "41.26%", "added": false}], "options_source": "real", "image_only": false, "topic": "Percentage", "sub": "income-expenditure", "key_answer": null}, {"n": 33, "text": "", "options": [{"text": "411 : 422", "added": false}, {"text": "473 : 411", "added": false}, {"text": "418 : 422", "added": false}, {"text": "322 : 311", "added": false}], "options_source": "real", "image_only": true, "topic": "Data Interpretation", "sub": "table", "key_answer": null}, {"n": 34, "text": "Due to pandemic, the population of a city reduces at the rate of 2% per annum. What will be its total population after 2 years if the present population of the city is 45,000?", "options": [{"text": "40538", "added": false}, {"text": "44521", "added": false}, {"text": "41568", "added": false}, {"text": "43218", "added": false}], "options_source": "real", "image_only": false, "topic": "Percentage", "sub": "population-and-depreciation", "key_answer": null}, {"n": 35, "text": "", "options": [{"text": "0", "added": false}, {"text": "−1", "added": false}, {"text": "1", "added": false}, {"text": "2", "added": false}], "options_source": "real", "image_only": true, "topic": "Algebra", "sub": "expression-values", "key_answer": null}, {"n": 36, "text": "", "options": [{"text": "75°", "added": false}, {"text": "55°", "added": false}, {"text": "60°", "added": false}, {"text": "70°", "added": false}], "options_source": "real", "image_only": true, "topic": "Geometry", "sub": "triangles", "key_answer": null}, {"n": 37, "text": "A cylindrical tank of capacity 64π litres has equal height and radius. What would be the radius of the cylinder? (1 litre = 1000 cm3)", "options": [{"text": "5 cm", "added": false}, {"text": "40 cm", "added": false}, {"text": "50 cm", "added": false}, {"text": "4 cm", "added": false}], "options_source": "real", "image_only": false, "topic": "Mensuration 3D", "sub": "cylinder", "key_answer": null}, {"n": 38, "text": "A supermarket offers the following discount schemes for buyers. I. Two successive discounts of 25% and 15% II. Successive discount of 35% and 5% III. A discount of 38% Which offer is better for the customer?", "options": [{"text": "Either I or III", "added": false}, {"text": "Only I", "added": false}, {"text": "Only II", "added": false}, {"text": "Only III", "added": false}], "options_source": "real", "image_only": false, "topic": "Discount", "sub": "successive-discounts", "key_answer": null}, {"n": 39, "text": "", "options": [{"text": "29.37%", "added": false}, {"text": "29.89%", "added": false}, {"text": "29.74%", "added": false}, {"text": "29.01%", "added": false}], "options_source": "real", "image_only": true, "topic": "Data Interpretation", "sub": "table", "key_answer": null}, {"n": 40, "text": "Find the LCM of 28 and 92.", "options": [{"text": "464", "added": false}, {"text": "644", "added": false}, {"text": "161", "added": false}, {"text": "322", "added": false}], "options_source": "real", "image_only": false, "topic": "HCF-LCM", "sub": "hcf-lcm-of-numbers", "key_answer": null}, {"n": 41, "text": "Two circles touch each other externally. The radius of the first circle with centre A is 18cm. The radius of the second circle with centre B is 8cm.Find the length of their common tangent CD.", "options": [{"text": "23 cm", "added": false}, {"text": "26 cm", "added": false}, {"text": "24 cm", "added": false}, {"text": "25 cm", "added": false}], "options_source": "real", "image_only": false, "topic": "Circles-Polygons", "sub": "tangents-and-chords", "key_answer": null}, {"n": 42, "text": "", "options": [{"text": "105000", "added": false}, {"text": "176615", "added": false}, {"text": "175616", "added": false}, {"text": "175615", "added": false}], "options_source": "real", "image_only": true, "topic": "Algebra", "sub": "expression-values", "key_answer": null}, {"n": 43, "text": "A group of men committed to completing a task in 20 days. The work was completed in 40 days because 5 workers did not come for work. Determine the number of men who originally agreed to do the work.", "options": [{"text": "15", "added": false}, {"text": "10", "added": false}, {"text": "12", "added": false}, {"text": "18", "added": false}], "options_source": "real", "image_only": false, "topic": "Time-Work", "sub": "together-apart", "key_answer": null}, {"n": 44, "text": "", "options": [{"text": "345", "added": false}, {"text": "510", "added": false}, {"text": "150", "added": false}, {"text": "435", "added": false}], "options_source": "real", "image_only": true, "topic": "Data Interpretation", "sub": "bar-graph", "key_answer": null}, {"n": 45, "text": "Ramu had to select a list of numbers between 1 and 1000 (including both), which are divisible by both 2 and 7. How many such numbers are there?", "options": [{"text": "142", "added": false}, {"text": "71", "added": false}, {"text": "97", "added": false}, {"text": "642", "added": false}], "options_source": "real", "image_only": false, "topic": "Number System", "sub": "divisibility-rules", "key_answer": null}, {"n": 46, "text": "", "options": [], "options_source": "missing", "image_only": true, "topic": "Simplification", "sub": "bodmas", "key_answer": null}, {"n": 47, "text": "The third proportional of 0.024 and 0.12 is:", "options": [{"text": "0.060", "added": false}, {"text": "6.000", "added": false}, {"text": "0.600", "added": false}, {"text": "0.006", "added": false}], "options_source": "real", "image_only": false, "topic": "Ratio-Proportion", "sub": "proportion", "key_answer": null}, {"n": 48, "text": "If 4 Cos θ + 3 Sin θ = x and 4 Sin θ − 3 Cos θ = y, find the value of x2 + y2.", "options": [{"text": "16", "added": false}, {"text": "9", "added": false}, {"text": "25", "added": false}, {"text": "1", "added": false}], "options_source": "real", "image_only": false, "topic": "Trigonometry", "sub": "ratios-and-tables", "key_answer": null}, {"n": 49, "text": "", "options": [], "options_source": "missing", "image_only": true, "topic": "Simplification", "sub": "bodmas", "key_answer": null}, {"n": 50, "text": "The sum of the odd divisors of 216 is:", "options": [{"text": "16", "added": false}, {"text": "14", "added": false}, {"text": "40", "added": false}, {"text": "600", "added": false}], "options_source": "real", "image_only": false, "topic": "Number System", "sub": "types-of-numbers", "key_answer": null}]}