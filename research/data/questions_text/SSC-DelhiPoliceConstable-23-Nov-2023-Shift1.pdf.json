: null}, {"n": 6, "text": "वह अ कतम त ई तक स उप ग 5 टर 95 टर, 8 टर और 16 टर धि सं भा वि लं बा ज्ञा रें जि का यो मी सें टी मी मी मी 65 टर ई स क प ए सक ? सें टी मी की लं बा को टी ता से मा ने के लि कि या जा ता है", "options": [{"text": "5 टर सें टी मी", "added": false}, {"text": "50 टर मी", "added": false}, {"text": "50 टर सें टी मी", "added": false}, {"text": "5 टर मी", "added": false}], "options_source": "real", "image_only": false, "topic": "Profit-Loss", "sub": "successive-transactions", "key_answer": null}, {"n": 7, "text": "", "options": [], "options_source": "missing", "image_only": true, "topic": "Compound Interest", "sub": "ci-instalments", "key_answer": null}, {"n": 8, "text": "A music player is sold for ₹4,510 cash, or ₹1,200 cash down payment and the balance in three equal easy installments. If 10% is the rate of interest compounded annually, find the amount of instalment.", "options": [{"text": "₹1,331", "added": false}, {"text": "₹1,330", "added": false}, {"text": "₹1,333", "added": false}, {"text": "₹1,332", "added": false}], "options_source": "real", "image_only": false, "topic": "Percentage", "sub": "increase-decrease", "key_answer": null}, {"n": 9, "text": "The population of a town decreased from 3,68,000 in 2017 to 3,27,200 in 2020. What is the percentage decrease (to the nearest integer) in the population of the town?", "options": [], "options_source": "missing", "image_only": false, "topic": "Number System", "sub": "types-of-numbers", "key_answer": null}, {"n": 10, "text": "If a,b,c,d and e are distinct prime numbers and the sum of these five numbers is odd, then a + b + c + d is:", "options": [{"text": "an even prime number", "added": false}, {"text": "an odd prime number", "added": false}, {"text": "an odd number", "added": false}, {"text": "an even number", "added": false}], "options_source": "real", "image_only": false, "topic": "HCF-LCM", "sub": "hcf-lcm-of-numbers", "key_answer": null}, {"n": 11, "text": "Which of the following pairs of numbers are relatively prime to each other?", "options": [{"text": "(51, 119)", "added": false}, {"text": "(98, 567)", "added": false}, {"text": "(27, 51)", "added": false}, {"text": "(103, 113)", "added": false}], "options_source": "real", "image_only": false, "topic": "Time-Speed-Distance", "sub": "early-late", "key_answer": null}, {"n": 12, "text": "If Ram walks at a speed of 8 km/h, he misses a train by 7 minutes. However, if he walks at a speed of 10 km/h, he reaches the station 5 minutes before the departure of the train. Find the distance (in km) between Ram’s house and the station.", "options": [{"text": "9", "added": false}, {"text": "7", "added": false}, {"text": "6", "added": false}, {"text": "8", "added": false}], "options_source": "real", "image_only": false, "topic": "Mensuration 3D", "sub": "cylinder", "key_answer": null}, {"n": 13, "text": "", "options": [{"text": "₹555.8", "added": false}, {"text": "₹356.4", "added": false}, {"text": "₹456.5", "added": false}, {"text": "₹750.4", "added": false}], "options_source": "real", "image_only": true, "topic": "Average", "sub": "replacement-effect", "key_answer": null}, {"n": 14, "text": "A cricketer has an average score of 52 runs in 10 innings. Find the number of runs to be scored by him in the 11th inning to raise the average score to 58.", "options": [{"text": "98", "added": false}, {"text": "107", "added": false}, {"text": "122", "added": false}, {"text": "118", "added": false}], "options_source": "real", "image_only": false, "topic": "Simple Interest", "sub": "si-formula", "key_answer": null}]}