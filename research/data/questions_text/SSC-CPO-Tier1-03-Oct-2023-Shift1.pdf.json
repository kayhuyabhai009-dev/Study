{"paper": "SSC-CPO-Tier1-03-Oct-2023-Shift1.pdf", "status": "ok", "mode": "sequential", "splitter": "qdot", "section_slice": true, "extracted_count": 50, "tagged_count": 50, "questions": [{"n": 1, "text": "The radii of two cylinders are in the ratio of 4 : 5 and their heights are in the ratio of 5 : 2. The ratio of their volume is:", "options": [{"text": "9 : 4", "added": false}, {"text": "2 : 1", "added": false}, {"text": "9 : 7", "added": false}, {"text": "8 : 5", "added": false}], "options_source": "real", "image_only": false, "topic": "Mensuration 3D", "sub": "cylinder", "key_answer": null}, {"n": 2, "text": "A person crosses a 900-metre long street in 6 minutes. The speed of the person, in km/h, is:", "options": [{"text": "10", "added": false}, {"text": "9", "added": false}, {"text": "5", "added": false}, {"text": "8", "added": false}], "options_source": "real", "image_only": false, "topic": "Time-Speed-Distance", "sub": "basic-tsd", "key_answer": null}, {"n": 3, "text": "If 3 goats or 5 sheep can graze a field in 54 days, then in how many days can 6 goats and 8 sheep graze the same field?", "options": [{"text": "15", "added": false}, {"text": "12", "added": false}, {"text": "10", "added": false}, {"text": "8", "added": false}], "options_source": "real", "image_only": false, "topic": "Time-Work", "sub": "together-apart", "key_answer": null}, {"n": 4, "text": "An item with a marked price of ₹3,800 was sold for ₹3,496, after a discount of y% was offered. What was the value of y?", "options": [{"text": "7.5%", "added": false}, {"text": "8.5%", "added": false}, {"text": "8%", "added": false}, {"text": "7%", "added": false}], "options_source": "real", "image_only": false, "topic": "Discount", "sub": "single-discount", "key_answer": null}, {"n": 5, "text": "A dishonest dealer announces selling his articles with 22% loss, but uses 35% lighter weights. What is the percentage of his profit or loss?", "options": [{"text": "20% loss", "added": false}, {"text": "13% profit", "added": false}, {"text": "13% loss", "added": false}, {"text": "20% profit", "added": false}], "options_source": "real", "image_only": false, "topic": "Profit-Loss", "sub": "dishonest-dealer", "key_answer": null}, {"n": 6, "text": "", "options": [{"text": "7000", "added": false}, {"text": "9000", "added": false}, {"text": "6000", "added": false}, {"text": "8000", "added": false}], "options_source": "real", "image_only": true, "topic": "Data Interpretation", "sub": "table", "key_answer": null}, {"n": 7, "text": "If θ is an acute angle and sin θ + cosec θ = 2,then the value of sin5θ + cosec5θ is:", "options": [{"text": "10", "added": false}, {"text": "2", "added": false}, {"text": "4", "added": false}, {"text": "5", "added": false}], "options_source": "real", "image_only": false, "topic": "Trigonometry", "sub": "ratios-and-tables", "key_answer": null}, {"n": 8, "text": "", "options": [], "options_source": "missing", "image_only": true, "topic": "Data Interpretation", "sub": "pie-chart", "key_answer": null}, {"n": 9, "text": "", "options": [{"text": "0.3", "added": false}, {"text": "5", "added": false}, {"text": "3", "added": false}, {"text": "0.03", "added": false}], "options_source": "real", "image_only": true, "topic": "Simplification", "sub": "bodmas", "key_answer": null}, {"n": 10, "text": "", "options": [], "options_source": "missing", "image_only": true, "topic": "Trigonometry", "sub": "ratios-and-tables", "key_answer": null}, {"n": 11, "text": "Find the LCM of 15, 24, 35 and 54.", "options": [{"text": "5670", "added": false}, {"text": "7560", "added": false}, {"text": "7650", "added": false}, {"text": "6570", "added": false}], "options_source": "real", "image_only": false, "topic": "HCF-LCM", "sub": "hcf-lcm-of-numbers", "key_answer": null}, {"n": 12, "text": "", "options": [{"text": "2,01,000", "added": false}, {"text": "2,01,100", "added": false}, {"text": "2,01,300", "added": false}, {"text": "2,01,200", "added": false}], "options_source": "real", "image_only": true, "topic": "Data Interpretation", "sub": "table", "key_answer": null}, {"n": 13, "text": "Let the speed of the boat in still water be 17 km/h and let the speed of the stream be 5 km/h. What is the time taken by the boat to go 110 km downstream?", "options": [{"text": "4.5 hours", "added": false}, {"text": "6 hours", "added": false}, {"text": "5.5 hours", "added": false}, {"text": "5 hours", "added": false}], "options_source": "real", "image_only": false, "topic": "Boats-Streams", "sub": "still-water-and-stream-speed", "key_answer": null}, {"n": 14, "text": "A number is first increased by 10% and then increased by 20%. The number, so obtained, is now decreased by 12%. What is the net increase or decrease per cent in the original number?", "options": [{"text": "16.16% increase", "added": false}, {"text": "14.14% decrease", "added": false}, {"text": "11.11% decrease", "added": false}, {"text": "12.12% increase", "added": false}], "options_source": "real", "image_only": false, "topic": "Percentage", "sub": "increase-decrease", "key_answer": null}, {"n": 15, "text": "Study the given graph carefully and answer the question that follows. In which year was there maximum percentage increase in the export of apples to that of the previous years?", "options": [{"text": "2003", "added": false}, {"text": "2005", "added": false}, {"text": "2006", "added": false}, {"text": "2008", "added": false}], "options_source": "real", "image_only": false, "topic": "Data Interpretation", "sub": "mixed-graphs", "key_answer": null}, {"n": 16, "text": "", "options": [{"text": "2.8%", "added": false}, {"text": "3.2%", "added": false}, {"text": "2.0%", "added": false}, {"text": "2.5%", "added": false}], "options_source": "real", "image_only": true, "topic": "Data Interpretation", "sub": "table", "key_answer": null}, {"n": 17, "text": "The first shirt is sold at twice the selling price of the second shirt. The first shirt is sold at 8% profit and the second shirt is sold at a 3% loss. What is the overall percentage profit on the shirts (Rounded off to two decimal place)?", "options": [], "options_source": "missing", "image_only": false, "topic": "Profit-Loss", "sub": "profit-loss-percent", "key_answer": null}, {"n": 18, "text": "The areas of the two triangles are in the ratio 4 : 3 and their heights are in the ratio 6 : 5. Find the ratio of their bases.", "options": [{"text": "5 : 6", "added": false}, {"text": "10 : 9", "added": false}, {"text": "6 : 5", "added": false}, {"text": "9 : 10", "added": false}], "options_source": "real", "image_only": false, "topic": "Mensuration 2D", "sub": "triangle-and-quadrilaterals", "key_answer": null}, {"n": 19, "text": "The largest number of four digits that is exactly divisible by 17 and 36 is:", "options": [{"text": "7956", "added": false}, {"text": "9180", "added": false}, {"text": "9792", "added": false}, {"text": "8568", "added": false}], "options_source": "real", "image_only": false, "topic": "Number System", "sub": "divisibility-rules", "key_answer": null}, {"n": 20, "text": "", "options": [{"text": "20°", "added": false}, {"text": "15°", "added": false}, {"text": "30°", "added": false}, {"text": "60°", "added": false}], "options_source": "real", "image_only": true, "topic": "Circles-Polygons", "sub": "circle-theorems", "key_answer": null}, {"n": 21, "text": "", "options": [{"text": "1", "added": false}, {"text": "3", "added": false}, {"text": "0", "added": false}, {"text": "2", "added": false}], "options_source": "real", "image_only": true, "topic": "Algebra", "sub": "identities", "key_answer": null}, {"n": 22, "text": "If the height of a cone is 7 cm and the diameter of the circular base is 12 cm, then its volume is (nearest to integer):", "options": [{"text": "254 cm3", "added": false}, {"text": "284 cm3", "added": false}, {"text": "264 cm3", "added": false}, {"text": "274 cm3", "added": false}], "options_source": "real", "image_only": false, "topic": "Mensuration 3D", "sub": "cone", "key_answer": null}, {"n": 23, "text": "A, B and C can do a piece of work in 20 days, 30 days and 60 days respectively. If A works daily and on every third day B and C also work with A, then in how many days, will the work be completed?", "options": [{"text": "21", "added": false}, {"text": "18", "added": false}, {"text": "12", "added": false}, {"text": "15", "added": false}], "options_source": "real", "image_only": false, "topic": "Time-Work", "sub": "together-apart", "key_answer": null}, {"n": 24, "text": "", "options": [{"text": "4∶7", "added": false}, {"text": "3∶7", "added": false}, {"text": "7∶10", "added": false}, {"text": "9∶10", "added": false}], "options_source": "real", "image_only": true, "topic": "Data Interpretation", "sub": "pie-chart", "key_answer": null}, {"n": 25, "text": "The value of 11 × 11 + 11 ÷ 11 - 11 × 11 + 11 + 11 × 11 - 11 - 11 × 11 is:", "options": [{"text": "1", "added": false}, {"text": "11", "added": false}, {"text": "121", "added": false}, {"text": "0", "added": false}], "options_source": "real", "image_only": false, "topic": "Simplification", "sub": "bodmas", "key_answer": null}, {"n": 26, "text": "A man spends 72% of his salary and saves ₹5,740 per month. What is 10% of his annual salary (in ₹)?", "options": [{"text": "₹21600", "added": false}, {"text": "₹24600", "added": false}, {"text": "₹20500", "added": false}, {"text": "₹28400", "added": false}], "options_source": "real", "image_only": false, "topic": "Percentage", "sub": "income-expenditure", "key_answer": null}, {"n": 27, "text": "The population of a city is 3,52,314. It increases annually at the rate of 15% per annum. What was its population 2 years ago?", "options": [{"text": "3,02,400", "added": false}, {"text": "3,06,360", "added": false}, {"text": "2,66,400", "added": false}, {"text": "2,56,400", "added": false}], "options_source": "real", "image_only": false, "topic": "Percentage", "sub": "population-and-depreciation", "key_answer": null}, {"n": 28, "text": "A tourist van travels the distance of 35 km from Dehradun to Mussoorie at an average speed of 36 km/h and returns at 60 km/h. What is the approximate average speed (in km/h) of the tourist van for the entire journey?", "options": [{"text": "48", "added": false}, {"text": "42", "added": false}, {"text": "45", "added": false}, {"text": "50", "added": false}], "options_source": "real", "image_only": false, "topic": "Time-Speed-Distance", "sub": "average-speed", "key_answer": null}, {"n": 29, "text": "The HCF and the LCM of two numbers are 5 and 175, respectively. If the ratio of the two numbers is 5:7, the larger of the two numbers is _______.", "options": [{"text": "35", "added": false}, {"text": "25", "added": false}, {"text": "45", "added": false}, {"text": "75", "added": false}], "options_source": "real", "image_only": false, "topic": "HCF-LCM", "sub": "hcf-lcm-of-numbers", "key_answer": null}, {"n": 30, "text": "The product of two numbers is 726 and their HCF is 11, then their LCM is:", "options": [{"text": "58", "added": false}, {"text": "68", "added": false}, {"text": "66", "added": false}, {"text": "76", "added": false}], "options_source": "real", "image_only": false, "topic": "HCF-LCM", "sub": "hcf-lcm-of-numbers", "key_answer": null}, {"n": 31, "text": "If a truck moves at a constant speed of 30 km/h for 1 kilometre and 45 km/h for the next 1 kilometre. What is the average speed of the truck?", "options": [{"text": "32 km/h", "added": false}, {"text": "36 km/h", "added": false}, {"text": "38 km/h", "added": false}, {"text": "34 km/h", "added": false}], "options_source": "real", "image_only": false, "topic": "Time-Speed-Distance", "sub": "average-speed", "key_answer": null}, {"n": 32, "text": "P, Q and R, when working individually, can complete a job in, respectively, 36 days, 48 days and 144 days. P, Q and R start working together. P leaves the job 12 days before completion and Q leaves the job 8 days before completion. R works from the beginning till the end of the job. Determine the total number of days taken to complete the job.", "options": [{"text": "24", "added": false}, {"text": "27", "added": false}, {"text": "30", "added": false}, {"text": "25", "added": false}], "options_source": "real", "image_only": false, "topic": "Time-Work", "sub": "together-apart", "key_answer": null}, {"n": 33, "text": "If a + b = 10 and ab = 6, then the value of a3 + b3 is:", "options": [{"text": "800", "added": false}, {"text": "820", "added": false}, {"text": "860", "added": false}, {"text": "840", "added": false}], "options_source": "real", "image_only": false, "topic": "Simplification", "sub": "bodmas", "key_answer": null}, {"n": 34, "text": "", "options": [], "options_source": "missing", "image_only": true, "topic": "Trigonometry", "sub": "identities", "key_answer": null}, {"n": 35, "text": "The sides of a triangle are in the ratio 5 : 12 : 13 and its perimeter is 90 cm. Find its area (in cm2).", "options": [{"text": "150", "added": false}, {"text": "270", "added": false}, {"text": "30", "added": false}, {"text": "60", "added": false}], "options_source": "real", "image_only": false, "topic": "Mensuration 2D", "sub": "triangle-and-quadrilaterals", "key_answer": null}, {"n": 36, "text": "The given pie-chart shows the distribution of the marks scored by Ram in five different subjects (in percentage). What is the ratio of the central angle of Maths to the central angle of Science?", "options": [{"text": "5 : 2", "added": false}, {"text": "2 : 3", "added": false}, {"text": "4 : 3", "added": false}, {"text": "3 : 5", "added": false}], "options_source": "real", "image_only": false, "topic": "Data Interpretation", "sub": "pie-chart", "key_answer": null}, {"n": 37, "text": "", "options": [{"text": "1.70", "added": false}, {"text": "1.25", "added": false}, {"text": "1.85", "added": false}, {"text": "1.41", "added": false}], "options_source": "real", "image_only": true, "topic": "Data Interpretation", "sub": "table", "key_answer": null}, {"n": 38, "text": "Two circles of radius 13 cm and 15 cm intersect each other at points A and B. If the length of the common chord is 12 cm, then what is the distance between their centres?", "options": [], "options_source": "missing", "image_only": false, "topic": "Circles-Polygons", "sub": "circle-theorems", "key_answer": null}, {"n": 39, "text": "", "options": [{"text": "25%", "added": false}, {"text": "28%", "added": false}, {"text": "30%", "added": false}, {"text": "32%", "added": false}], "options_source": "real", "image_only": true, "topic": "Data Interpretation", "sub": "bar-graph", "key_answer": null}, {"n": 40, "text": "Two numbers are in the ratio 5:3 and the difference between these two numbers is 34. Find the smaller of the two numbers.", "options": [{"text": "51", "added": false}, {"text": "85", "added": false}, {"text": "68", "added": false}, {"text": "34", "added": false}], "options_source": "real", "image_only": false, "topic": "Ratio-Proportion", "sub": "ratio-basics", "key_answer": null}, {"n": 41, "text": "", "options": [{"text": "4580", "added": false}, {"text": "4610", "added": false}, {"text": "4640", "added": false}, {"text": "4620", "added": false}], "options_source": "real", "image_only": true, "topic": "Mensuration 3D", "sub": "conversion-and-melting", "key_answer": null}, {"n": 42, "text": "A man runs for 40 km. The time taken by him in the first 10 km is twice the time taken by him in the second 10 km. The time taken in the third 10 km is half of the time taken in the fourth 10 km, and the time taken in the fourth 10 km is equal to the time taken in the first 10 km. If his speed in the first 10 km is 40 km/h, then what is the average speed for 40 km?", "options": [], "options_source": "missing", "image_only": false, "topic": "Time-Speed-Distance", "sub": "average-speed", "key_answer": null}, {"n": 43, "text": "Find the value of (tan2 θ + tan4 θ).", "options": [], "options_source": "missing", "image_only": false, "topic": "Trigonometry", "sub": "ratios-and-tables", "key_answer": null}, {"n": 44, "text": "If the hypotenuse of a right-angled triangle is 29 cm and the sum of the other two sides is 41 cm, then the difference between the other two sides is:", "options": [{"text": "5 cm", "added": false}, {"text": "1 cm", "added": false}, {"text": "2 cm", "added": false}, {"text": "10 cm", "added": false}], "options_source": "real", "image_only": false, "topic": "Geometry", "sub": "triangles", "key_answer": null}, {"n": 45, "text": "Two numbers are in the ratio 3 : 4. The product of their HCF and LCM is 2700. The sum of the numbers is:", "options": [{"text": "60", "added": false}, {"text": "105", "added": false}, {"text": "15", "added": false}, {"text": "45", "added": false}], "options_source": "real", "image_only": false, "topic": "HCF-LCM", "sub": "hcf-lcm-of-numbers", "key_answer": null}, {"n": 46, "text": "Rajesh invested ₹10,000 by dividing it into two different investment schemes, A and B, at simple interest rates of 8% and 10%, respectively. If the total interest earned in 2 years is ₹1,680, the amount invested in scheme A is:", "options": [{"text": "₹8,000", "added": false}, {"text": "₹2,000", "added": false}, {"text": "₹6,000", "added": false}, {"text": "₹4,000", "added": false}], "options_source": "real", "image_only": false, "topic": "Simple Interest", "sub": "si-formula", "key_answer": null}, {"n": 47, "text": "If 42, 36 and 35 are the first three terms of a proportion, then the fourth term is:", "options": [{"text": "27", "added": false}, {"text": "28", "added": false}, {"text": "30", "added": false}, {"text": "32", "added": false}], "options_source": "real", "image_only": false, "topic": "Ratio-Proportion", "sub": "ratio-basics", "key_answer": null}, {"n": 48, "text": "If the price item is increased by 70% and then allows a scheme discount of 5% and 20% on this marked price. If price is paid in cash and additional discount of 20% is allowed then what is his gain percentage?", "options": [], "options_source": "missing", "image_only": false, "topic": "Discount", "sub": "single-discount", "key_answer": null}, {"n": 49, "text": "Jonathan had borrowed a sum of money 3 years ago at 10% interest per annum compounded annually for a 5-year period, with the amount to be paid at the end of the period being ₹1,61,051. However, there is no pre-payment penalty and Jonathan has received some bonus payment now, with which he has decided to clear his debt. How much does Jonathan have to pay now to clear his debt?", "options": [{"text": "₹1,33,000", "added": false}, {"text": "₹1,32,900", "added": false}, {"text": "₹1,33,100", "added": false}, {"text": "₹1,33,200", "added": false}], "options_source": "real", "image_only": false, "topic": "Compound Interest", "sub": "ci-formula", "key_answer": null}, {"n": 50, "text": "What is the area of a triangle whose sides are of lengths 12 cm, 13 cm and 5 cm?", "options": [{"text": "30 cm2", "added": false}, {"text": "15 cm2", "added": false}, {"text": "40 cm2", "added": false}, {"text": "70 cm2", "added": false}], "options_source": "real", "image_only": false, "topic": "Mensuration 2D", "sub": "triangle-and-quadrilaterals", "key_answer": null}]}