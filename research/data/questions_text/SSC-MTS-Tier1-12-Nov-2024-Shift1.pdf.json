{"paper": "SSC-MTS-Tier1-12-Nov-2024-Shift1.pdf", "status": "ok", "mode": "sequential", "splitter": "qdot", "section_slice": true, "extracted_count": 20, "tagged_count": 20, "questions": [{"n": 1, "text": "If 40 : 35 :: 35 : x, find the value of x.", "options": [], "options_source": "missing", "image_only": false, "topic": "Simplification", "sub": "bodmas", "key_answer": null}, {"n": 2, "text": "A man buys 15 identical articles for a total of ₹15. If he sells each of them for ₹1.32, then his profit percentage is:", "options": [{"text": "8%", "added": false}, {"text": "50%", "added": false}, {"text": "23%", "added": false}, {"text": "32%", "added": false}], "options_source": "real", "image_only": false, "topic": "Profit-Loss", "sub": "articles-and-batches", "key_answer": null}, {"n": 3, "text": "A vehicle moves at 65 km/h for 4 hours before slowing down to 52 km/h for the next 2.5 hours. Calculate the average speed.", "options": [{"text": "61.25 km/h", "added": false}, {"text": "55 km/h", "added": false}, {"text": "60 km/h", "added": false}, {"text": "58.5 km/h", "added": false}], "options_source": "real", "image_only": false, "topic": "Time-Speed-Distance", "sub": "average-speed", "key_answer": null}, {"n": 4, "text": "Study the given graph and answer the question that follows. The graph shows the data of the number of accidents by three types of vehicles: X, Y and Z in four cities: P, Q, R and S. The maximum number of accidents in all cities are due to vehicles of type:", "options": [{"text": "Y", "added": false}, {"text": "X", "added": false}, {"text": "Z", "added": false}, {"text": "X and Z both", "added": false}], "options_source": "real", "image_only": false, "topic": "Data Interpretation", "sub": "mixed-graphs", "key_answer": null}, {"n": 5, "text": "", "options": [{"text": "72.75", "added": false}, {"text": "74.75", "added": false}, {"text": "74.25", "added": false}, {"text": "72.25", "added": false}], "options_source": "real", "image_only": true, "topic": "Mensuration 2D", "sub": "triangle-and-quadrilaterals", "key_answer": null}, {"n": 6, "text": "When a number is first increased by 18% and then decreased by 18%, the change in the number is ____________.", "options": [{"text": "3.24 % decrease", "added": false}, {"text": "0%", "added": false}, {"text": "3.24% increase", "added": false}, {"text": "32.4% increase", "added": false}], "options_source": "real", "image_only": false, "topic": "Percentage", "sub": "increase-decrease", "key_answer": null}, {"n": 7, "text": "I walk at a speed of 10 km/h and reach the destination in 2 hours. If I increase my speed by 5 km/h, how early would I reach my destination?", "options": [{"text": "50 min", "added": false}, {"text": "30 min", "added": false}, {"text": "20 min", "added": false}, {"text": "40 min", "added": false}], "options_source": "real", "image_only": false, "topic": "Time-Speed-Distance", "sub": "early-late", "key_answer": null}, {"n": 8, "text": "In an office having 160 staff members, 40% are females and the remaining are males. The average weight of females is 58 kg and that of males is 63 kg. Find the average weight of all staff members.", "options": [{"text": "58 kg", "added": false}, {"text": "68 kg", "added": false}, {"text": "79 kg", "added": false}, {"text": "61 kg", "added": false}], "options_source": "real", "image_only": false, "topic": "Average", "sub": "simple-average", "key_answer": null}, {"n": 9, "text": "What sum (in ₹) will earn a simple interest of ₹240 in 4 years at 20% per year rate of interest?", "options": [{"text": "450", "added": false}, {"text": "600", "added": false}, {"text": "150", "added": false}, {"text": "300", "added": false}], "options_source": "real", "image_only": false, "topic": "Simple Interest", "sub": "rate-time-principal", "key_answer": null}, {"n": 10, "text": "", "options": [], "options_source": "missing", "image_only": true, "topic": "HCF-LCM", "sub": "hcf-lcm-of-numbers", "key_answer": null}, {"n": 11, "text": "The average age of a man and his son is 48 years. The ratio of their ages is 5 : 3. What is the son's age?", "options": [{"text": "35 years", "added": false}, {"text": "36 years", "added": false}, {"text": "38 years", "added": false}, {"text": "34 years", "added": false}], "options_source": "real", "image_only": false, "topic": "Ages", "sub": "ratio-of-ages", "key_answer": null}, {"n": 12, "text": "Find the simple interest (in ₹) on ₹2500 as a sum borrowed at 4% per year rate of interest for 6 years.", "options": [{"text": "540", "added": false}, {"text": "600", "added": false}, {"text": "640", "added": false}, {"text": "560", "added": false}], "options_source": "real", "image_only": false, "topic": "Simple Interest", "sub": "rate-time-principal", "key_answer": null}, {"n": 13, "text": "A printer with a marked price of ₹9,000 is offered on successive discounts of 30%, 20%, and 15%. Identify the printer's selling price.", "options": [{"text": "₹4,264", "added": false}, {"text": "₹4,250", "added": false}, {"text": "​₹4,284", "added": false}, {"text": "​₹4,274", "added": false}], "options_source": "real", "image_only": false, "topic": "Discount", "sub": "successive-discounts", "key_answer": null}, {"n": 14, "text": "A person lent a sum of ₹30,000 on simple interest for 12 years, with an interest rate of 8% per annum for the first 4 years, 10% per annum for the next 3 years, and 15% per annum for last 5 years. How much interest (in ₹) will he earn at the end of 12 years?", "options": [{"text": "38000", "added": false}, {"text": "41100", "added": false}, {"text": "40200", "added": false}, {"text": "40800", "added": false}], "options_source": "real", "image_only": false, "topic": "Simple Interest", "sub": "si-formula", "key_answer": null}, {"n": 15, "text": "The average of seven consecutive natural numbers is 56. The greatest number among them is:", "options": [{"text": "58", "added": false}, {"text": "59", "added": false}, {"text": "61", "added": false}, {"text": "60", "added": false}], "options_source": "real", "image_only": false, "topic": "Average", "sub": "series-average", "key_answer": null}, {"n": 16, "text": "A man sold his bicycle for ₹810 losing two-fifth of its cost price. What is the loss percentage?", "options": [], "options_source": "missing", "image_only": false, "topic": "Profit-Loss", "sub": "profit-loss-percent", "key_answer": null}, {"n": 17, "text": "The average score of 12 girls in a test was 16.5 and that of 18 boys in the same test was 16. The average score of girls and boys taken together in the same test was:", "options": [{"text": "16.2", "added": false}, {"text": "16.4", "added": false}, {"text": "16.7", "added": false}, {"text": "16.1", "added": false}], "options_source": "real", "image_only": false, "topic": "Average", "sub": "simple-average", "key_answer": null}, {"n": 18, "text": "What is the radius of the largest right circular cone that can be cut out from a cube of edge 8.4 cm ?", "options": [{"text": "4.1 cm", "added": false}, {"text": "4.2 cm", "added": false}, {"text": "2.2 cm", "added": false}, {"text": "2.1 cm", "added": false}], "options_source": "real", "image_only": false, "topic": "Mensuration 3D", "sub": "cube-cuboid", "key_answer": null}, {"n": 19, "text": "", "options": [{"text": "7500", "added": false}, {"text": "6800", "added": false}, {"text": "8400", "added": false}, {"text": "6300", "added": false}], "options_source": "real", "image_only": true, "topic": "Average", "sub": "simple-average", "key_answer": null}, {"n": 20, "text": "If the perimeter of an equilateral triangle is 24 cm,then the length of each median is:", "options": [], "options_source": "missing", "image_only": false, "topic": "Mensuration 2D", "sub": "triangle-and-quadrilaterals", "key_answer": null}]}