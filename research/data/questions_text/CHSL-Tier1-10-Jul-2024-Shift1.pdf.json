{"paper": "CHSL-Tier1-10-Jul-2024-Shift1.pdf", "status": "ok", "mode": "sequential", "splitter": "qdot", "section_slice": true, "extracted_count": 25, "tagged_count": 25, "questions": [{"n": 1, "text": "", "options": [], "options_source": "missing", "image_only": true, "topic": "Simplification", "sub": "other", "key_answer": null}, {"n": 2, "text": "The radii of the two circles are 7 cm and 4 cm. If the distance between their centres is 25 cm, then the length of the transverse common tangent is equal to:", "options": [], "options_source": "missing", "image_only": false, "topic": "Circles-Polygons", "sub": "tangents-and-chords", "key_answer": null}, {"n": 3, "text": "If the radius of a circle is 48 cm and the length of the arc is 15 cm, then the area of the sector corresponding to that arc is:", "options": [{"text": "360 m2", "added": false}, {"text": "360 cm2", "added": false}, {"text": "720 cm2", "added": false}, {"text": "7200 m2", "added": false}], "options_source": "real", "image_only": false, "topic": "Mensuration 2D", "sub": "circle-sector-ring", "key_answer": null}, {"n": 4, "text": "", "options": [{"text": "₹32 crores", "added": false}, {"text": "₹30 crores", "added": false}, {"text": "₹35 crores", "added": false}, {"text": "₹40 crores", "added": false}], "options_source": "real", "image_only": true, "topic": "Simplification", "sub": "other", "key_answer": null}, {"n": 5, "text": "", "options": [], "options_source": "missing", "image_only": true, "topic": "Simplification", "sub": "other", "key_answer": null}, {"n": 6, "text": "Raju and Ramu have more land than Sonu by 15% and 25%, respectively. What is the ratio of land owned by Raju and Ramu?", "options": [], "options_source": "missing", "image_only": false, "topic": "Percentage", "sub": "increase-decrease", "key_answer": null}, {"n": 7, "text": "A mirror is placed on the ground facing upwards. A man sees the top of a tower in the mirror which is at a distance of 105 m from the mirror. The man is 0.5 m away from the mirror, and his height is 1.5 m. Find the height of the tower (in metres).", "options": [{"text": "315", "added": false}, {"text": "115", "added": false}, {"text": "210", "added": false}, {"text": "280", "added": false}], "options_source": "real", "image_only": false, "topic": "Time-Speed-Distance", "sub": "basic-tsd", "key_answer": null}, {"n": 8, "text": "A cyclist rides 10 km at an average speed of 15 km/hr and then the next 15 km at an average speed of 10 km/hr. The average speed of the entire ride is:", "options": [{"text": "20 km/hr", "added": false}, {"text": "12.5 km/hr", "added": false}, {"text": "10 km/hr", "added": false}, {"text": "11.54 km/hr", "added": false}], "options_source": "real", "image_only": false, "topic": "Time-Speed-Distance", "sub": "average-speed", "key_answer": null}, {"n": 9, "text": "", "options": [{"text": "45.2", "added": false}, {"text": "46.9", "added": false}, {"text": "45.9", "added": false}, {"text": "42.9", "added": false}], "options_source": "real", "image_only": true, "topic": "Simplification", "sub": "other", "key_answer": null}, {"n": 10, "text": "A person reaches his destination 30 minutes late, if his speed is 3 km/h, and reaches 30 minutes before time if his speed is 4 km/h. Find the distance of his destination from his starting point.", "options": [{"text": "13 km", "added": false}, {"text": "12 km", "added": false}, {"text": "14 km", "added": false}, {"text": "11 km", "added": false}], "options_source": "real", "image_only": false, "topic": "Time-Speed-Distance", "sub": "early-late", "key_answer": null}, {"n": 11, "text": "To finish a work, P takes half of the number of days required by Q to finish it. If they together can finish the work in 36 days, then in how many days Q alone can finish the work?", "options": [{"text": "108", "added": false}, {"text": "84", "added": false}, {"text": "60", "added": false}, {"text": "24", "added": false}], "options_source": "real", "image_only": false, "topic": "Time-Work", "sub": "together-apart", "key_answer": null}, {"n": 12, "text": "", "options": [], "options_source": "missing", "image_only": true, "topic": "Simplification", "sub": "other", "key_answer": null}, {"n": 13, "text": "", "options": [], "options_source": "missing", "image_only": true, "topic": "Simplification", "sub": "other", "key_answer": null}, {"n": 14, "text": "In an election between two candidates, A gets 63% of the total valid votes. If the total votes polled were 8,750, what is the number of valid votes that the other candidate B gets, if 20% of the total votes were declared invalid?", "options": [{"text": "2,590", "added": false}, {"text": "3,560", "added": false}, {"text": "4,410", "added": false}, {"text": "6,450", "added": false}], "options_source": "real", "image_only": false, "topic": "Percentage", "sub": "basic-percentage", "key_answer": null}, {"n": 15, "text": "", "options": [], "options_source": "missing", "image_only": true, "topic": "Simplification", "sub": "other", "key_answer": null}, {"n": 16, "text": "The sum of the digits of a two-digit number is 9. If the digits are reversed, then the number is increased by 27. Find the number.", "options": [{"text": "36", "added": false}, {"text": "63", "added": false}, {"text": "54", "added": false}, {"text": "45", "added": false}], "options_source": "real", "image_only": false, "topic": "Number System", "sub": "factors-divisors", "key_answer": null}, {"n": 17, "text": "A rectangle with the largest area is cut out of a circle with radius 5 units. What is the area of the remaining portion?", "options": [{"text": "25(2π-3)", "added": false}, {"text": "25(π-2)", "added": false}, {"text": "25(2π-5)", "added": false}, {"text": "25(π-3)", "added": false}], "options_source": "real", "image_only": false, "topic": "Mensuration 2D", "sub": "circle-sector-ring", "key_answer": null}, {"n": 18, "text": "", "options": [], "options_source": "missing", "image_only": true, "topic": "Simplification", "sub": "other", "key_answer": null}, {"n": 19, "text": "", "options": [{"text": "3 : 1", "added": false}, {"text": "5 : 1", "added": false}, {"text": "4 : 1", "added": false}, {"text": "2 : 1", "added": false}], "options_source": "real", "image_only": true, "topic": "Simplification", "sub": "other", "key_answer": null}, {"n": 20, "text": "Four years ago, Ravi was four times as old as Kavya. Seven years from now, Ravi will be three times as old as Kavya. Find the sum of their present ages.", "options": [{"text": "118 years", "added": false}, {"text": "122 years", "added": false}, {"text": "117 years", "added": false}, {"text": "115 years", "added": false}], "options_source": "real", "image_only": false, "topic": "Simplification", "sub": "other", "key_answer": null}, {"n": 21, "text": "Ram spends 30% of his salary on food, 10% on house rent, 7% on entertainment, and 6% on conveyance. If at the end of a month his savings are ₹1,880, then his monthly salary is:", "options": [{"text": "₹4,500", "added": false}, {"text": "₹4,000", "added": false}, {"text": "₹5,000", "added": false}, {"text": "₹5,500", "added": false}], "options_source": "real", "image_only": false, "topic": "Percentage", "sub": "income-expenditure", "key_answer": null}, {"n": 22, "text": "", "options": [], "options_source": "missing", "image_only": true, "topic": "Simplification", "sub": "other", "key_answer": null}, {"n": 23, "text": "", "options": [{"text": "80 cm", "added": false}, {"text": "10 cm", "added": false}, {"text": "20 cm", "added": false}, {"text": "50 cm", "added": false}], "options_source": "real", "image_only": true, "topic": "Simplification", "sub": "other", "key_answer": null}, {"n": 24, "text": "", "options": [{"text": "4", "added": false}, {"text": "6", "added": false}, {"text": "1", "added": false}, {"text": "2", "added": false}], "options_source": "real", "image_only": true, "topic": "Simplification", "sub": "other", "key_answer": null}, {"n": 25, "text": "R wishes to use a stick of length 6 units as common internal tangent to two circles of radius two units and three units. What can be the maximum distance (in units) between the centres of the circle?", "options": [], "options_source": "missing", "image_only": false, "topic": "Circles-Polygons", "sub": "tangents-and-chords", "key_answer": null}]}