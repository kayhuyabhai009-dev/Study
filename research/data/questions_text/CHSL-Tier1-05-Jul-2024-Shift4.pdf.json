{"paper": "CHSL-Tier1-05-Jul-2024-Shift4.pdf", "status": "ok", "mode": "sequential", "splitter": "qdot", "section_slice": true, "extracted_count": 25, "tagged_count": 25, "questions": [{"n": 1, "text": "", "options": [], "options_source": "missing", "image_only": true, "topic": "Simplification", "sub": "other", "key_answer": null}, {"n": 2, "text": "", "options": [{"text": "25 : 23", "added": false}, {"text": "5 : 3", "added": false}, {"text": "23 : 25", "added": false}, {"text": "3 : 5", "added": false}], "options_source": "real", "image_only": true, "topic": "Simplification", "sub": "other", "key_answer": null}, {"n": 3, "text": "", "options": [{"text": "400 km", "added": false}, {"text": "250 km", "added": false}, {"text": "240km", "added": false}, {"text": "300km", "added": false}], "options_source": "real", "image_only": true, "topic": "Simplification", "sub": "other", "key_answer": null}, {"n": 4, "text": "", "options": [], "options_source": "missing", "image_only": true, "topic": "Simplification", "sub": "other", "key_answer": null}, {"n": 5, "text": "", "options": [{"text": "0", "added": false}, {"text": "-1", "added": false}, {"text": "1", "added": false}, {"text": "2", "added": false}], "options_source": "real", "image_only": true, "topic": "Simplification", "sub": "other", "key_answer": null}, {"n": 6, "text": "Two similar triangles have area 490 sq. cm. and 640 sq. cm. If the length of the one side of the first triangle is 21 cm, then what is the length of the corresponding side of the second triangle?", "options": [{"text": "24 cm", "added": false}, {"text": "21 cm", "added": false}, {"text": "16 cm", "added": false}, {"text": "14 cm", "added": false}], "options_source": "real", "image_only": false, "topic": "Geometry", "sub": "congruence-and-similarity", "key_answer": null}, {"n": 7, "text": "", "options": [{"text": "24", "added": false}, {"text": "13", "added": false}, {"text": "5", "added": false}, {"text": "15", "added": false}], "options_source": "real", "image_only": true, "topic": "Simplification", "sub": "other", "key_answer": null}, {"n": 8, "text": "Find the amount to be paid at the end if ₹4,500 is invested for a period of 4 years at the rate of 8% simple interest per annum.", "options": [{"text": "₹5,490", "added": false}, {"text": "₹6,080", "added": false}, {"text": "₹5,940", "added": false}, {"text": "₹6,300", "added": false}], "options_source": "real", "image_only": false, "topic": "Simple Interest", "sub": "si-formula", "key_answer": null}, {"n": 9, "text": "If the graph of the equation 20x + 21y = 420 cuts the coordinate axes at P and Q, then what is the measure of the length (in units) of PQ?", "options": [{"text": "25", "added": false}, {"text": "29", "added": false}, {"text": "40", "added": false}, {"text": "35", "added": false}], "options_source": "real", "image_only": false, "topic": "Algebra", "sub": "linear-equations", "key_answer": null}, {"n": 10, "text": "Let ABC be a triangle such that ∠ ABC = 70° and ∠ ACB = 50°. Let O be the incentre of the triangle. Find ∠ BOC.", "options": [{"text": "120°", "added": false}, {"text": "100°", "added": false}, {"text": "60°", "added": false}, {"text": "130°", "added": false}], "options_source": "real", "image_only": false, "topic": "Geometry", "sub": "triangles", "key_answer": null}, {"n": 11, "text": "", "options": [{"text": "1", "added": false}, {"text": "4", "added": false}, {"text": "3", "added": false}, {"text": "2", "added": false}], "options_source": "real", "image_only": true, "topic": "Simplification", "sub": "other", "key_answer": null}, {"n": 12, "text": "How many factors of 14,400 are divisible by 18 but not by 36?", "options": [{"text": "5", "added": false}, {"text": "2", "added": false}, {"text": "4", "added": false}, {"text": "3", "added": false}], "options_source": "real", "image_only": false, "topic": "Number System", "sub": "divisibility-rules", "key_answer": null}, {"n": 13, "text": "A person divides his total route of journey into three equal parts and decides to travel the three parts at the speeds of 80 km/h, 60 km/h and 30 km/h, respectively. What is the average speed during the journey?", "options": [{"text": "45 km/h", "added": false}, {"text": "40 km/h", "added": false}, {"text": "49 km/h", "added": false}, {"text": "48 km/h", "added": false}], "options_source": "real", "image_only": false, "topic": "Time-Speed-Distance", "sub": "average-speed", "key_answer": null}, {"n": 14, "text": "Let ABC be a right-angled triangle such that ∠ C = 90°. Let D be a point on AB such that CD is perpendicular to AB. If AC = 5 cm and BC = 12 cm, find the length of CD (in cm).", "options": [], "options_source": "missing", "image_only": false, "topic": "Geometry", "sub": "triangles", "key_answer": null}, {"n": 15, "text": "The diameter of a roller is 35 cm and its length is 100 cm. It takes 200 complete revolutions to level a playground. Find the area of the playground in m2", "options": [{"text": "1,10,000", "added": false}, {"text": "110", "added": false}, {"text": "2,20,00,000", "added": false}, {"text": "220", "added": false}], "options_source": "real", "image_only": false, "topic": "Mensuration 2D", "sub": "paths-and-borders", "key_answer": null}, {"n": 16, "text": "In an election, a voter has choices to vote for one candidate out of three candidates. There is also an option ‘None OfThe Above’ (NOTA) to reject all candidates. The three candidates get votes that are 6 times NOTA. The winner gets votes that are twice the second runner-up’s votes. The first runner-up gets 900 votes more than NOTA and defeats the second runner-up by 150 votes. What is the total number of votes polled?", "options": [{"text": "17715", "added": false}, {"text": "15177", "added": false}, {"text": "11025", "added": false}, {"text": "11577", "added": false}], "options_source": "real", "image_only": false, "topic": "Simplification", "sub": "other", "key_answer": null}, {"n": 17, "text": "The number of subjects in which the students of a class have failed is given in the following table. Find the total number of students who have failed in more than 3 subjects.", "options": [{"text": "11", "added": false}, {"text": "10", "added": false}, {"text": "17", "added": false}, {"text": "12", "added": false}], "options_source": "real", "image_only": false, "topic": "Data Interpretation", "sub": "table", "key_answer": null}, {"n": 18, "text": "", "options": [], "options_source": "missing", "image_only": true, "topic": "Simplification", "sub": "other", "key_answer": null}, {"n": 19, "text": "", "options": [], "options_source": "missing", "image_only": true, "topic": "Simplification", "sub": "other", "key_answer": null}, {"n": 20, "text": "The following pie chart represents the percentage domestic expenditure of Raman over his family. Study the pie chart carefully and answer the question given below. After paying the House Rent and expending over Food and Children’s Education, what is Raman's remaining monthly income (in ₹)?", "options": [{"text": "12,750", "added": false}, {"text": "20,250", "added": false}, {"text": "15,750", "added": false}, {"text": "29,250", "added": false}], "options_source": "real", "image_only": false, "topic": "Data Interpretation", "sub": "pie-chart", "key_answer": null}, {"n": 21, "text": "The price of a motorcycle was $750 last year. The price increased by 20% this year. What is the price of the motorcycle this year?", "options": [{"text": "$750", "added": false}, {"text": "$900", "added": false}, {"text": "$600", "added": false}, {"text": "$790", "added": false}], "options_source": "real", "image_only": false, "topic": "Percentage", "sub": "increase-decrease", "key_answer": null}, {"n": 22, "text": "", "options": [], "options_source": "missing", "image_only": true, "topic": "Simplification", "sub": "other", "key_answer": null}, {"n": 23, "text": "X and Y can do a job in 18 days; Y and Z can do the same in 24 days. If all the three can finish the job in 12 days, in how many days can X and Z can complete the job?", "options": [], "options_source": "missing", "image_only": false, "topic": "Simplification", "sub": "other", "key_answer": null}, {"n": 24, "text": "The whole surface area of a cube is 294 cm2. The volume of the cube is:", "options": [{"text": "243 cm3", "added": false}, {"text": "343 cm3", "added": false}, {"text": "512 cm3", "added": false}, {"text": "216 cm3", "added": false}], "options_source": "real", "image_only": false, "topic": "Mensuration 3D", "sub": "cube-cuboid", "key_answer": null}, {"n": 25, "text": "A person spends 60% of his salary on family expenses, 10% on medical expenses, 5% on charity, and saves the remaining amount. If the amount on savings is ₹4,000, find his monthly salary.", "options": [{"text": "₹16,000", "added": false}, {"text": "₹12,000", "added": false}, {"text": "₹14,000", "added": false}, {"text": "₹15,000", "added": false}], "options_source": "real", "image_only": false, "topic": "Percentage", "sub": "income-expenditure", "key_answer": null}]}