{"paper": "SSC-CPO-Tier1-05-Oct-2023-Shift2.pdf", "status": "ok", "mode": "sequential", "splitter": "qdot", "section_slice": true, "extracted_count": 50, "tagged_count": 50, "questions": [{"n": 1, "text": "", "options": [{"text": "10%", "added": false}, {"text": "150%", "added": false}, {"text": "50%", "added": false}, {"text": "100%", "added": false}], "options_source": "real", "image_only": true, "topic": "Data Interpretation", "sub": "pie-chart", "key_answer": null}, {"n": 2, "text": "A person sold two cars for ₹60,000 each. On one, he gained 20% while on the other he lost 20%. Find the percentage of his gain or loss.", "options": [{"text": "Gain 4%", "added": false}, {"text": "Loss 4%", "added": false}, {"text": "Loss 2%", "added": false}, {"text": "No profit and no loss", "added": false}], "options_source": "real", "image_only": false, "topic": "Profit-Loss", "sub": "profit-loss-percent", "key_answer": null}, {"n": 3, "text": "The LCM of 96, 132 and 438 is:", "options": [{"text": "86084", "added": false}, {"text": "67055", "added": false}, {"text": "85046", "added": false}, {"text": "77088", "added": false}], "options_source": "real", "image_only": false, "topic": "HCF-LCM", "sub": "hcf-lcm-of-numbers", "key_answer": null}, {"n": 4, "text": "Three candidates contested an election and won 1136, 7636 and 11628 votes, respectively. What percentage of the total votes did the winning candidate get?", "options": [{"text": "45", "added": false}, {"text": "49", "added": false}, {"text": "33", "added": false}, {"text": "57", "added": false}], "options_source": "real", "image_only": false, "topic": "Percentage", "sub": "basic-percentage", "key_answer": null}, {"n": 5, "text": "Ram has 12 hens and 5 cows, Shyam has 18 hens and 9 cows, Preetham has 4 hens and 8 cows, and Vinay has 10 hens and 7 cows. Who has a greater ratio of hens to cows?", "options": [{"text": "Preetham", "added": false}, {"text": "Shyam", "added": false}, {"text": "Ram", "added": false}, {"text": "Vinay", "added": false}], "options_source": "real", "image_only": false, "topic": "Ratio-Proportion", "sub": "ratio-basics", "key_answer": null}, {"n": 6, "text": "A sphere and another solid hemisphere have the same surface area. The ratio of their volumes is:", "options": [], "options_source": "missing", "image_only": false, "topic": "Mensuration 3D", "sub": "sphere-hemisphere", "key_answer": null}, {"n": 7, "text": "", "options": [{"text": "2060", "added": false}, {"text": "2540", "added": false}, {"text": "2310", "added": false}, {"text": "3210", "added": false}], "options_source": "real", "image_only": true, "topic": "Mensuration 3D", "sub": "cylinder", "key_answer": null}, {"n": 8, "text": "The total surface area of a cone whose radius is 3 cm and height is 4 cm is:", "options": [], "options_source": "missing", "image_only": false, "topic": "Mensuration 3D", "sub": "cone", "key_answer": null}, {"n": 9, "text": "Julie and Soma start from the same point and walk in opposite directions. Julie walks 4 km/h faster than Soma. After 4 hours they are 40 km apart. How fast did each walk?", "options": [{"text": "Julie – 8 km/h; Soma – 4 km/h", "added": false}, {"text": "Julie – 7 km/h; Soma – 3 km/h", "added": false}, {"text": "Julie – 9 km/h; Soma – 5 km/h", "added": false}, {"text": "Julie – 10 km/h; Soma – 6 km/h", "added": false}], "options_source": "real", "image_only": false, "topic": "Time-Speed-Distance", "sub": "relative-speed", "key_answer": null}, {"n": 10, "text": "Arbind has 650 kg of wheat. A part of which he sells at 9% profit and the rest at 19% profit to get 15% profit on the whole. What is the quantity (in kg) of wheat sold by Arbind at 9% profit?", "options": [{"text": "260", "added": false}, {"text": "195", "added": false}, {"text": "455", "added": false}, {"text": "390", "added": false}], "options_source": "real", "image_only": false, "topic": "Profit-Loss", "sub": "profit-loss-percent", "key_answer": null}, {"n": 11, "text": "What is the LCM of 0.15, 0.18 and 0.45?", "options": [{"text": "0.9", "added": false}, {"text": "0.09", "added": false}, {"text": "0.81", "added": false}, {"text": "0.6", "added": false}], "options_source": "real", "image_only": false, "topic": "HCF-LCM", "sub": "hcf-lcm-of-numbers", "key_answer": null}, {"n": 12, "text": "A train of length 180 m takes 40 seconds to cross a tunnel of length 500 m. What is the speed of the train, in km/h?", "options": [{"text": "71.2", "added": false}, {"text": "61.2", "added": false}, {"text": "80.5", "added": false}, {"text": "52.5", "added": false}], "options_source": "real", "image_only": false, "topic": "Trains", "sub": "train-vs-platform", "key_answer": null}, {"n": 13, "text": "", "options": [{"text": "2", "added": false}, {"text": "4", "added": false}, {"text": "3", "added": false}, {"text": "1", "added": false}], "options_source": "real", "image_only": true, "topic": "Trigonometry", "sub": "complementary-angles", "key_answer": null}, {"n": 14, "text": "Which of the following ratios is the greatest?", "options": [{"text": "2 : 5", "added": false}, {"text": "7 : 10", "added": false}, {"text": "5 : 6", "added": false}, {"text": "1 : 3", "added": false}], "options_source": "real", "image_only": false, "topic": "Ratio-Proportion", "sub": "ratio-basics", "key_answer": null}, {"n": 15, "text": "Find the LCM of 20, 30, 45 and 65.", "options": [{"text": "2000", "added": false}, {"text": "2340", "added": false}, {"text": "2240", "added": false}, {"text": "180", "added": false}], "options_source": "real", "image_only": false, "topic": "HCF-LCM", "sub": "hcf-lcm-of-numbers", "key_answer": null}, {"n": 16, "text": "The greatest possible length that can be used to measure exactly the lengths of 3 m 15 cm, 5 m, and 6 m 85 cm is:", "options": [{"text": "9 cm", "added": false}, {"text": "11 cm", "added": false}, {"text": "7 cm", "added": false}, {"text": "5 cm", "added": false}], "options_source": "real", "image_only": false, "topic": "HCF-LCM", "sub": "application-problems", "key_answer": null}, {"n": 17, "text": "", "options": [{"text": "7", "added": false}, {"text": "9", "added": false}, {"text": "6", "added": false}, {"text": "8", "added": false}], "options_source": "real", "image_only": true, "topic": "Ratio-Proportion", "sub": "ratio-basics", "key_answer": null}, {"n": 18, "text": "The difference between a discount of 30% on ₹5,000 and two successive discounts of 15% and 25% on the same amount is:", "options": [{"text": "₹315.50", "added": false}, {"text": "₹350.50", "added": false}, {"text": "₹312.50", "added": false}, {"text": "₹412.50", "added": false}], "options_source": "real", "image_only": false, "topic": "Discount", "sub": "successive-discounts", "key_answer": null}, {"n": 19, "text": "Two circles with centres P and Q of radii 6 cm and 4 cm, respectively, touch each other internally. If the perpendicular bisector of PQ meets the bigger circle in A and B, then the value of AB is:", "options": [], "options_source": "missing", "image_only": false, "topic": "Mensuration 2D", "sub": "circle-sector-ring", "key_answer": null}, {"n": 20, "text": "The monthly income of an employee was ₹26,500 and his monthly expenditure was ₹22,000. Next year his income increased by 20% and his expenditure increased by 15%. Find the percentage increase in his savings.", "options": [], "options_source": "missing", "image_only": false, "topic": "Percentage", "sub": "income-expenditure", "key_answer": null}, {"n": 21, "text": "Find the value of sin (50 ° + A) - cos (40 ° - A).", "options": [{"text": "2", "added": false}, {"text": "0", "added": false}, {"text": "−1", "added": false}, {"text": "1", "added": false}], "options_source": "real", "image_only": false, "topic": "Trigonometry", "sub": "ratios-and-tables", "key_answer": null}, {"n": 22, "text": "A sum amounts to ₹7,656 in 4 years and to ₹8,120 in 5 years at a certain simple interest rate per cent per annum. The rate of interest is:", "options": [{"text": "4%", "added": false}, {"text": "3%", "added": false}, {"text": "7%", "added": false}, {"text": "8%", "added": false}], "options_source": "real", "image_only": false, "topic": "Simple Interest", "sub": "rate-time-principal", "key_answer": null}, {"n": 23, "text": "", "options": [], "options_source": "missing", "image_only": true, "topic": "Algebra", "sub": "expression-values", "key_answer": null}, {"n": 24, "text": "Vipin can do a piece of work in 2 days; Vaibhav can do the same work in 3 days and Chirag can do the same work in 6 days. If they start working together, how many days will they take to complete the work?", "options": [{"text": "3", "added": false}, {"text": "1", "added": false}, {"text": "5", "added": false}, {"text": "4", "added": false}], "options_source": "real", "image_only": false, "topic": "Time-Work", "sub": "together-apart", "key_answer": null}, {"n": 25, "text": "Two successive discounts of 30% and 20% are equivalent to a single discount of:", "options": [{"text": "44%", "added": false}, {"text": "52%", "added": false}, {"text": "45%", "added": false}, {"text": "50%", "added": false}], "options_source": "real", "image_only": false, "topic": "Discount", "sub": "successive-discounts", "key_answer": null}, {"n": 26, "text": "", "options": [], "options_source": "missing", "image_only": true, "topic": "HCF-LCM", "sub": "other", "key_answer": null}, {"n": 27, "text": "The average of 45 numbers was found to be 39. Later on, it was detected that a number 65 was misread as 56. Find the correct average of the given numbers.", "options": [{"text": "39.2", "added": false}, {"text": "37.2", "added": false}, {"text": "38.2", "added": false}, {"text": "36.2", "added": false}], "options_source": "real", "image_only": false, "topic": "Average", "sub": "simple-average", "key_answer": null}, {"n": 28, "text": "Robert takes twice as much time as Tom and thrice as much time as George to complete a work. If working together, they can complete it in 23 hours, then find the time that Tom will take to complete the work.", "options": [{"text": "46 hours", "added": false}, {"text": "69 hours", "added": false}, {"text": "11 hours", "added": false}, {"text": "39 hours", "added": false}], "options_source": "real", "image_only": false, "topic": "Time-Work", "sub": "together-apart", "key_answer": null}, {"n": 29, "text": "Two metallic balls P and Q are such that the diameter of P is four times the diameter of Q. What is the ratio between the volumes of P and Q?", "options": [], "options_source": "missing", "image_only": false, "topic": "Mensuration 3D", "sub": "frustum-prism-pyramid", "key_answer": null}, {"n": 30, "text": "A runner runs a 750-metre race in 54 seconds. Find the runner’s speed (in km/h).", "options": [{"text": "40", "added": false}, {"text": "30", "added": false}, {"text": "14", "added": false}, {"text": "50", "added": false}], "options_source": "real", "image_only": false, "topic": "Time-Speed-Distance", "sub": "basic-tsd", "key_answer": null}, {"n": 31, "text": "Out of two concentric circles, the radius of the outer circle is 6 cm and the chord PQ of the length 10 cm is a tangent to the inner circle. Find the radius (in cm) of the inner circle.", "options": [], "options_source": "missing", "image_only": false, "topic": "Circles-Polygons", "sub": "tangents-and-chords", "key_answer": null}, {"n": 32, "text": "Simplify the following. 9 × 2 ÷ 3 of 24 - 3 ÷ 2 × (6 - 7) × 2 + 3 ÷ 3 of 5", "options": [], "options_source": "missing", "image_only": false, "topic": "Simplification", "sub": "bodmas", "key_answer": null}, {"n": 33, "text": "What will be the area of a plot of quadrilateral shape, one of whose diagonals is 20 m and lengths of the perpendiculars from the opposite vertices on it are 12 m and 18 m, respectively?", "options": [{"text": "400 m2", "added": false}, {"text": "250 m2", "added": false}, {"text": "200 m2", "added": false}, {"text": "300 m2", "added": false}], "options_source": "real", "image_only": false, "topic": "Mensuration 2D", "sub": "triangle-and-quadrilaterals", "key_answer": null}, {"n": 34, "text": "", "options": [{"text": "68.5%", "added": false}, {"text": "75%", "added": false}, {"text": "65%", "added": false}, {"text": "72.5%", "added": false}], "options_source": "real", "image_only": true, "topic": "Data Interpretation", "sub": "table", "key_answer": null}, {"n": 35, "text": "", "options": [{"text": "16.48%", "added": false}, {"text": "18.25%", "added": false}, {"text": "15.63%", "added": false}, {"text": "17.36%", "added": false}], "options_source": "real", "image_only": true, "topic": "Data Interpretation", "sub": "table", "key_answer": null}, {"n": 36, "text": "", "options": [{"text": "A, 2010", "added": false}, {"text": "B, 2015", "added": false}, {"text": "B, 2010", "added": false}, {"text": "A, 2011", "added": false}], "options_source": "real", "image_only": true, "topic": "Data Interpretation", "sub": "table", "key_answer": null}, {"n": 37, "text": "", "options": [], "options_source": "missing", "image_only": true, "topic": "Trigonometry", "sub": "identities", "key_answer": null}, {"n": 38, "text": "The following table shows the marks obtained out of 100, by 5 students in 5 different subjects. What are the total marks scored by Ayush in all the subjects?", "options": [{"text": "435", "added": false}, {"text": "465", "added": false}, {"text": "445", "added": false}, {"text": "425", "added": false}], "options_source": "real", "image_only": false, "topic": "Data Interpretation", "sub": "table", "key_answer": null}, {"n": 39, "text": "A family earns ₹75,000, out of which 10% is saved. 30% of the expenditure is incurred on education, while ₹30,375 is spent on health and the remaining amount is spent on food. What is the percentage of food expenditure to the total income?", "options": [], "options_source": "missing", "image_only": false, "topic": "Percentage", "sub": "income-expenditure", "key_answer": null}, {"n": 40, "text": "Study the given table and answer the question that follows. The table shows the number of employees in five different organisations A, B, C, D and E in different departments. Which organisation has maximum number of employees?", "options": [{"text": "A", "added": false}, {"text": "B", "added": false}, {"text": "D", "added": false}, {"text": "E", "added": false}], "options_source": "real", "image_only": false, "topic": "Data Interpretation", "sub": "table", "key_answer": null}, {"n": 41, "text": "Find the amount (integral value only) if a sum of ₹6,500 is being borrowed at 10% interest per annum for 2 years if interest is compounded half-yearly.", "options": [{"text": "₹8,250", "added": false}, {"text": "₹7,650", "added": false}, {"text": "₹8,150", "added": false}, {"text": "₹7,900", "added": false}], "options_source": "real", "image_only": false, "topic": "Compound Interest", "sub": "compounding-frequency", "key_answer": null}, {"n": 42, "text": "A can do a certain piece of work in 2.4 times the number of days in which B and C together can do it. If A and B together can do the said piece of work in 27 days and C alone can do it in 75 days, then how many days will B take to do this piece of work alone?", "options": [{"text": "54", "added": false}, {"text": "48", "added": false}, {"text": "45", "added": false}, {"text": "42", "added": false}], "options_source": "real", "image_only": false, "topic": "Time-Work", "sub": "together-apart", "key_answer": null}, {"n": 43, "text": "Two circles touch each other externally at C. AB is a direct common tangent to the two circles, A and B are points of contact and ∠CAB = 55°. Then ∠ ACB is:", "options": [{"text": "35°", "added": false}, {"text": "90°", "added": false}, {"text": "55°", "added": false}, {"text": "45°", "added": false}], "options_source": "real", "image_only": false, "topic": "Circles-Polygons", "sub": "tangents-and-chords", "key_answer": null}, {"n": 44, "text": "", "options": [{"text": "22.22%", "added": false}, {"text": "55.55%", "added": false}, {"text": "33.33%", "added": false}, {"text": "44.44%", "added": false}], "options_source": "real", "image_only": true, "topic": "Data Interpretation", "sub": "table", "key_answer": null}, {"n": 45, "text": "Study the given pie-chart and answer the question that follows. The pie-chart shows the sale of different fruits in a shop in a day. If a total of 1200 kg of fruits were sold in a day, find the difference between sales of grapes and oranges (in kg).", "options": [{"text": "60", "added": false}, {"text": "55", "added": false}, {"text": "65", "added": false}, {"text": "45", "added": false}], "options_source": "real", "image_only": false, "topic": "Data Interpretation", "sub": "pie-chart", "key_answer": null}, {"n": 46, "text": "", "options": [{"text": "9 : 14", "added": false}, {"text": "39 : 34", "added": false}, {"text": "14 : 9", "added": false}, {"text": "34 : 39", "added": false}], "options_source": "real", "image_only": true, "topic": "Data Interpretation", "sub": "table", "key_answer": null}, {"n": 47, "text": "If tanθ + cotθ = 2, θ is an acute angle, then find the value of 2 tan25 θ + 3 cot20 θ + 5 tan30 θ cot15 θ.", "options": [{"text": "8", "added": false}, {"text": "6", "added": false}, {"text": "10", "added": false}, {"text": "12", "added": false}], "options_source": "real", "image_only": false, "topic": "Trigonometry", "sub": "ratios-and-tables", "key_answer": null}, {"n": 48, "text": "In an equilateral ∆PQR, S is point on the side QR such that QR = 3QS. If PQ = 9 cm, then what will be the length (in cm) of PS?", "options": [], "options_source": "missing", "image_only": false, "topic": "Geometry", "sub": "triangles", "key_answer": null}, {"n": 49, "text": "By selling a table for ₹1,596, Aarav loses 24%. At what price (in ₹) should he sell it to gain 24%?", "options": [{"text": "3196", "added": false}, {"text": "3024", "added": false}, {"text": "1979", "added": false}, {"text": "2604", "added": false}], "options_source": "real", "image_only": false, "topic": "Percentage", "sub": "basic-percentage", "key_answer": null}, {"n": 50, "text": "What will be the least number which when doubled will be exactly divisible by 12, 14, 16 and 18?", "options": [{"text": "636", "added": false}, {"text": "428", "added": false}, {"text": "504", "added": false}, {"text": "226", "added": false}], "options_source": "real", "image_only": false, "topic": "Number System", "sub": "divisibility-rules", "key_answer": null}]}