{"paper": "SSC-CPO-Tier1-29-Jun-2024-Shift2.pdf", "status": "ok", "mode": "sequential", "splitter": "qdot", "section_slice": true, "extracted_count": 50, "tagged_count": 50, "questions": [{"n": 1, "text": "", "options": [], "options_source": "missing", "image_only": true, "topic": "Simplification", "sub": "bodmas", "key_answer": null}, {"n": 2, "text": "The population of a town increases annually by 20%. If the present population is 80lakh, then what is the difference between the population three years ago and 2years ago?", "options": [{"text": "925925.93", "added": false}, {"text": "85592.6", "added": false}, {"text": "65592.6", "added": false}, {"text": "75592.6", "added": false}], "options_source": "real", "image_only": false, "topic": "Percentage", "sub": "population-and-depreciation", "key_answer": null}, {"n": 3, "text": "The height of a cylinder is 8 cm, and its area of the base is 20 cm2 . Find its volume?", "options": [{"text": "80 cm3", "added": false}, {"text": "180 cm3", "added": false}, {"text": "160 cm3", "added": false}, {"text": "100 cm3", "added": false}], "options_source": "real", "image_only": false, "topic": "Mensuration 3D", "sub": "cylinder", "key_answer": null}, {"n": 4, "text": "Rajan and Rajat can do a work in 64 days and 48 days, respectively. Starting with Rajat, they work on alternate days. In how many days will the work be completed?", "options": [], "options_source": "missing", "image_only": false, "topic": "Time-Work", "sub": "together-apart", "key_answer": null}, {"n": 5, "text": "The secant CD intersects the circle at E and CF is tangent to the circle at F. If the length of the secant CD is equal to 20 cm and the length of tangent CF is 15 cm, find the length of the chord DE.", "options": [{"text": "8.75 cm", "added": false}, {"text": "11.25 cm", "added": false}, {"text": "9.25 cm", "added": false}, {"text": "3.75 cm", "added": false}], "options_source": "real", "image_only": false, "topic": "Circles-Polygons", "sub": "tangents-and-chords", "key_answer": null}, {"n": 6, "text": "Melting a metal ball of radius 3 units, 27 identical dice and a ball of radius 1 units are made. What is the side of dice?", "options": [{"text": "1.7 units", "added": false}, {"text": "1.5 units", "added": false}, {"text": "1.4 units", "added": false}, {"text": "1.6 units", "added": false}], "options_source": "real", "image_only": false, "topic": "Probability", "sub": "basic-probability", "key_answer": null}, {"n": 7, "text": "Simplify the given expression.", "options": [{"text": "1.2368", "added": false}, {"text": "7.8539", "added": false}, {"text": "5.2314", "added": false}, {"text": "3.9512", "added": false}], "options_source": "real", "image_only": false, "topic": "Algebra", "sub": "identities", "key_answer": null}, {"n": 8, "text": "", "options": [{"text": "2 : 3", "added": false}, {"text": "5 : 3", "added": false}, {"text": "3 : 2", "added": false}, {"text": "3 : 5", "added": false}], "options_source": "real", "image_only": true, "topic": "Ratio-Proportion", "sub": "ratio-basics", "key_answer": null}, {"n": 9, "text": "A dishonest dealer sells an article at a 10% loss on the cost price but uses a weight of 40 g instead of 50 g. What is his percentage of profit?", "options": [], "options_source": "missing", "image_only": false, "topic": "Profit-Loss", "sub": "dishonest-dealer", "key_answer": null}, {"n": 10, "text": "The total percentage change in the volume of a cuboid if its length and breadth are decreased by 15% and 25%, respectively, while its height is increased by 60% is:", "options": [{"text": "5% decrease", "added": false}, {"text": "2% decrease", "added": false}, {"text": "2% increase", "added": false}, {"text": "5% increase", "added": false}], "options_source": "real", "image_only": false, "topic": "Mensuration 3D", "sub": "cube-cuboid", "key_answer": null}, {"n": 11, "text": "", "options": [], "options_source": "missing", "image_only": true, "topic": "Algebra", "sub": "identities", "key_answer": null},