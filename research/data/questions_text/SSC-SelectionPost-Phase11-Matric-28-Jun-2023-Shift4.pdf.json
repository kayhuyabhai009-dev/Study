{"paper": "SSC-SelectionPost-Phase11-Matric-28-Jun-2023-Shift4.pdf", "status": "ok", "mode": "sequential", "splitter": "qdot", "section_slice": true, "extracted_count": 25, "tagged_count": 25, "questions": [{"n": 1, "text": "The third proportional to 12 and 36 is:", "options": [{"text": "96", "added": false}, {"text": "36", "added": false}, {"text": "12", "added": false}, {"text": "108", "added": false}], "options_source": "real", "image_only": false, "topic": "Ratio-Proportion", "sub": "proportion", "key_answer": null}, {"n": 2, "text": "A man sells a bicycle for ₹990 at a loss of 10%. At what price (in ₹) should he sell the bicycle to earn a profit of 24%?", "options": [{"text": "1,640", "added": false}, {"text": "1,664", "added": false}, {"text": "1,364", "added": false}, {"text": "1,380", "added": false}], "options_source": "real", "image_only": false, "topic": "Profit-Loss", "sub": "basic-cp-sp", "key_answer": null}, {"n": 3, "text": "What annual payment (in ₹) will discharge a debt of ₹1,500 in 10 years at 5% per annum simple interest? (Correct to two decimal places)", "options": [{"text": "111.44", "added": false}, {"text": "122.44", "added": false}, {"text": "123.44", "added": false}, {"text": "125.44", "added": false}], "options_source": "real", "image_only": false, "topic": "Simple Interest", "sub": "si-instalments", "key_answer": null}, {"n": 4, "text": "If by selling 12 textbooks, a seller earns profit equal to the selling price of 4 textbooks, what is his percentage profit?", "options": [], "options_source": "missing", "image_only": false, "topic": "Profit-Loss", "sub": "profit-loss-percent", "key_answer": null}, {"n": 5, "text": "Total savings of X and Y is 40% of their total income. Their average expenditure is ₹21,000. What is the total salary of X and Y?", "options": [], "options_source": "missing", "image_only": false, "topic": "Percentage", "sub": "income-expenditure", "key_answer": null}, {"n": 6, "text": "", "options": [{"text": "₹451.92", "added": false}, {"text": "₹492.92", "added": false}, {"text": "₹803.84", "added": false}, {"text": "₹401.92", "added": false}], "options_source": "real", "image_only": true, "topic": "Mensuration 3D", "sub": "sphere-hemisphere", "key_answer": null}, {"n": 7, "text": "The monthly income of Anvita was ₹28,500 and her monthly expenditure was ₹22,500. Next year her income increased by 16% and her expenditure increased by 10%. Find the percentage increase in her savings.", "options": [{"text": "35.5 Percent", "added": false}, {"text": "35.8 Percent", "added": false}, {"text": "38.5 Percent", "added": false}, {"text": "21.05 Percent", "added": false}], "options_source": "real", "image_only": false, "topic": "Percentage", "sub": "income-expenditure", "key_answer": null}, {"n": 8, "text": "A shopkeeper sold an article at 25% profit. On selling it for ₹225 more he would get a profit of 40%. The cost price of the article was:", "options": [], "options_source": "missing", "image_only": false, "topic": "Profit-Loss", "sub": "basic-cp-sp", "key_answer": null}, {"n": 9, "text": "Find the average of first 38 natural numbers.", "options": [{"text": "16.5", "added": false}, {"text": "19.5", "added": false}, {"text": "20.5", "added": false}, {"text": "19", "added": false}], "options_source": "real", "image_only": false, "topic": "Average", "sub": "series-average", "key_answer": null}, {"n": 10, "text": "The average of four numbers was 44. With the inclusion of a fifth number, y, the new average dropped to 42. What is the value of y?", "options": [{"text": "36", "added": false}, {"text": "34", "added": false}, {"text": "32", "added": false}, {"text": "40", "added": false}], "options_source": "real", "image_only": false, "topic": "Average", "sub": "replacement-effect", "key_answer": null}, {"n": 11, "text": "A solid iron sphere of radius 21 cm is melted down into a cone of height 84 cm. What will be the radius of the cone ?", "options": [{"text": "24 cm", "added": false}, {"text": "28 cm", "added": false}, {"text": "32 cm", "added": false}, {"text": "21 cm", "added": false}], "options_source": "real", "image_only": false, "topic": "Mensuration 3D", "sub": "conversion-and-melting", "key_answer": null}, {"n": 12, "text": "", "options": [], "options_source": "missing", "image_only": true, "topic": "Ratio-Proportion", "sub": "proportion", "key_answer": null}, {"n": 13, "text": "It takes 4 hours to go from Delhi to Chandigarh at an average speed of 60 km/h. How long it will take a person to go from Delhi to Chandigarh at an average speed of 50 km/h?", "options": [{"text": "4 hours 40 minutes", "added": false}, {"text": "4 hours 30 minutes", "added": false}, {"text": "4 hours 48 minutes", "added": false}, {"text": "5 hours", "added": false}], "options_source": "real", "image_only": false, "topic": "Time-Speed-Distance", "sub": "basic-tsd", "key_answer": null}, {"n": 14, "text": "If a : b : c = 4 : 7 : 9 and b : c : d = 28 : 36 : 21, then a : b : c : d is:", "options": [{"text": "12 : 21 : 27 : 17", "added": false}, {"text": "16 : 28 : 36 : 21", "added": false}, {"text": "8 : 14 : 18 : 21", "added": false}, {"text": "4 : 7 : 9 : 11", "added": false}], "options_source": "real", "image_only": false, "topic": "Ratio-Proportion", "sub": "ratio-basics", "key_answer": null}, {"n": 15, "text": "What is the net discount for two successive discounts of 15% and 35%?", "options": [{"text": "50%", "added": false}, {"text": "44.75%", "added": false}, {"text": "44.57%", "added": false}, {"text": "25%", "added": false}], "options_source": "real", "image_only": false, "topic": "Discount", "sub": "successive-discounts", "key_answer": null}, {"n": 16, "text": "Medha covers 81 km at a speed of 27 km/h by bike, 12 km at a speed of 6 km/h by bicycle, and another 270 km at a speed of 45 km/h by car. Find her average speed for the whole journey.", "options": [{"text": "33 km/h", "added": false}, {"text": "36 km/h", "added": false}, {"text": "34 km/h", "added": false}, {"text": "35 km/h", "added": false}], "options_source": "real", "image_only": false, "topic": "Time-Speed-Distance", "sub": "average-speed", "key_answer": null}, {"n": 17, "text": "The number 974581297426 is divisible by:", "options": [{"text": "6", "added": false}, {"text": "11", "added": false}, {"text": "4", "added": false}, {"text": "9", "added": false}], "options_source": "real", "image_only": false, "topic": "Number System", "sub": "divisibility-rules", "key_answer": null}, {"n": 18, "text": "", "options": [{"text": "₹54,575", "added": false}, {"text": "₹54,675", "added": false}, {"text": "₹54,475", "added": false}, {"text": "₹54,875", "added": false}], "options_source": "real", "image_only": true, "topic": "Simple Interest", "sub": "si-formula", "key_answer": null}, {"n": 19, "text": "15 men can complete a work in 15 days, whereas it takes 18 women to complete the work in 15 days. In how many days will 20 men and 9 women, together, complete the work? (Rounded off to complete number of days.)", "options": [{"text": "8", "added": false}, {"text": "15", "added": false}, {"text": "12", "added": false}, {"text": "5", "added": false}], "options_source": "real", "image_only": false, "topic": "Time-Work", "sub": "group-work", "key_answer": null}, {"n": 20, "text": "Rajesh marks his goods 30% above the cost price but allows a 12% discount for cash payment. If he sells the goods for ₹3,500, find his cost price (up to one place of decimal).", "options": [{"text": "₹3,090.5", "added": false}, {"text": "₹3,095.9", "added": false}, {"text": "₹3,054.9", "added": false}, {"text": "₹3,059.4", "added": false}], "options_source": "real", "image_only": false, "topic": "Discount", "sub": "mp-sp-relation", "key_answer": null}, {"n": 21, "text": "A person covers 11 km at a speed of 3 km/h, 21 km at a speed of 5 km/h and 37 km at a speed of 10 km/h. Find the average speed for the entire journey.", "options": [], "options_source": "missing", "image_only": false, "topic": "Time-Speed-Distance", "sub": "average-speed", "key_answer": null}, {"n": 22, "text": "Ravi borrowed ₹1,380 from a bank which he repaid in 6 years at the rate of 6% per annum simple interest. If payment was made in six equal instalment, then each instalment was:", "options": [{"text": "₹220", "added": false}, {"text": "₹200", "added": false}, {"text": "₹180", "added": false}, {"text": "₹190", "added": false}], "options_source": "real", "image_only": false, "topic": "Simple Interest", "sub": "si-instalments", "key_answer": null}, {"n": 23, "text": "Which of the following numbers is divisible by 120?", "options": [{"text": "170280", "added": false}, {"text": "140240", "added": false}, {"text": "156200", "added": false}, {"text": "170360", "added": false}], "options_source": "real", "image_only": false, "topic": "Number System", "sub": "divisibility-rules", "key_answer": null}, {"n": 24, "text": "If in an examination, the marks obtained by Rohan is 36% less than that of Pawan, then marks obtained by Pawan is how much percentage more than the marks obtained by Rohan?", "options": [{"text": "26.47%", "added": false}, {"text": "63.25%", "added": false}, {"text": "56.25%", "added": false}, {"text": "52.47%", "added": false}], "options_source": "real", "image_only": false, "topic": "Percentage", "sub": "increase-decrease", "key_answer": null}, {"n": 25, "text": "13 men can complete a work in 7 days. After 3 days, 4 more men joined them. How many days will they now take to complete the remaining work?", "options": [], "options_source": "missing", "image_only": false, "topic": "Time-Work", "sub": "group-work", "key_answer": null}]}