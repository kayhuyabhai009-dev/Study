asic-cp-sp", "key_answer": null}, {"n": 12, "text": "The number of prime numbers between 301 and 320 is:", "options": [{"text": "3", "added": false}, {"text": "5", "added": false}, {"text": "2", "added": false}, {"text": "4", "added": false}], "options_source": "real", "image_only": false, "topic": "Number System", "sub": "types-of-numbers", "key_answer": null}, {"n": 13, "text": "The marked price of an article is ₹420. It is sold for ₹368. If there is a loss of 8%, then by what percentage above the cost price is the article marked?", "options": [{"text": "6%", "added": false}, {"text": "8%", "added": false}, {"text": "5%", "added": false}, {"text": "4%", "added": false}], "options_source": "real", "image_only": false, "topic": "Compound Interest", "sub": "ci-formula", "key_answer": null}]}