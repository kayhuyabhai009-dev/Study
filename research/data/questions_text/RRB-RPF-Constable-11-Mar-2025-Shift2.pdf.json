{"paper": "RRB-RPF-Constable-11-Mar-2025-Shift2.pdf", "status": "ok", "mode": "answer-anchored", "splitter": "qdot", "section_slice": false, "extracted_count": 120, "tagged_count": 34, "questions": [{"n": 1, "text": "The number 56890065 is completely divisible by only:", "options": [{"text": "9", "added": false}, {"text": "3", "added": false}, {"text": "11 and 4", "added": false}, {"text": "6 and 7", "added": false}], "options_source": "real", "image_only": false, "topic": "Number System", "sub": "divisibility-rules", "key_answer": "3"}, {"n": 2, "text": "2% of 7% of a number is what percentage of that number?", "options": [{"text": "0.14", "added": false}, {"text": "0.014", "added": false}, {"text": "9", "added": false}, {"text": "14", "added": false}], "options_source": "real", "image_only": false, "topic": "Percentage", "sub": "basic-percentage", "key_answer": "0.14"}, {"n": 3, "text": "The ratio of three numbers is 5 : 7 : 9 and their LCM is 2835. Find the sum of the greater number and the difference between the first two numbers.", "options": [{"text": "88", "added": false}, {"text": "85", "added": false}, {"text": "99", "added": false}, {"text": "80", "added": false}], "options_source": "real", "image_only": false, "topic": "Ratio-Proportion", "sub": "ratio-basics", "key_answer": "99"}, {"n": 4, "text": "", "options": [{"text": "7.2", "added": false}, {"text": "8.3", "added": false}, {"text": "9.4", "added": false}, {"text": "6.1", "added": false}], "options_source": "real", "image_only": true, "topic": "Simplification", "sub": "bodmas", "key_answer": "6.1"}, {"n": 5, "text": "The difference between the compound interest and simple interest for the sum of ₹5,000 at 10% per annum for two years is:", "options": [{"text": "₹52", "added": false}, {"text": "₹49", "added": false}, {"text": "₹53", "added": false}, {"text": "₹50", "added": false}], "options_source": "real", "image_only": false, "topic": "Compound Interest", "sub": "si-ci-difference", "key_answer": "₹50"}, {"n": 6, "text": "Two banks, A and B, offered loans at 3.5% and 6% per annum, respectively. Gopal borrowed an amount of ₹440000 from each bank. Find the positive difference between the amounts of simple interest paid to the two banks by Gopal after 2 years.", "options": [{"text": "22000", "added": false}, {"text": "21500", "added": false}, {"text": "23500", "added": false}, {"text": "23000", "added": false}], "options_source": "real", "image_only": false, "topic": "Simple Interest", "sub": "si-formula", "key_answer": "22000"}, {"n": 7, "text": "There are 7847 students in a school and the ratio of boys to girls in the school is 42 : 17, then find the number of boys in school.", "options": [{"text": "5578", "added": false}, {"text": "5594", "added": false}, {"text": "5586", "added": false}, {"text": "5600", "added": false}], "options_source": "real", "image_only": false, "topic": "Ratio-Proportion", "sub": "ratio-basics", "key_answer": "5586"}, {"n": 8, "text": "What is the least number which when divided by 7, 14, 18 and 24 leaves remainder 6 in each case?", "options": [{"text": "510", "added": false}, {"text": "498", "added": false}, {"text": "512", "added": false}, {"text": "504", "added": false}], "options_source": "real", "image_only": false, "topic": "Number System", "sub": "remainder", "key_answer": "510"}, {"n": 9, "text": "Calculate the loss percentage (correct up to two decimals) if Moni had a loss of ₹250 and her product was sold at ₹100.", "options": [{"text": "72.53%", "added": false}, {"text": "71.43%", "added": false}, {"text": "68.33%", "added": false}, {"text": "67.23%", "added": false}], "options_source": "real", "image_only": false, "topic": "Profit-Loss", "sub": "profit-loss-percent", "key_answer": "71.43%"}, {"n": 10, "text": "In what ratio must water be mixed with milk to gain 15% by selling the mixture at cost price?", "options": [{"text": "3 : 17", "added": false}, {"text": "20 : 3", "added": false}, {"text": "17 : 3", "added": false}, {"text": "3 : 20", "added": false}], "options_source": "real", "image_only": false, "topic": "Mixture-Alligation", "sub": "milk-water-and-alloys", "key_answer": "3 : 20"}, {"n": 11, "text": "In what ratio should sugar costing ₹48 per kg be mixed with sugar costing ₹22 per kg so that by selling the mixture at ₹40.6 per kg, there is a profit of 16%?", "options": [{"text": "15 : 11", "added": false}, {"text": "13 : 13", "added": false}, {"text": "14 : 15", "added": false}, {"text": "15 : 14", "added": false}], "options_source": "real", "image_only": false, "topic": "Mixture-Alligation", "sub": "alligation", "key_answer": "13 : 13"}, {"n": 12, "text": "A trader offers several discount schemes. Choose the scheme that provides the lowest selling price from the following options.", "options": [{"text": "A single discount of 72%", "added": false}, {"text": "Buy one, get one free", "added": false}, {"text": "Buy one, get three free", "added": false}, {"text": "Buy two, get five free", "added": false}], "options_source": "real", "image_only": false, "topic": "Discount", "sub": "single-discount", "key_answer": "Buy one, get three free"}, {"n": 13, "text": "Find the value of", "options": [{"text": "60", "added": false}, {"text": "54", "added": false}, {"text": "61", "added": false}, {"text": "56", "added": false}], "options_source": "real", "image_only": false, "topic": "Simplification", "sub": "surds-and-indices", "key_answer": "56"}, {"n": 14, "text": "The average of first 129 even numbers is", "options": [{"text": "131", "added": false}, {"text": "130", "added": false}, {"text": "130.5", "added": false}, {"text": "129.5", "added": false}], "options_source": "real", "image_only": false, "topic": "Average", "sub": "series-average", "key_answer": "130"}, {"n": 15, "text": "Find the value of", "options": [{"text": "3.3", "added": true}, {"text": "3", "added": false}, {"text": "4", "added": true}, {"text": "2.7", "added": true}], "options_source": "added", "image_only": false, "topic": "Simplification", "sub": "surds-and-indices", "key_answer": "(3/8)^21"}, {"n": 16, "text": "The sum of five numbers is 655. The average of the first two numbers is 78 and the third number is 108. Find the average of the remaining two numbers?", "options": [{"text": "195.5", "added": false}, {"text": "187", "added": false}, {"text": "196.5", "added": false}, {"text": "186", "added": false}], "options_source": "real", "image_only": false, "topic": "Average", "sub": "series-average", "key_answer": "195.5"}, {"n": 17, "text": "A car travels 106 km in the first hour and 276 km in the second hour. What is the average speed (in km/h) of the car for the whole journey?", "options": [{"text": "194", "added": false}, {"text": "191", "added": false}, {"text": "183", "added": false}, {"text": "189", "added": false}], "options_source": "real", "image_only": false, "topic": "Time-Speed-Distance", "sub": "basic-tsd", "key_answer": "191"}, {"n": 18, "text": "The average of the marks of 15 students in a class is 41. If the marks of each student are doubled, find the new average?", "options": [{"text": "30", "added": false}, {"text": "41", "added": false}, {"text": "15", "added": false}, {"text": "82", "added": false}], "options_source": "real", "image_only": false, "topic": "Average", "sub": "simple-average", "key_answer": "82"}, {"n": 19, "text": "Ira has to reach Nagpur which is 744 km away in 16 hours. His starting speed for 8 hours was 34 km/hr. For the next 87 km his speed was 29km/hr. By what speed he must travel now so as to reach Nagpur in decided time of 16hours?", "options": [{"text": "83 km/hr", "added": false}, {"text": "79 km/hr", "added": false}, {"text": "77 km/hr", "added": false}, {"text": "74 km/hr", "added": false}], "options_source": "real", "image_only": false, "topic": "Time-Speed-Distance", "sub": "basic-tsd", "key_answer": "77 km/hr"}, {"n": 20, "text": "", "options": [], "options_source": "missing", "image_only": true, "topic": "Simplification", "sub": "surds-and-indices", "key_answer": "1/245"}, {"n": 21, "text": "Kartar marks his goods at 36% above the cost price and allows a discount of 16%. What is his gain percentage?", "options": [{"text": "14.6%", "added": false}, {"text": "13.6%", "added": false}, {"text": "13.24%", "added": false}, {"text": "14.24%", "added": false}], "options_source": "real", "image_only": false, "topic": "Profit-Loss", "sub": "profit-loss-percent", "key_answer": "14.24%"}, {"n": 22, "text": "The ages of Himani and Pushpraj are in the ratio of 8 : 5 respectively. After 9 years the ratio of their ages will be 3 : 2. What is the difference in their present ages?", "options": [{"text": "27", "added": false}, {"text": "15", "added": false}, {"text": "34", "added": false}, {"text": "16", "added": false}], "options_source": "real", "image_only": false, "topic": "Ratio-Proportion", "sub": "ratio-basics", "key_answer": "27"}, {"n": 23, "text": "", "options": [{"text": "1.25", "added": false}, {"text": "1", "added": false}, {"text": "2.5", "added": false}, {"text": "2", "added": false}], "options_source": "real", "image_only": true, "topic": "Simplification", "sub": "bodmas", "key_answer": "1.25"}, {"n": 24, "text": "A bike goes 83 meters in a second. Find its speed in km/hr.", "options": [{"text": "302.8", "added": false}, {"text": "298.8", "added": false}, {"text": "308.1", "added": false}, {"text": "297.3", "added": false}], "options_source": "real", "image_only": false, "topic": "Time-Speed-Distance", "sub": "basic-tsd", "key_answer": "298.8"}, {"n": 25, "text": "P is the perimeter of a square and D is the diagonal of the square, choose the correct relation.", "options": [], "options_source": "missing", "image_only": false, "topic": "Mensuration 2D", "sub": "triangle-and-quadrilaterals", "key_answer": null}, {"n": 26, "text": "The monthly incomes of two friends Ashish and Kiran, are in the ratio 5 : 7 respectively and each of them saves ₹81000 every month. If the ratio of their monthly expenditure is 2 : 3, find the monthly income of Ashish(in ₹).", "options": [{"text": "404000", "added": false}, {"text": "567000", "added": false}, {"text": "405000", "added": false}, {"text": "406000", "added": false}], "options_source": "real", "image_only": false, "topic": "Ratio-Proportion", "sub": "ratio-basics", "key_answer": "405000"}, {"n": 27, "text": "The difference between the compound interest (compounded annually) and the simple interest on a certain sum at 10% per annum for 2 years is ₹547. Find the sum.", "options": [{"text": "₹50,000", "added": false}, {"text": "₹54,700", "added": false}, {"text": "₹45,700", "added": false}, {"text": "₹74,500", "added": false}], "options_source": "real", "image_only": false, "topic": "Compound Interest", "sub": "si-ci-difference", "key_answer": "₹54,700"}, {"n": 28, "text": "", "options": [{"text": "1884", "added": false}, {"text": "5763", "added": false}, {"text": "3768", "added": false}, {"text": "7536", "added": false}], "options_source": "real", "image_only": true, "topic": "Mensuration 3D", "sub": "cone", "key_answer": "3768"}, {"n": 29, "text": "A cylindrical rod has an outer curved surface area of 6200 cm2. If the length of the rod is 32 cm, then the outer radius (in cm) of the rod, correct to two places of decimal, is:", "options": [{"text": "30.82", "added": false}, {"text": "30.31", "added": false}, {"text": "29.64", "added": false}, {"text": "32.46", "added": false}], "options_source": "real", "image_only": false, "topic": "Mensuration 2D", "sub": "triangle-and-quadrilaterals", "key_answer": "30.82"}, {"n": 30, "text": "Anjali can do a certain piece of work in 24 days. Anjali and Ayushi can together do the same work in 13 days, and Anjali, Ayushi and Ankita can do the same work together in 8 days. In how many days can Anjali and Ankita do the same work?", "options": [], "options_source": "missing", "image_only": false, "topic": "Time-Work", "sub": "together-apart", "key_answer": null}, {"n": 31, "text": "A sold an article to B at 12% profit and B sold it to C at 8% loss. If A sold it to C at the selling price of B, then find the profit or loss percentage that A would make.", "options": [{"text": "3.04% Profit", "added": false}, {"text": "3.04% Loss", "added": false}, {"text": "2.15% Profit", "added": false}, {"text": "2.15% Loss", "added": false}], "options_source": "real", "image_only": false, "topic": "Profit-Loss", "sub": "profit-loss-percent", "key_answer": "3.04% Profit"}, {"n": 32, "text": "Arun can do a piece of work in 8 hours. Mahesh can do it in 4 hours. With the assistance of Vijay, they completed the work in 2 hours. In how many hours can Vijay alone do it?", "options": [{"text": "7", "added": false}, {"text": "9", "added": false}, {"text": "10", "added": false}, {"text": "8", "added": false}], "options_source": "real", "image_only": false, "topic": "Time-Work", "sub": "together-apart", "key_answer": "8"}, {"n": 33, "text": "A number, 45000, is increased successively by 20% and 25%. Find the overall increase in percentage.", "options": [{"text": "45%", "added": false}, {"text": "22.5%", "added": false}, {"text": "47.5%", "added": false}, {"text": "50%", "added": false}], "options_source": "real", "image_only": false, "topic": "Percentage", "sub": "successive-change", "key_answer": "50%"}, {"n": 34, "text": "How many seconds will a boy take to run one complete round around a square field of side 42 metres, if he runs at a speed of 12 km/h?", "options": [{"text": "47", "added": false}, {"text": "60", "added": false}, {"text": "50.4", "added": false}, {"text": "48 Section : General Intelligence and Reasoning", "added": false}], "options_source": "real", "image_only": false, "topic": "Time-Speed-Distance", "sub": "basic-tsd", "key_answer": "50.4"}]}