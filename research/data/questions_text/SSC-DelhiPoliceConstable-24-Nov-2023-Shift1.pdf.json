2 cm2", "added": false}, {"text": "75 cm2", "added": false}, {"text": "93 cm2", "added": false}, {"text": "105 cm2", "added": false}], "options_source": "real", "image_only": false, "topic": "Mensuration 2D", "sub": "triangle-and-quadrilaterals", "key_answer": null}, {"n": 7, "text": "A boat can travel at a speed of 13 km/h in still water. If the speed of the stream is 4 km/h, then the time taken by boat to go 63 km in the opposite direction to stream is:", "options": [{"text": "6 hours", "added": false}, {"text": "5 hours", "added": false}, {"text": "9 hours", "added": false}, {"text": "7 hours", "added": false}], "options_source": "real", "image_only": false, "topic": "Boats-Streams", "sub": "upstream-downstream", "key_answer": null}, {"n": 8, "text": "Find the average of the given numbers. 3, 7, 9, -5, 0.25, -3.75", "options": [{"text": "10.5", "added": false}, {"text": "2.625", "added": false}, {"text": "4.67", "added": false}, {"text": "1.75", "added": false}], "options_source": "real", "image_only": false, "topic": "Average", "sub": "simple-average", "key_answer": null}, {"n": 9, "text": "In how many years will ₹7,81,250 amount to ₹9,13,952 at 4% compound interest?", "options": [{"text": "4", "added": false}, {"text": "4.5", "added": false}, {"text": "3", "added": false}, {"text": "3.5", "added": false}], "options_source": "real", "image_only": false, "topic": "Compound Interest", "sub": "ci-formula", "key_answer": null}, {"n": 10, "text": "If 42 workers earn ₹4,080 in 5 days, how much will 48 workers earn in 14 days?", "options": [{"text": "₹13,056", "added": false}, {"text": "₹13,198", "added": false}, {"text": "₹6,528", "added": false}, {"text": "₹6,128", "added": false}], "options_source": "real", "image_only": false, "topic": "Time-Work", "sub": "group-work", "key_answer": null}, {"n": 11, "text": "The ratio of income and expenditure is 9∶ 5. Income increases by 40% and expenditure decreases by 10%. If the initial income is ₹45,000 then the final saving (in ₹) is:", "options": [{"text": "40,500", "added": false}, {"text": "40,000", "added": false}, {"text": "35,000", "added": false}, {"text": "41,000", "added": false}], "options_source": "real", "image_only": false, "topic": "Percentage", "sub": "income-expenditure", "key_answer": null}, {"n": 12, "text": "The ratio of two numbers is 16:19 and their least common multiple is 59280. What are the two numbers?", "options": [{"text": "3120 and 3705", "added": false}, {"text": "5345 and 2298", "added": false}, {"text": "3750 and 2130", "added": false}, {"text": "3175 and 2123", "added": false}], "options_source": "real", "image_only": false, "topic": "HCF-LCM", "sub": "hcf-lcm-of-numbers", "key_answer": null}, {"n": 13, "text": "", "options": [{"text": "1.05", "added": false}, {"text": "1.07", "added": false}, {"text": "1.08", "added": false}, {"text": "1.03", "added": false}], "options_source": "real", "image_only": true, "topic": "Algebra", "sub": "identities", "key_answer": null}, {"n": 14, "text": "How long (in years) will it take a sum of money invested at 8% per annum on simple interest to increase its value by 40%?", "options": [{"text": "5", "added": false}, {"text": "3", "added": false}, {"text": "6", "added": false}, {"text": "7", "added": false}], "options_source": "real", "image_only": false, "topic": "Simple Interest", "sub": "si-formula", "key_answer": null}, {"n": 15, "text": "If each side of an equilateral triangle is increased by 80%, then by what percentage will the area increase?", "options": [{"text": "120%", "added": false}, {"text": "240%", "added": false}, {"text": "238%", "added": false}, {"text": "224%", "added": false}], "options_source": "real", "image_only": false, "topic": "Percentage", "sub": "increase-decrease", "key_answer": null}]}