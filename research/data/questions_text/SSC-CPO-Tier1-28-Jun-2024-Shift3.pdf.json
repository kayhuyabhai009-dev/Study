{"paper": "SSC-CPO-Tier1-28-Jun-2024-Shift3.pdf", "status": "ok", "mode": "sequential", "splitter": "qdot", "section_slice": true, "extracted_count": 50, "tagged_count": 50, "questions": [{"n": 1, "text": "The sum of any two sides of a triangle is:", "options": [{"text": "less than the third side", "added": false}, {"text": "greater than the third side", "added": false}, {"text": "equal to third side", "added": false}, {"text": "less than or equal to third side", "added": false}], "options_source": "real", "image_only": false, "topic": "Geometry", "sub": "lines-and-angles", "key_answer": null}, {"n": 2, "text": "", "options": [{"text": "324", "added": false}, {"text": "429", "added": false}, {"text": "356", "added": false}, {"text": "405", "added": false}], "options_source": "real", "image_only": true, "topic": "Data Interpretation", "sub": "table", "key_answer": null}, {"n": 3, "text": "", "options": [{"text": "45%", "added": false}, {"text": "20%", "added": false}, {"text": "50%", "added": false}, {"text": "35%", "added": false}], "options_source": "real", "image_only": true, "topic": "Mensuration 3D", "sub": "conversion-and-melting", "key_answer": null}, {"n": 4, "text": "Find the perimeter of a triangle with sides equal to 13 cm, 12 cm and 5 cm.", "options": [{"text": "5 cm", "added": false}, {"text": "25 cm", "added": false}, {"text": "30 cm", "added": false}, {"text": "15 cm", "added": false}], "options_source": "real", "image_only": false, "topic": "Mensuration 2D", "sub": "triangle-and-quadrilaterals", "key_answer": null}, {"n": 5, "text": "Simplify the following expression.", "options": [{"text": "4.5", "added": false}, {"text": "3.5", "added": false}, {"text": "1.5", "added": false}, {"text": "2.5", "added": false}], "options_source": "real", "image_only": false, "topic": "Algebra", "sub": "identities", "key_answer": null}, {"n": 6, "text": "The distance between the parallel sides of a trapezium is 18 cm. If the area of the trapezium is 1188 cm2, then what is the sum of the lengths of the parallel sides?", "options": [{"text": "115 cm", "added": false}, {"text": "126 cm", "added": false}, {"text": "132 cm", "added": false}, {"text": "150 cm", "added": false}], "options_source": "real", "image_only": false, "topic": "Mensuration 2D", "sub": "triangle-and-quadrilaterals", "key_answer": null}, {"n": 7, "text": "", "options": [{"text": "90°", "added": false}, {"text": "30°", "added": false}, {"text": "20°", "added": false}, {"text": "60°", "added": false}], "options_source": "real", "image_only": true, "topic": "Trigonometry", "sub": "ratios-and-tables", "key_answer": null}, {"n": 8, "text": "A travels for 8 hours at the rate of 4 km/h and for 4 hours at the rate of 8 km/h. The average speed of the journey (in km/h) is:", "options": [], "options_source": "missing", "image_only": false, "topic": "Time-Speed-Distance", "sub": "average-speed", "key_answer": null}, {"n": 9, "text": "The table below shows employees of a company in 5 different towns over the period of 5 years. Note: All figures are fictitious. Employees from Pune in 2018 are what per cent of the total employees of all towns together in that year?", "options": [{"text": "3%", "added": false}, {"text": "6%", "added": false}, {"text": "4%", "added": false}, {"text": "5%", "added": false}], "options_source": "real", "image_only": false, "topic": "Data Interpretation", "sub": "table", "key_answer": null}, {"n": 10, "text": "", "options": [{"text": "4", "added": false}, {"text": "2", "added": false}, {"text": "3", "added": false}, {"text": "5", "added": false}], "options_source": "real", "image_only": true, "topic": "Algebra", "sub": "polynomials-and-factorisation", "key_answer": null}, {"n": 11, "text": "The simple interest on a certain sum for 4 years at 14% per annum is ₹6,160 less than the simple interest on the same sum at the same rate for 8 years. Find the sum.", "options": [{"text": "₹9,000", "added": false}, {"text": "₹12,000", "added": false}, {"text": "₹11,000", "added": false}, {"text": "₹10,000", "added": false}], "options_source": "real", "image_only": false, "topic": "Simple Interest", "sub": "rate-time-principal", "key_answer": null}, {"n": 12, "text": "", "options": [{"text": "a", "added": false}, {"text": "3", "added": false}, {"text": "2", "added": false}, {"text": "4", "added": false}], "options_source": "real", "image_only": true, "topic": "Ratio-Proportion", "sub": "proportion", "key_answer": null}, {"n": 13, "text": "Simplify the given expression.", "options": [], "options_source": "missing", "image_only": false, "topic": "Algebra", "sub": "identities", "key_answer": null}, {"n": 14, "text": "", "options": [{"text": "3", "added": false}, {"text": "2", "added": false}, {"text": "−3", "added": false}, {"text": "0", "added": false}], "options_source": "real", "image_only": true, "topic": "Algebra", "sub": "identities", "key_answer": null}, {"n": 15, "text": "", "options": [{"text": "3", "added": false}, {"text": "9", "added": false}, {"text": "6", "added": false}, {"text": "0", "added": false}], "options_source": "real", "image_only": true, "topic": "Simplification", "sub": "bodmas", "key_answer": null}, {"n": 16, "text": "", "options": [{"text": "42.5%", "added": false}, {"text": "38.5%", "added": false}, {"text": "41.55%", "added": false}, {"text": "37.55%", "added": false}], "options_source": "real", "image_only": true, "topic": "Percentage", "sub": "basic-percentage", "key_answer": null}, {"n": 17, "text": "", "options": [{"text": "14", "added": false}, {"text": "9", "added": false}, {"text": "8", "added": false}, {"text": "10", "added": false}], "options_source": "real", "image_only": true, "topic": "Algebra", "sub": "identities", "key_answer": null}, {"n": 18, "text": "Three circles each of radius 5 cm touch one another. The area (in cm2) subtended between them is:", "options": [], "options_source": "missing", "image_only": false, "topic": "Mensuration 2D", "sub": "triangle-and-quadrilaterals", "key_answer": null}, {"n": 19, "text": "", "options": [{"text": "sec2θ", "added": false}, {"text": "cot2θ", "added": false}, {"text": "cosec2θ", "added": false}, {"text": "sin2θ", "added": false}], "options_source": "real", "image_only": true, "topic": "Trigonometry", "sub": "ratios-and-tables", "key_answer": null}, {"n": 20, "text": "The cost of Compressed Natural Gas (CNG) per litre is increased by 65%. By what percentage must Manish reduce his consumption of CNG so as not to increase his expenditure? (correct up to two decimal places)", "options": [{"text": "25.39%", "added": false}, {"text": "45.13%", "added": false}, {"text": "39.39%", "added": false}, {"text": "30.13%", "added": false}], "options_source": "real", "image_only": false, "topic": "Percentage", "sub": "income-expenditure", "key_answer": null}, {"n": 21, "text": "", "options": [{"text": "Centre 1", "added": false}, {"text": "Centre 3", "added": false}, {"text": "Centre 2", "added": false}, {"text": "Centre 4", "added": false}], "options_source": "real", "image_only": true, "topic": "Data Interpretation", "sub": "table", "key_answer": null}, {"n": 22, "text": "Arrange the following ratios in ascending order. 3 : 4, 3 : 5, 2 : 11, 7 : 2", "options": [{"text": "3 : 5 < 2 : 11 < 3 : 4 < 7 : 2", "added": false}, {"text": "2:11 < 3: 5 < 3 : 4 < 7 : 2", "added": false}, {"text": "7 : 2 < 3 : 4 < 3 : 5 < 2 : 11", "added": false}, {"text": "3 : 4 < 3 : 5 < 2:11 < 7: 2", "added": false}], "options_source": "real", "image_only": false, "topic": "Ratio-Proportion", "sub": "ratio-basics", "key_answer": null}, {"n": 23, "text": "P can do a piece of work in 30 days and Q in 40 days. They work together for 4 days and then Q leaves. The number of days taken by P to finish the remaining work is:", "options": [{"text": "28 days", "added": false}, {"text": "23 days", "added": false}, {"text": "30 days", "added": false}, {"text": "7 days", "added": false}], "options_source": "real", "image_only": false, "topic": "Time-Work", "sub": "together-apart", "key_answer": null}, {"n": 24, "text": "Ashish covers 72 km at a speed of 45 km/h by bike, 28 km at a speed of 4 km/h by bicycle, and another 160 km at a speed of 20 km/h by car. Find his average speed (in km/h) for the whole journey. (Rounded off to two decimal places)", "options": [{"text": "15.66", "added": false}, {"text": "28.33", "added": false}, {"text": "25.25", "added": false}, {"text": "27.65", "added": false}], "options_source": "real", "image_only": false, "topic": "Time-Speed-Distance", "sub": "average-speed", "key_answer": null}, {"n": 25, "text": "If 56 ÷ 4 + p × 3 – 24 ÷ 12 + 4 = 21 ÷ 3 + 3, then the value of p is:", "options": [{"text": "2", "added": false}, {"text": "1", "added": false}, {"text": "−1", "added": false}, {"text": "−2", "added": false}], "options_source": "real", "image_only": false, "topic": "Simplification", "sub": "bodmas", "key_answer": null}, {"n": 26, "text": "", "options": [{"text": "28.68", "added": false}, {"text": "25.35", "added": false}, {"text": "15.25", "added": false}, {"text": "18.68", "added": false}], "options_source": "real", "image_only": true, "topic": "Mensuration 3D", "sub": "cone", "key_answer": null}, {"n": 27, "text": "", "options": [{"text": "3.5 cm", "added": false}, {"text": "2.8 cm", "added": false}, {"text": "3.0 cm", "added": false}, {"text": "2.5 cm", "added": false}], "options_source": "real", "image_only": true, "topic": "Mensuration 3D", "sub": "cone", "key_answer": null}, {"n": 28, "text": "", "options": [{"text": "286", "added": false}, {"text": "256", "added": false}, {"text": "206", "added": false}, {"text": "226", "added": false}], "options_source": "real", "image_only": true, "topic": "Data Interpretation", "sub": "table", "key_answer": null}, {"n": 29, "text": "A train covers a distance of 72 km in 40 minutes. Travelling at the same speed, how many metres will the train cover in 6 seconds?", "options": [{"text": "210", "added": false}, {"text": "174", "added": false}, {"text": "192", "added": false}, {"text": "180", "added": false}], "options_source": "real", "image_only": false, "topic": "Trains", "sub": "two-trains", "key_answer": null}, {"n": 30, "text": "If the number of school going children in a town is 64000 and it is increasing annually by 10%, then what will be the number of school going children in the town at the end of 3 years?", "options": [{"text": "85000", "added": false}, {"text": "85100", "added": false}, {"text": "85184", "added": false}, {"text": "80000", "added": false}], "options_source": "real", "image_only": false, "topic": "Percentage", "sub": "basic-percentage", "key_answer": null}, {"n": 31, "text": "", "options": [], "options_source": "missing", "image_only": true, "topic": "Simplification", "sub": "bodmas", "key_answer": null}, {"n": 32, "text": "", "options": [], "options_source": "missing", "image_only": true, "topic": "Trigonometry", "sub": "identities", "key_answer": null}, {"n": 33, "text": "The marked price of a table is ₹5,980. If the shopkeeper offers a discount of 18%, what is its selling price (in ₹, to the nearest rupee)?", "options": [{"text": "4,940", "added": false}, {"text": "4,490", "added": false}, {"text": "4,094", "added": false}, {"text": "4,904", "added": false}], "options_source": "real", "image_only": false, "topic": "Discount", "sub": "single-discount", "key_answer": null}, {"n": 34, "text": "A vessel contains 18 litres mixture of milk and water in the ratio 5 : 1. If 3 litres of milk is added to the vessel, then how much water (in litres) should be added to the vessel to have milk and water in the ratio 9 : 2?", "options": [{"text": "2", "added": false}, {"text": "1.5", "added": false}, {"text": "1", "added": false}, {"text": "0.5", "added": false}], "options_source": "real", "image_only": false, "topic": "Mixture-Alligation", "sub": "milk-water-and-alloys", "key_answer": null}, {"n": 35, "text": "Two trains are moving in the same direction at 60 km/h and 42 km/h. The faster train crosses a man in the slower train in 36 seconds. Find the length of the faster train.", "options": [{"text": "185 m", "added": false}, {"text": "195 m", "added": false}, {"text": "180 m", "added": false}, {"text": "175 m", "added": false}], "options_source": "real", "image_only": false, "topic": "Trains", "sub": "two-trains", "key_answer": null}, {"n": 36, "text": "", "options": [{"text": "1985", "added": false}, {"text": "1986", "added": false}, {"text": "1988", "added": false}, {"text": "1989", "added": false}], "options_source": "real", "image_only": true, "topic": "Data Interpretation", "sub": "table", "key_answer": null}, {"n": 37, "text": "A vegetable vendor bought 100 kg of potatoes at the rate of ₹19 per kg and spent ₹100 as cartage. He sold 60 kg of potatoes with a 50% profit and half of the remaining stock with a 40% profit. He sold half of the still remaining potatoes with a 25% profit. What profit percentage should he aim for when selling the ultimate remaining potatoes to achieve an overall profit of 42%?", "options": [{"text": "0.1", "added": false}, {"text": "0.15", "added": false}, {"text": "0.12", "added": false}, {"text": "0.16", "added": false}], "options_source": "real", "image_only": false, "topic": "Profit-Loss", "sub": "profit-loss-percent", "key_answer": null}, {"n": 38, "text": "", "options": [], "options_source": "missing", "image_only": true, "topic": "Simplification", "sub": "bodmas", "key_answer": null}, {"n": 39, "text": "A trader sells pulses at a 32% profit and uses weights 20% less than the actual measure. Find his gain percentage.", "options": [], "options_source": "missing", "image_only": false, "topic": "Profit-Loss", "sub": "profit-loss-percent", "key_answer": null}, {"n": 40, "text": "", "options": [{"text": "15", "added": false}, {"text": "10", "added": false}, {"text": "30", "added": false}, {"text": "20", "added": false}], "options_source": "real", "image_only": true, "topic": "Data Interpretation", "sub": "table", "key_answer": null}, {"n": 41, "text": "A shopkeeper kept the marked price of an item at ₹500. He sold it at a scheme discount of 10% and 20% and got a profit of 25%. What was the cost price of the item?", "options": [{"text": "₹188", "added": false}, {"text": "₹482", "added": false}, {"text": "₹288", "added": false}, {"text": "₹384", "added": false}], "options_source": "real", "image_only": false, "topic": "Discount", "sub": "single-discount", "key_answer": null}, {"n": 42, "text": "The value of 72 ÷ 8 − 210 ÷ 15 − 5 + 2 × 5 is:", "options": [{"text": "3", "added": false}, {"text": "0", "added": false}, {"text": "1", "added": false}, {"text": "2", "added": false}], "options_source": "real", "image_only": false, "topic": "Simplification", "sub": "bodmas", "key_answer": null}, {"n": 43, "text": "", "options": [{"text": "–1", "added": false}, {"text": "2", "added": false}, {"text": "–2", "added": false}, {"text": "1", "added": false}], "options_source": "real", "image_only": true, "topic": "Trigonometry", "sub": "identities", "key_answer": null}, {"n": 44, "text": "", "options": [{"text": "30", "added": false}, {"text": "40", "added": false}, {"text": "50", "added": false}, {"text": "120", "added": false}], "options_source": "real", "image_only": true, "topic": "Data Interpretation", "sub": "table", "key_answer": null}, {"n": 45, "text": "What is the ratio between S and T if S is 75% of T?", "options": [], "options_source": "missing", "image_only": false, "topic": "Ratio-Proportion", "sub": "ratio-basics", "key_answer": null}, {"n": 46, "text": "Simplify. 22.0625 – [15 + 0.25 × (4.78 – 1.5 × 3.02)]", "options": [{"text": "7.1", "added": false}, {"text": "7.3", "added": false}, {"text": "7.2", "added": false}, {"text": "7.0", "added": false}], "options_source": "real", "image_only": false, "topic": "Simplification", "sub": "bodmas", "key_answer": null}, {"n": 47, "text": "A gear 15 cm in diameter is turning a gear 21 cm in diameter. When the smaller gear has 105 revolutions