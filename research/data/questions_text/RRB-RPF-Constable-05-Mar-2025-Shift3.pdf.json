source": "real", "image_only": false, "topic": "Simplification", "sub": "roots", "key_answer": "14.61"}, {"n": 12, "text": "A car travels 281 km in the first hour and 163 km in the second hour. What is the average speed (in km/h) of the car for the whole journey?", "options": [{"text": "215", "added": false}, {"text": "222", "added": false}, {"text": "229", "added": false}, {"text": "223", "added": false}], "options_source": "real", "image_only": false, "topic": "Time-Speed-Distance", "sub": "basic-tsd", "key_answer": "222"}, {"n": 13, "text": "The average of first 117 even numbers is", "options": [{"text": "117.5", "added": false}, {"text": "118.5", "added": false}, {"text": "118", "added": false}, {"text": "119", "added": false}], "options_source": "real", "image_only": false, "topic": "Average", "sub": "series-average", "key_answer": "118"}, {"n": 14, "text": "Kanchan bought 52 books for Rs 1130 from one shop and 47 books for Rs 905 from another. What is the average price (in Rs) he paid per book ?", "options": [{"text": "1033.18", "added": false}, {"text": "1038.18", "added": false}, {"text": "1013.18", "added": false}, {"text": "1023.18", "added": false}], "options_source": "real", "image_only": false, "topic": "Average", "sub": "simple-average", "key_answer": "1023.18"}, {"n": 15, "text": "Find the greatest four-digit number which is exactly divisible by 39.", "options": [{"text": "9945", "added": false}, {"text": "9906", "added": false}, {"text": "9867", "added": false}, {"text": "9984", "added": false}], "options_source": "real", "image_only": false, "topic": "Number System", "sub": "divisibility-rules", "key_answer": "9984"}, {"n": 16, "text": "How many litres of milk with 24% concentration are to be mixed with 18 litres with 72% concentration to get a mixture with 36% concentration?", "options": [{"text": "56", "added": false}, {"text": "54", "added": false}, {"text": "52", "added": false}, {"text": "48", "added": false}], "options_source": "real", "image_