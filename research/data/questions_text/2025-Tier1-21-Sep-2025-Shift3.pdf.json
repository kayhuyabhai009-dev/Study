{"paper": "2025-Tier1-21-Sep-2025-Shift3.pdf", "status": "ok", "mode": "letter-sequence", "splitter": "qn", "section_slice": false, "extracted_count": 91, "tagged_count": 25, "questions": [{"n": 1, "text": "A pump can empty a water reservoir in 12 hours. After 4 hours, two more identical pumps are started. What is the total time taken to empty the reservoir?", "options": [{"text": "6 hours 40 minutes", "added": false}, {"text": "7 hours", "added": false}, {"text": "8 hours", "added": false}, {"text": "5 hours 20 minutes", "added": false}], "options_source": "real", "image_only": false, "topic": "Pipes-Cisterns", "sub": "fill-empty", "key_answer": "a"}, {"n": 2, "text": "The ratio of the radii of two cylinders is 2:3 and the ratio of their heights is 5:4. Find the ratio of their volumes.", "options": [{"text": "5:9", "added": false}, {"text": "4:9", "added": false}, {"text": "20:27", "added": false}, {"text": "10:27", "added": false}], "options_source": "real", "image_only": false, "topic": "Mensuration 3D", "sub": "cylinder", "key_answer": "a"}, {"n": 3, "text": "If the average of a, b, and c is 60, and the average of a and b is 55, what is the value of c?", "options": [{"text": "75", "added": false}, {"text": "65", "added": false}, {"text": "70", "added": false}, {"text": "80", "added": false}], "options_source": "real", "image_only": false, "topic": "Average", "sub": "simple-average", "key_answer": "c"}, {"n": 4, "text": "A cyclist covers a distance of 1500 m in 6 minutes. What is his speed in km per hour?", "options": [{"text": "12 km/h", "added": false}, {"text": "15 km/h", "added": false}, {"text": "18 km/h", "added": false}, {"text": "20 km/h", "added": false}], "options_source": "real", "image_only": false, "topic": "Time-Speed-Distance", "sub": "basic-tsd", "key_answer": "b"}, {"n": 5, "text": "A boat travels 24 km upstream and 28 km downstream in 9 hours. It also travels 30 km upstream and 21 km downstream in 10 hours. Find the speed of the boat in still water.", "options": [{"text": "6.50 km/h", "added": false}, {"text": "7.45 km/h", "added": false}, {"text": "10.45 km/h", "added": false}, {"text": "12 km/h", "added": false}], "options_source": "real", "image_only": false, "topic": "Boats-Streams", "sub": "upstream-downstream", "key_answer": "b"}, {"n": 6, "text": "A triangular metal plate has sides in the ratio 3:4:5. If the perimeter is 36 m, what is the area?", "options": [{"text": "108 m²", "added": false}, {"text": "72 m²", "added": false}, {"text": "48 m²", "added": false}, {"text": "54 m²", "added": false}], "options_source": "real", "image_only": false, "topic": "Ratio-Proportion", "sub": "ratio-basics", "key_answer": "d"}, {"n": 7, "text": "A grocer mixes two varieties of pulses costing Rs. 80/kg and Rs. 120/kg. He sells the mixture at Rs. 110/kg, making a 10% profit. In what ratio were the varieties mixed?", "options": [{"text": "1:1", "added": false}, {"text": "2:1", "added": false}, {"text": "1:2", "added": false}, {"text": "3:2", "added": false}], "options_source": "real", "image_only": false, "topic": "Profit-Loss", "sub": "profit-loss-percent", "key_answer": "a"}, {"n": 8, "text": "A pyramid with a square base of side 12 cm and height 15 cm is placed on top of a cube with side length 12 cm. Find the total volume of the composite solid.", "options": [{"text": "2160 cm³", "added": false}, {"text": "2448 cm³", "added": false}, {"text": "1728 cm³", "added": false}, {"text": "2880 cm³", "added": false}], "options_source": "real", "image_only": false, "topic": "Mensuration 3D", "sub": "cube-cuboid", "key_answer": "b"}, {"n": 9, "text": "X and Y invested Rs. 90,000 and Rs. 60,000 respectively for a project. X takes 15% of the total profit as a management fee. If the total profit is Rs. 1,50,000, what is Y's share?", "options": [{"text": "Rs. 76,500", "added": false}, {"text": "Rs. 60,000", "added": false}, {"text": "Rs. 51,000", "added": false}, {"text": "Rs. 54,000", "added": false}], "options_source": "real", "image_only": false, "topic": "Time-Work", "sub": "together-apart", "key_answer": "c"}, {"n": 10, "text": "If the simple interest on a sum of Rs. P at 8% per annum for 3 years is equal to the simple interest on Rs. Q at 6% per annum for 4 years, then what is the ratio of P to Q?", "options": [{"text": "1:2", "added": false}, {"text": "3:4", "added": false}, {"text": "4:3", "added": false}, {"text": "1:1", "added": false}], "options_source": "real", "image_only": false, "topic": "Simple Interest", "sub": "si-formula", "key_answer": "d"}, {"n": 11, "text": "What will come in place of ? to satisfy the equation : (√7 – 1)² = ? – 2√7", "options": [{"text": "8", "added": false}, {"text": "7", "added": false}, {"text": "6", "added": false}, {"text": "5", "added": false}], "options_source": "real", "image_only": false, "topic": "Algebra", "sub": "linear-equations", "key_answer": "a"}, {"n": 12, "text": "Find the y-intercept of the line 3x + 4y = 12.", "options": [{"text": "12", "added": false}, {"text": "4", "added": false}, {"text": "3", "added": false}, {"text": "7", "added": false}], "options_source": "real", "image_only": false, "topic": "Algebra", "sub": "expression-values", "key_answer": "c"}, {"n": 13, "text": "A manufacturer sells an item to a distributor at a profit of 10%. The distributor sells it to a shopkeeper at 20% profit. The shopkeeper marks it up by 25% and gives no discount. If the final price is Rs. 1,650, find the original cost for the manufacturer .", "options": [{"text": "Rs. 1,000", "added": false}, {"text": "Rs. 1,100", "added": false}, {"text": "Rs. 1,200", "added": false}, {"text": "Rs. 1,050", "added": false}], "options_source": "real", "image_only": false, "topic": "Profit-Loss", "sub": "basic-cp-sp", "key_answer": "a"}, {"n": 14, "text": "In a right prism with an equilateral triangular base of side 6 cm, the volume is 180√3 cm³. What is the height of the prism?", "options": [{"text": "15 cm", "added": false}, {"text": "20 cm", "added": false}, {"text": "10 cm", "added": false}, {"text": "25 cm", "added": false}], "options_source": "real", "image_only": false, "topic": "Mensuration 3D", "sub": "frustum-prism-pyramid", "key_answer": "b"}, {"n": 15, "text": "A businessman invests Rs. 85,000 at a rate of 10% compound interest per annum, compounded annually. Find the interest for the 3rd year only.", "options": [{"text": "Rs. 10,285", "added": false}, {"text": "Rs. 9,350", "added": false}, {"text": "Rs. 8,500", "added": false}, {"text": "Rs. 11,250", "added": false}], "options_source": "real", "image_only": false, "topic": "Compound Interest", "sub": "ci-formula", "key_answer": "a"}, {"n": 16, "text": "Which of these is a number that is real but NOT rational?", "options": [{"text": "22/7", "added": false}, {"text": "3.1415", "added": false}, {"text": "√13", "added": false}, {"text": "- 8", "added": false}], "options_source": "real", "image_only": false, "topic": "Data Interpretation", "sub": "table", "key_answer": "c"}, {"n": 17, "text": "In a circle, two chords AB and CD intersect at point P inside the circle. If AP = 4 cm, PB = 6 cm, and CP = 3 cm, find the length of PD.", "options": [{"text": "10 cm", "added": false}, {"text": "6 cm", "added": false}, {"text": "4 cm", "added": false}, {"text": "8 cm", "added": false}], "options_source": "real", "image_only": false, "topic": "Circles-Polygons", "sub": "circle-theorems", "key_answer": "d"}, {"n": 18, "text": "Three numbers are such that the second is 120% of the first, and the third is 75% of the second. What is the ratio of the first to the third?", "options": [{"text": "10:9", "added": false}, {"text": "9:10", "added": false}, {"text": "4:3", "added": false}, {"text": "5:6", "added": false}], "options_source": "real", "image_only": false, "topic": "Percentage", "sub": "basic-percentage", "key_answer": "a"}, {"n": 19, "text": "A triangular park with base 50 m and height 40 m shares a boundary with a rectangular garden of length 50 m and breadth 30 m. Find the combined area and percentage of the park's area in the total .", "options": [{"text": "2,500 m² and 33.33%", "added": false}, {"text": "2,000 m² and 50%", "added": false}, {"text": "2,500 m² and 40%", "added": false}, {"text": "1,500 m² and 66.67%", "added": false}], "options_source": "real", "image_only": false, "topic": "Mensuration 2D", "sub": "triangle-and-quadrilaterals", "key_answer": "c"}, {"n": 20, "text": "Find the value of cos² 90° + sin² 30°.", "options": [{"text": "3/4", "added": false}, {"text": "1/2", "added": false}, {"text": "1/4", "added": false}, {"text": "1", "added": false}], "options_source": "real", "image_only": false, "topic": "Algebra", "sub": "identities", "key_answer": "c"}, {"n": 21, "text": "A regular hexagon is inscribed inside a circle of radius 10 cm. Find the area of the hexagon.", "options": [{"text": "210.50 cm²", "added": false}, {"text": "314.16 cm²", "added": false}, {"text": "173.20 cm²", "added": false}, {"text": "259.81 cm²", "added": false}], "options_source": "real", "image_only": false, "topic": "Circles-Polygons", "sub": "polygons", "key_answer": "d"}, {"n": 22, "text": "A value was mistakenly decreased by 10% instead of increased by 10%. By what percent is the final result less than the CORRECT value?", "options": [{"text": "20%", "added": false}, {"text": "18.18%", "added": false}, {"text": "15.5%", "added": false}, {"text": "22.22%", "added": false}], "options_source": "real", "image_only": false, "topic": "Algebra", "sub": "identities", "key_answer": "a"}, {"n": 23, "text": "If cos A = 5/13, then find the value of tan A + sec A.", "options": [{"text": "13/5", "added": false}, {"text": "17/5", "added": false}, {"text": "12/5", "added": false}, {"text": "5", "added": false}], "options_source": "real", "image_only": false, "topic": "Percentage", "sub": "increase-decrease", "key_answer": "b"}, {"n": 24, "text": "Find the remainder when (7¹⁹ + 2) is divided by 6.", "options": [{"text": "5", "added": false}, {"text": "1", "added": false}, {"text": "2", "added": false}, {"text": "3", "added": false}], "options_source": "real", "image_only": false, "topic": "Trigonometry", "sub": "identities", "key_answer": "d"}, {"n": 25, "text": "Choose the correct meaning of idiom: Throw one's hat into the ring", "options": [{"text": "To withdraw from a competitive undertaking", "added": false}, {"text": "To make a reckless financial wager", "added": false}, {"text": "To express disapproval of an ongoing contest", "added": false}, {"text": "Announce one's candidacy or challenge", "added": false}], "options_source": "real", "image_only": false, "topic": "Number System", "sub": "remainder", "key_answer": "d"}]}