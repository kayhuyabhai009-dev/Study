{"paper": "SSC-DelhiPoliceHC-13-Oct-2022-Shift3.pdf", "status": "ok", "mode": "sequential", "splitter": "qdot", "section_slice": true, "extracted_count": 20, "tagged_count": 20, "questions": [{"n": 1, "text": "", "options": [{"text": "18", "added": false}, {"text": "12", "added": false}, {"text": "16", "added": false}, {"text": "14", "added": false}], "options_source": "real", "image_only": true, "topic": "HCF-LCM", "sub": "hcf-lcm-of-numbers", "key_answer": null}, {"n": 2, "text": "If A (12, 21), B (3, p) and C (9, 0) are the vertices of a right-angled triangle with AC hypotenuse, then p = _________.", "options": [{"text": "6", "added": false}, {"text": "5", "added": false}, {"text": "3", "added": false}, {"text": "4", "added": false}], "options_source": "real", "image_only": false, "topic": "Coordinate Geometry", "sub": "slope-and-line", "key_answer": null}, {"n": 3, "text": "", "options": [{"text": "Sarita", "added": false}, {"text": "Kamal", "added": false}, {"text": "Divya", "added": false}, {"text": "Deepak", "added": false}], "options_source": "real", "image_only": true, "topic": "Data Interpretation", "sub": "table", "key_answer": null}, {"n": 4, "text": "A dealer sells sugar at 20% profit and uses weight 10% less than the actual measure. His gain percentage is:", "options": [], "options_source": "missing", "image_only": false, "topic": "Profit-Loss", "sub": "dishonest-dealer", "key_answer": null}, {"n": 5, "text": "A sum of Rs.18,000 is lent at a compound interest of 18% compounded half-yearly. If the loan is repaid after 18 months and rounded to the nearest ten rupees, the interest paid is equal to _________.", "options": [{"text": "Rs.5,120", "added": false}, {"text": "Rs.5,230", "added": false}, {"text": "Rs.5,310", "added": false}, {"text": "Rs.5,050", "added": false}], "options_source": "real", "image_only": false, "topic": "Compound Interest", "sub": "compounding-frequency", "key_answer": null}, {"n": 6, "text": "", "options": [{"text": "25", "added": false}, {"text": "2", "added": false}, {"text": "4", "added": false}, {"text": "5", "added": false}], "options_source": "real", "image_only": true, "topic": "Algebra", "sub": "identities", "key_answer": null}, {"n": 7, "text": "Simplify. 20 × [24 ÷ 105 × {75 × 119 ÷ (15 × 17) }]", "options": [{"text": "160", "added": false}, {"text": "158", "added": false}, {"text": "162", "added": false}, {"text": "155", "added": false}], "options_source": "real", "image_only": false, "topic": "Simplification", "sub": "bodmas", "key_answer": null}, {"n": 8, "text": "If in a family, the consumption of wheat is 60 kg for 24 days, then the consumption of wheat in 18 days is:", "options": [{"text": "54 kg", "added": false}, {"text": "27 kg", "added": false}, {"text": "45 kg", "added": false}, {"text": "72 kg", "added": false}], "options_source": "real", "image_only": false, "topic": "Ratio-Proportion", "sub": "direct-inverse-variation", "key_answer": null}, {"n": 9, "text": "A container has 20% milk and 80% water in it. It is mixed with another sample (in equal quantity) having 80% milk and 20% water. What would be the milk content in the final mixture?", "options": [{"text": "50%", "added": false}, {"text": "100%", "added": false}, {"text": "60%", "added": false}, {"text": "80%", "added": false}], "options_source": "real", "image_only": false, "topic": "Mixture-Alligation", "sub": "milk-water-and-alloys", "key_answer": null}, {"n": 10, "text": "Applied to a bill for Rs.2,00,000, the difference between a discount of 46% and two successive discounts of 35% and 8% is:", "options": [{"text": "Rs.11,800", "added": false}, {"text": "Rs.11,500", "added": false}, {"text": "Rs.11,700", "added": false}, {"text": "Rs.11,600", "added": false}], "options_source": "real", "image_only": false, "topic": "Discount", "sub": "successive-discounts", "key_answer": null}, {"n": 11, "text": "", "options": [{"text": "2", "added": false}, {"text": "3", "added": false}, {"text": "0.5", "added": false}, {"text": "1", "added": false}], "options_source": "real", "image_only": true, "topic": "Geometry", "sub": "congruence-and-similarity", "key_answer": null}, {"n": 12, "text": "In a 1547 m race, Arjun reaches in 78 seconds, while Karan reaches the finish point in 91 seconds. By how much distance does Arjun beat Karan?", "options": [{"text": "221 m", "added": false}, {"text": "231 m", "added": false}, {"text": "245 m", "added": false}, {"text": "220 m", "added": false}], "options_source": "real", "image_only": false, "topic": "Time-Speed-Distance", "sub": "basic-tsd", "key_answer": null}, {"n": 13, "text": "The sales of an automobile company increased by 20% in 2020 as compared to the year 2019. However in 2021, it fell by 20% as compared to the previous year. How many units did the company sell in 2021, if it sold 6000 units in the year 2019?", "options": [{"text": "6000", "added": false}, {"text": "5600", "added": false}, {"text": "5760", "added": false}, {"text": "5860", "added": false}], "options_source": "real", "image_only": false, "topic": "Percentage", "sub": "successive-change", "key_answer": null}, {"n": 14, "text": "", "options": [], "options_source": "missing", "image_only": true, "topic": "Trigonometry", "sub": "identities", "key_answer": null}, {"n": 15, "text": "A is twice as efficient as B and together they can finish a work in 16 days. In how many days can A alone do it?", "options": [{"text": "26", "added": false}, {"text": "25", "added": false}, {"text": "28", "added": false}, {"text": "24", "added": false}], "options_source": "real", "image_only": false, "topic": "Time-Work", "sub": "efficiency", "key_answer": null}, {"n": 16, "text": "Rs.1,800 is invested for a certain number of years at 6% simple interest per annum. The interest payable on maturity is Rs.756. Find the time period for which the sum is invested.", "options": [{"text": "6 years", "added": false}, {"text": "5 years", "added": false}, {"text": "8 years", "added": false}, {"text": "7 years", "added": false}], "options_source": "real", "image_only": false, "topic": "Simple Interest", "sub": "rate-time-principal", "key_answer": null}, {"n": 17, "text": "", "options": [{"text": "0.257", "added": false}, {"text": "2.257", "added": false}, {"text": "1.537", "added": false}, {"text": "1.789", "added": false}], "options_source": "real", "image_only": true, "topic": "Number System", "sub": "fractions-decimals", "key_answer": null}, {"n": 18, "text": "What is the difference between the total surface area and the curved surface area of a cylinder whose radius is 5 cm and height is 7 cm? (Take π = 3.14)", "options": [{"text": "159.2 cm2", "added": false}, {"text": "155.7 cm2", "added": false}, {"text": "159.3 cm2", "added": false}, {"text": "157 cm2", "added": false}], "options_source": "real", "image_only": false, "topic": "Mensuration 3D", "sub": "cylinder", "key_answer": null}, {"n": 19, "text": "The unequal side of an isosceles triangle is 16 cm and the perimeter is 50 cm. What is the area (in cm2) of the triangle?", "options": [{"text": "200", "added": false}, {"text": "136", "added": false}, {"text": "240", "added": false}, {"text": "120", "added": false}], "options_source": "real", "image_only": false, "topic": "Mensuration 2D", "sub": "triangle-and-quadrilaterals", "key_answer": null}, {"n": 20, "text": "Fifteen men take 10 days to complete a house, working 12 hours a day. How many hours a day should ten men work, to complete the job in 20 days?", "options": [{"text": "9.5", "added": false}, {"text": "8", "added": false}, {"text": "6", "added": false}, {"text": "9", "added": false}], "options_source": "real", "image_only": false, "topic": "Time-Work", "sub": "group-work", "key_answer": null}]}