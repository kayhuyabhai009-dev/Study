{"paper": "SSC-DelhiPoliceHC-27-Oct-2022-Shift3.pdf", "status": "ok", "mode": "sequential-count-mismatch", "splitter": "qdot", "section_slice": true, "extracted_count": 25, "tagged_count": 24, "questions": [{"n": 1, "text": "", "options": [{"text": "43 : 40", "added": false}, {"text": "40 : 43", "added": false}, {"text": "23 : 20", "added": false}, {"text": "20 : 23", "added": false}], "options_source": "real", "image_only": true, "topic": "Data Interpretation", "sub": "bar-graph", "key_answer": null}, {"n": 2, "text": "", "options": [{"text": "8", "added": false}, {"text": "17", "added": false}, {"text": "10", "added": false}, {"text": "1", "added": false}], "options_source": "real", "image_only": true, "topic": "Simplification", "sub": "bodmas", "key_answer": null}, {"n": 3, "text": "", "options": [], "options_source": "missing", "image_only": true, "topic": "Sequences and Series", "sub": "geometric-progression", "key_answer": null}, {"n": 4, "text": "Rohan sells an umbrella to Bhima at a profit of 25%. Bhima sells the same to Sambhu at a profit of 20%.Sambhu sells it to Dharmendra at ₹5,400, thereby earning a profit of 20%. Find the cost price to Rohan.", "options": [{"text": "₹3,000", "added": false}, {"text": "₹3,100", "added": false}, {"text": "₹3,500", "added": false}, {"text": "₹3,600", "added": false}], "options_source": "real", "image_only": false, "topic": "Profit-Loss", "sub": "successive-transactions", "key_answer": null}, {"n": 5, "text": "", "options": [], "options_source": "missing", "image_only": true, "topic": "Number System", "sub": "fractions-decimals", "key_answer": null}, {"n": 6, "text": "", "options": [], "options_source": "missing", "image_only": true, "topic": "Trigonometry", "sub": "identities", "key_answer": null}, {"n": 7, "text": "The present population of a city is 17,500. The population decreases by 12% in the first year and increases by 8% in the second year. Find the population after 2 years.", "options": [{"text": "16,632", "added": false}, {"text": "28,500", "added": false}, {"text": "15,350", "added": false}, {"text": "21,320", "added": false}], "options_source": "real", "image_only": false, "topic": "Percentage", "sub": "population-and-depreciation", "key_answer": null}, {"n": 8, "text": "Find the ratio between the fourth proportional of 8, 9, 15 and the fourth proportional of 12, 18, 20.", "options": [{"text": "9 : 16", "added": false}, {"text": "3 : 4", "added": false}, {"text": "4 : 3", "added": false}, {"text": "5 : 7", "added": false}], "options_source": "real", "image_only": false, "topic": "Ratio-Proportion", "sub": "proportion", "key_answer": null}, {"n": 9, "text": "A can complete a work in 15 days, and B can complete the same work in 25 days. In how many days will A and B together complete this work?", "options": [], "options_source": "missing", "image_only": false, "topic": "Time-Work", "sub": "together-apart", "key_answer": null}, {"n": 10, "text": "", "options": [{"text": "82 cm", "added": false}, {"text": "60 cm", "added": false}, {"text": "72 cm", "added": false}, {"text": "90 cm", "added": false}], "options_source": "real", "image_only": true, "topic": "Circles-Polygons", "sub": "circle-theorems", "key_answer": null}, {"n": 11, "text": "", "options": [{"text": "60°", "added": false}, {"text": "50°", "added": false}, {"text": "30°", "added": false}, {"text": "80°", "added": false}], "options_source": "real", "image_only": true, "topic": "Circles-Polygons", "sub": "circle-theorems", "key_answer": null}, {"n": 12, "text": "", "options": [], "options_source": "missing", "image_only": true, "topic": "Permutation and Combination", "sub": "combinations", "key_answer": null}, {"n": 13, "text": "", "options": [], "options_source": "missing", "image_only": true, "topic": "Mensuration 3D", "sub": "cylinder", "key_answer": null}, {"n": 14, "text": "The capacity of a cylindrical tank is 495 litres. If the height is 7 metres, what is the diameter of the base?", "options": [{"text": "30 cm", "added": false}, {"text": "40 cm", "added": false}, {"text": "35 cm", "added": false}, {"text": "33 cm", "added": false}], "options_source": "real", "image_only": false, "topic": "Simple Interest", "sub": "rate-time-principal", "key_answer": null}, {"n": 15, "text": "A sum of money invested at simple interest in a bank amounts to Rs.944 in a period of 3 years, while it amounts to Rs.1,136 in a period of 7 years. What is the rate of interest?", "options": [{"text": "7%", "added": false}, {"text": "6%", "added": false}, {"text": "8%", "added": false}, {"text": "9%", "added": false}], "options_source": "real", "image_only": false, "topic": "Algebra", "sub": "identities", "key_answer": null}, {"n": 16, "text": "", "options": [{"text": "4.00", "added": false}, {"text": "2.00", "added": false}, {"text": "3.00", "added": false}, {"text": "5.00", "added": false}], "options_source": "real", "image_only": true, "topic": "Ratio-Proportion", "sub": "ratio-basics", "key_answer": null}, {"n": 17, "text": "In an office, 76% of the number of females is equal to the one-third of the number of males. What is the ratio of number of males to that of the females in the office?", "options": [{"text": "57 : 25", "added": false}, {"text": "25 : 57", "added": false}, {"text": "43 : 19", "added": false}, {"text": "19 : 43", "added": false}], "options_source": "real", "image_only": false, "topic": "Algebra", "sub": "expression-values", "key_answer": null}, {"n": 18, "text": "", "options": [], "options_source": "missing", "image_only": true, "topic": "Trains", "sub": "train-vs-platform", "key_answer": null}, {"n": 19, "text": "A 300-m-long train is running at a speed of 108 km/h. How long will it take to clear a 600-m-long platform?", "options": [{"text": "20 sec", "added": false}, {"text": "18 sec", "added": false}, {"text": "10 sec", "added": false}, {"text": "30 sec", "added": false}], "options_source": "real", "image_only": false, "topic": "Mixture-Alligation", "sub": "mixture-price", "key_answer": null}, {"n": 20, "text": "10 litres of petrol costing ₹105/litre is mixed with 15 litres of kerosene costing ₹25/litre. Find the price of the mixture.", "options": [{"text": "₹57/litre", "added": false}, {"text": "₹43/litre", "added": false}, {"text": "₹55/litre", "added": false}, {"text": "₹35/litre", "added": false}], "options_source": "real", "image_only": false, "topic": "Time-Work", "sub": "together-apart", "key_answer": null}, {"n": 21, "text": "P and Q can complete a work in 20 days and 30 days, respectively. P started the work and Q joined him after 5 days. In how many days will the entire work be completed?", "options": [{"text": "13", "added": false}, {"text": "11", "added": false}, {"text": "14", "added": false}, {"text": "9", "added": false}], "options_source": "real", "image_only": false, "topic": "Circles-Polygons", "sub": "circle-theorems", "key_answer": null}, {"n": 22, "text": "Two circles touch each other externally at P. AB is a direct common tangent to the two circles, A and B are the respective points of contact, and ∠PAB = 55°. The measure of ∠ABP is:", "options": [{"text": "55°", "added": false}, {"text": "110°", "added": false}, {"text": "35°", "added": false}, {"text": "75°", "added": false}], "options_source": "real", "image_only": false, "topic": "Mensuration 3D", "sub": "cone", "key_answer": null}, {"n": 23, "text": "A solid wooden toy is in the shape of a right circular cone mounted on a hemisphere. If the radius of the hemisphere is 5.6 cm and the total height of the toy is 11.6 cm, then what is the volume of the wooden toy (in cm3) (rounded off to the closest integral value)?", "options": [{"text": "461", "added": false}, {"text": "565", "added": false}, {"text": "368", "added": false}, {"text": "197", "added": false}], "options_source": "real", "image_only": false, "topic": "Discount", "sub": "successive-discounts", "key_answer": null}, {"n": 24, "text": "A sewing machine with a marked price of Rs.400 was being sold at a 10% discount for cash payment, and during the stock clearance, a further discount was offered such that the machine is sold at Rs.342. What was the second discount offered?", "options": [{"text": "8%", "added": false}, {"text": "5%", "added": false}, {"text": "2.5%", "added": false}, {"text": "7.5%", "added": false}], "options_source": "real", "image_only": false, "topic": "Circles-Polygons", "sub": "tangents-and-chords", "key_answer": null}]}