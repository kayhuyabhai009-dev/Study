{"paper": "RRB-JE-CBT1-18-Dec-2024-Shift3.pdf", "status": "ok", "mode": "answer-anchored", "splitter": "qdot", "section_slice": false, "extracted_count": 100, "tagged_count": 34, "questions": [{"n": 1, "text": "A man walks to a viewpoint and returns to the starting point by his car maintaining constant speed and thus takes a total time of 9 hours 15 minutes. He would have gained 2 hours by driving both ways. How long would it have taken for him to walk both ways with same walking speed?", "options": [{"text": "12 hours 30 minutes", "added": false}, {"text": "11 hours 15 minutes", "added": false}, {"text": "11 hours 45 minutes", "added": false}, {"text": "10 hours 15 minutes", "added": false}], "options_source": "real", "image_only": false, "topic": "Simplification", "sub": "bodmas", "key_answer": "5"}, {"n": 2, "text": "What is the term for the band of colours produced when light is dispersed?", "options": [{"text": "Absorption", "added": false}, {"text": "Refraction", "added": false}, {"text": "Spectrum", "added": false}, {"text": "Reflection", "added": false}], "options_source": "real", "image_only": false, "topic": "Percentage", "sub": "basic-percentage", "key_answer": "5"}, {"n": 3, "text": "The chemical name for 'Plaster of Paris' is:", "options": [{"text": "calcium sulphate dihydrate", "added": false}, {"text": "calcium chloride hexahydrate", "added": false}, {"text": "calcium sulphate hemihydrate", "added": false}, {"text": "calcium chloride semihydrate", "added": false}], "options_source": "real", "image_only": false, "topic": "Time-Speed-Distance", "sub": "basic-tsd", "key_answer": "11 hours 15 minutes"}, {"n": 4, "text": "", "options": [{"text": "58°", "added": false}, {"text": "60°", "added": false}, {"text": "120°", "added": false}, {"text": "116°", "added": false}], "options_source": "real", "image_only": true, "topic": "Circles-Polygons", "sub": "circle-theorems", "key_answer": "116°"}, {"n": 5, "text": "Which of the following letter-clusters should re