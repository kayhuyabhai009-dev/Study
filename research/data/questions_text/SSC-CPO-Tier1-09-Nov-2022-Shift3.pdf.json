{"paper": "SSC-CPO-Tier1-09-Nov-2022-Shift3.pdf", "status": "ok", "mode": "sequential", "splitter": "qdot", "section_slice": true, "extracted_count": 50, "tagged_count": 50, "questions": [{"n": 1, "text": "The HCF of two numbers 960 and 1020 is:", "options": [{"text": "40", "added": false}, {"text": "120", "added": false}, {"text": "60", "added": false}, {"text": "80", "added": false}], "options_source": "real", "image_only": false, "topic": "HCF-LCM", "sub": "hcf-lcm-of-numbers", "key_answer": null}, {"n": 2, "text": "", "options": [{"text": "23", "added": false}, {"text": "1", "added": false}, {"text": "27", "added": false}, {"text": "0", "added": false}], "options_source": "real", "image_only": true, "topic": "Trigonometry", "sub": "identities", "key_answer": null}, {"n": 3, "text": "The population of a town is 1,25,000. If the annual birth rate is 12.7% and the annual death rate is 2.7%, how much will the population increase after 3 years?", "options": [{"text": "43,285", "added": false}, {"text": "41,375", "added": false}, {"text": "42,565", "added": false}, {"text": "40,275", "added": false}], "options_source": "real", "image_only": false, "topic": "Percentage", "sub": "population-and-depreciation", "key_answer": null}, {"n": 4, "text": "The perimeter of a rectangle is equal to the perimeter of a square. If the length and the breadth of the rectangle are 10 cm and 8 cm, respectively, then what will be the area of the square?", "options": [{"text": "72 cm2", "added": false}, {"text": "98 cm2", "added": false}, {"text": "81 cm2", "added": false}, {"text": "64 cm2", "added": false}], "options_source": "real", "image_only": false, "topic": "Mensuration 2D", "sub": "triangle-and-quadrilaterals", "key_answer": null}, {"n": 5, "text": "Two angles of a triangle are equal and the third angle measures 70°. What is the measure of each of the unknown angles?", "options": [{"text": "75°", "added": false}, {"text": "45°", "added": false}, {"text": "65°", "added": false}, {"text": "55°", "added": false}], "options_source": "real", "image_only": false, "topic": "Geometry", "sub": "lines-and-angles", "key_answer": null}, {"n": 6, "text": "The salaries of A,B and C are in ratio 2 : 3 : 4. If increments of 30%, 20% and 10% are allowed, respectively, in their salaries, then what will be the new ratio of their salaries?", "options": [{"text": "22 : 11 : 18", "added": false}, {"text": "18 : 13 : 22", "added": false}, {"text": "13 : 18 : 22", "added": false}, {"text": "22 : 18 : 13", "added": false}], "options_source": "real", "image_only": false, "topic": "Ratio-Proportion", "sub": "ratio-basics", "key_answer": null}, {"n": 7, "text": "A computer marked at Rs.18,000 was sold at Rs.15,840. The percentage of discount is:", "options": [{"text": "13.6%", "added": false}, {"text": "21.60%", "added": false}, {"text": "12%", "added": false}, {"text": "21%", "added": false}], "options_source": "real", "image_only": false, "topic": "Discount", "sub": "single-discount", "key_answer": null}, {"n": 8, "text": "", "options": [{"text": "88.85%", "added": false}, {"text": "85.25%", "added": false}, {"text": "105.88%", "added": false}, {"text": "102.35%", "added": false}], "options_source": "real", "image_only": true, "topic": "Data Interpretation", "sub": "bar-graph", "key_answer": null}, {"n": 9, "text": "", "options": [], "options_source": "missing", "image_only": true, "topic": "HCF-LCM", "sub": "remainder-based", "key_answer": null}, {"n": 10, "text": "There are six baskets — Green, Red, Blue, Yellow, Black and White. Each basket has some rings in it. The average number of rings in all the six baskets is 38. If the blue basket is removed, the average number of rings in the remaining baskets is 34. How many rings are there in the blue basket?", "options": [{"text": "22", "added": false}, {"text": "45", "added": false}, {"text": "37", "added": false}, {"text": "58", "added": false}], "options_source": "real", "image_only": false, "topic": "Average", "sub": "simple-average", "key_answer": null}, {"n": 11, "text": "", "options": [{"text": "10 : 3", "added": false}, {"text": "1 : 1", "added": false}, {"text": "20 : 3", "added": false}, {"text": "5 : 1", "added": false}], "options_source": "real", "image_only": true, "topic": "Data Interpretation", "sub": "pie-chart", "key_answer": null}, {"n": 12, "text": "", "options": [], "options_source": "missing", "image_only": true, "topic": "Algebra", "sub": "identities", "key_answer": null}, {"n": 13, "text": "", "options": [{"text": "4025", "added": false}, {"text": "4500", "added": false}, {"text": "5000", "added": false}, {"text": "4000", "added": false}], "options_source": "real", "image_only": true, "topic": "Data Interpretation", "sub": "pie-chart", "key_answer": null}, {"n": 14, "text": "", "options": [{"text": "4160", "added": false}, {"text": "3470", "added": false}, {"text": "2080", "added": false}, {"text": "2770", "added": false}], "options_source": "real", "image_only": true, "topic": "Mensuration 3D", "sub": "sphere-hemisphere", "key_answer": null}, {"n": 15, "text": "In an election between two candidates, 65% of the voters cast their votes, out of which 3% of the votes were decided to be invalid. A candidate got 81965 votes which are 65% of the total valid votes. What is the total number of votes enrolled in that election?", "options": [{"text": "200000", "added": false}, {"text": "190000", "added": false}, {"text": "215000", "added": false}, {"text": "185000", "added": false}], "options_source": "real", "image_only": false, "topic": "Percentage", "sub": "basic-percentage", "key_answer": null}, {"n": 16, "text": "Amit & Sumit start walking from same point in opposite directions at the speed of 6 km/h and 4 km/h, respectively. How far will they be from each other after 4 hours?", "options": [{"text": "500 m", "added": false}, {"text": "35 km", "added": false}, {"text": "40 km", "added": false}, {"text": "300 m", "added": false}], "options_source": "real", "image_only": false, "topic": "Time-Speed-Distance", "sub": "relative-speed", "key_answer": null}, {"n": 17, "text": "A man goes from place A to B at a speed of 12 km/h and returns from B to A at a speed of 18 km/h. His average speed for the entire journey is:", "options": [], "options_source": "missing", "image_only": false, "topic": "Time-Speed-Distance", "sub": "average-speed", "key_answer": null}, {"n": 18, "text": "", "options": [{"text": "70.6 Percent", "added": false}, {"text": "74.6 Percent", "added": false}, {"text": "73.2 Percent", "added": false}, {"text": "73.6 Percent", "added": false}], "options_source": "real", "image_only": true, "topic": "Data Interpretation", "sub": "table", "key_answer": null}, {"n": 19, "text": "", "options": [{"text": "525", "added": false}, {"text": "550", "added": false}, {"text": "650", "added": false}, {"text": "625", "added": false}], "options_source": "real", "image_only": true, "topic": "Data Interpretation", "sub": "bar-graph", "key_answer": null}, {"n": 20, "text": "A wrist watch is sold for ₹1,200 at a profit per cent equal to its cost price. Find the cost price of the wrist watch.", "options": [], "options_source": "missing", "image_only": false, "topic": "Profit-Loss", "sub": "basic-cp-sp", "key_answer": null}, {"n": 21, "text": "A can do a piece of work in 10 days. B can do it in 15 days. With the assistance of C they completed the work in 5 days. Find in how many days C alone can do it?", "options": [{"text": "20", "added": false}, {"text": "25", "added": false}, {"text": "30", "added": false}, {"text": "35", "added": false}], "options_source": "real", "image_only": false, "topic": "Time-Work", "sub": "together-apart", "key_answer": null}, {"n": 22, "text": "After deducting 20% from a certain sum, and then 10% from the remainder, there is Rs. 7,200 left. Find the original sum.", "options": [{"text": "Rs. 9,000", "added": false}, {"text": "Rs. 10,000", "added": false}, {"text": "Rs. 7,500", "added": false}, {"text": "Rs. 7,800", "added": false}], "options_source": "real", "image_only": false, "topic": "Percentage", "sub": "basic-percentage", "key_answer": null}, {"n": 23, "text": "", "options": [], "options_source": "missing", "image_only": true, "topic": "HCF-LCM", "sub": "hcf-lcm-of-numbers", "key_answer": null}, {"n": 24, "text": "", "options": [{"text": "m + n", "added": false}, {"text": "m − n", "added": false}, {"text": "2", "added": false}, {"text": "", "added": false}], "options_source": "real", "image_only": true, "topic": "Algebra", "sub": "identities", "key_answer": null}, {"n": 25, "text": "If x + y + z = 8, and x2 + y2 + z2 = 20 then the value of x3 + y3 + z3 -3xyz is _______.", "options": [{"text": "16", "added": false}, {"text": "10", "added": false}, {"text": "15", "added": false}, {"text": "−16", "added": false}], "options_source": "real", "image_only": false, "topic": "Algebra", "sub": "identities", "key_answer": null}, {"n": 26, "text": "Solve the following equation. 123 × (162 − 142 − 40) ÷ 2 − 94 = ________.", "options": [{"text": "17280", "added": false}, {"text": "6561", "added": false}, {"text": "10719", "added": false}, {"text": "9865", "added": false}], "options_source": "real", "image_only": false, "topic": "Algebra", "sub": "identities", "key_answer": null}, {"n": 27, "text": "", "options": [], "options_source": "missing", "image_only": true, "topic": "Data Interpretation", "sub": "bar-graph", "key_answer": null}, {"n": 28, "text": "", "options": [{"text": "24 cm", "added": false}, {"text": "18 cm", "added": false}, {"text": "16 cm", "added": false}, {"text": "12 cm", "added": false}], "options_source": "real", "image_only": true, "topic": "Circles-Polygons", "sub": "circle-theorems", "key_answer": null}, {"n": 29, "text": "", "options": [{"text": "129.5", "added": false}, {"text": "90.67", "added": false}, {"text": "70.75", "added": false}, {"text": "63.5", "added": false}], "options_source": "real", "image_only": true, "topic": "Data Interpretation", "sub": "table", "key_answer": null}, {"n": 30, "text": "", "options": [], "options_source": "missing", "image_only": true, "topic": "Trigonometry", "sub": "identities", "key_answer": null}, {"n": 31, "text": "", "options": [], "options_source": "missing", "image_only": true, "topic": "Number System", "sub": "divisibility-rules", "key_answer": null}, {"n": 32, "text": "", "options": [{"text": "15", "added": false}, {"text": "16", "added": false}, {"text": "12", "added": false}, {"text": "18", "added": false}], "options_source": "real", "image_only": true, "topic": "Circles-Polygons", "sub": "circle-theorems", "key_answer": null}, {"n": 33, "text": "Two trains A and B start running at 80km/h and 82 km/h towards each other from two different stations. They meet after 1 hour and 30 minutes. How far were they from each other when they started?", "options": [{"text": "190 km", "added": false}, {"text": "262 km", "added": false}, {"text": "243 km", "added": false}, {"text": "224 km", "added": false}], "options_source": "real", "image_only": false, "topic": "Trains", "sub": "two-trains", "key_answer": null}, {"n": 34, "text": "", "options": [{"text": "1 + cot A tan B", "added": false}, {"text": "1 + tan A cot B", "added": false}, {"text": "1 – sin A cos B", "added": false}, {"text": "1 − cot A tan B", "added": false}], "options_source": "real", "image_only": true, "topic": "Trigonometry", "sub": "identities", "key_answer": null}, {"n": 35, "text": "", "options": [{"text": "20", "added": false}, {"text": "160", "added": false}, {"text": "120", "added": false}, {"text": "800", "added": false}], "options_source": "real", "image_only": true, "topic": "Data Interpretation", "sub": "table", "key_answer": null}, {"n": 36, "text": "What is the total surface area of a solid right circular cylinder of radius 7 cm and height 8 cm? (π = 22/7)", "options": [], "options_source": "missing", "image_only": false, "topic": "Mensuration 3D", "sub": "cylinder", "key_answer": null}, {"n": 37, "text": "Simplify the following expression. 72 − 42 ÷ 6 of 7 × 4 of 3 ÷ 4 × 3 − 5", "options": [{"text": "32", "added": false}, {"text": "16", "added": false}, {"text": "58", "added": false}, {"text": "45", "added": false}], "options_source": "real", "image_only": false, "topic": "Algebra", "sub": "identities", "key_answer": null}, {"n": 38, "text": "A and B can complete a work in 10 days and 15 days, respectively. They got a total of Rs. 1,250 for that work. What will be B’s share?", "options": [{"text": "Rs. 400", "added": false}, {"text": "Rs. 500", "added": false}, {"text": "Rs. 600", "added": false}, {"text": "Rs. 200", "added": false}], "options_source": "real", "image_only": false, "topic": "Time-Work", "sub": "together-apart", "key_answer": null}, {"n": 39, "text": "", "options": [{"text": "56", "added": false}, {"text": "36", "added": false}, {"text": "65", "added": false}, {"text": "63", "added": false}], "options_source": "real", "image_only": true, "topic": "HCF-LCM", "sub": "hcf-lcm-of-numbers", "key_answer": null}, {"n": 40, "text": "The mean proportional between 0.04 and 0.36 is:", "options": [{"text": "0.144", "added": false}, {"text": "1.2", "added": false}, {"text": "12", "added": false}, {"text": "0.12", "added": false}], "options_source": "real", "image_only": false, "topic": "Ratio-Proportion", "sub": "proportion", "key_answer": null}, {"n": 41, "text": "The sides of a triangle are 8cm, 12cm and 16cm. What is the area of the triangle?", "options": [{"text": "24√15", "added": false}, {"text": "6√15", "added": false}, {"text": "8√15", "added": false}, {"text": "12√15", "added": false}], "options_source": "real", "image_only": false, "topic": "Mensuration 2D", "sub": "triangle-and-quadrilaterals", "key_answer": null}, {"n": 42, "text": "A boat can go 40 km downstream and 25 km upstream in 7 hours 30 minutes. It can go 48 km downstream and 36 km upstream in 10 hours. What is the speed (in km/h) of the boat in still water?", "options": [{"text": "6", "added": false}, {"text": "12", "added": false}, {"text": "9", "added": false}, {"text": "15", "added": false}], "options_source": "real", "image_only": false, "topic": "Boats-Streams", "sub": "still-water-and-stream-speed", "key_answer": null}, {"n": 43, "text": "Find the largest number which completely divides 24, 56 and 96.", "options": [{"text": "4", "added": false}, {"text": "1", "added": false}, {"text": "8", "added": false}, {"text": "2", "added": false}], "options_source": "real", "image_only": false, "topic": "Number System", "sub": "types-of-numbers", "key_answer": null}, {"n": 44, "text": "The total surface area of a solid metallic hemisphere is 462 cm2. This is melted and moulded into a right circular cone. If the radius of the base of the cone is the same as that of the hemisphere, then its height is: (use π=22/7)", "options": [{"text": "14 cm", "added": false}, {"text": "7 cm", "added": false}, {"text": "21 cm", "added": false}, {"text": "28 cm", "added": false}], "options_source": "real", "image_only": false, "topic": "Mensuration 3D", "sub": "cone", "key_answer": null}, {"n": 45, "text": "", "options": [{"text": "A, 2011", "added": false}, {"text": "B, 2014", "added": false}, {"text": "D, 2012", "added": false}, {"text": "D, 2014", "added": false}], "options_source": "real", "image_only": true, "topic": "Data Interpretation", "sub": "table", "key_answer": null}, {"n": 46, "text": "In a two-candidate election, 10% of the voters did not cast their ballots. 10% of the votes cast were found invalid. The winning candidate received 54% of the valid votes and a 1620-vote majority. Find the number of people on the voter list who have registered to vote.", "options": [{"text": "25000", "added": false}, {"text": "26000", "added": false}, {"text": "24500", "added": false}, {"text": "25500", "added": false}], "options_source": "real", "image_only": false, "topic": "Percentage", "sub": "basic-percentage", "key_answer": null}, {"n": 47, "text": "In a shop, a discount of 8% is provided. If the total payable after discount is more than ₹5,000 and additional discount of 20% is provided, then determine the final amount to be paid by customer, if he buys 12 products each of price ₹750.", "options": [], "options_source": "missing", "image_only": false, "topic": "Discount", "sub": "single-discount", "key_answer": null}, {"n": 48, "text": "", "options": [{"text": "17 Percent", "added": false}, {"text": "37 Percent", "added": false}, {"text": "47 Percent", "added": false}, {"text": "27 Percent", "added": false}], "options_source": "real", "image_only": true, "topic": "Profit-Loss", "sub": "profit-loss-percent", "key_answer": null}, {"n": 49, "text": "", "options": [{"text": "cos 45° – tan 45°", "added": false}, {"text": "tan 45° – sec 45°", "added": false}, {"text": "tan 45°", "added": false}, {"text": "sec 45° – tan 45°", "added": false}], "options_source": "real", "image_only": true, "topic": "Trigonometry", "sub": "identities", "key_answer": null}, {"n": 50, "text": "", "options": [{"text": "-5", "added": false}, {"text": "5", "added": false}, {"text": "0", "added": false}, {"text": "Both 5 and -5", "added": false}], "options_source": "real", "image_only": true, "topic": "Algebra", "sub": "polynomials-and-factorisation", "key_answer": null}]}