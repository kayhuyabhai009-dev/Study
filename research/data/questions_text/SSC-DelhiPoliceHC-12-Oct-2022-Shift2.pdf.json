{"paper": "SSC-DelhiPoliceHC-12-Oct-2022-Shift2.pdf", "status": "ok", "mode": "sequential", "splitter": "qdot", "section_slice": true, "extracted_count": 20, "tagged_count": 20, "questions": [{"n": 1, "text": "During a journey of 100 km, a driver drives the first 50 km at a speed of 50 km/h, the next 25 km at 50 km/h and the remaining 25 km at a speed of 25 km/h. Determine the average speed.", "options": [{"text": "50 km/h", "added": false}, {"text": "43 km/h", "added": false}, {"text": "40 km/h", "added": false}, {"text": "33.33 km/h", "added": false}], "options_source": "real", "image_only": false, "topic": "Time-Speed-Distance", "sub": "average-speed", "key_answer": null}, {"n": 2, "text": "If sin θ + cos θ = K and sec θ + cosec θ = m, find the value of m(K2 − 1).", "options": [{"text": "M", "added": false}, {"text": "2M", "added": false}, {"text": "K", "added": false}, {"text": "2K", "added": false}], "options_source": "real", "image_only": false, "topic": "Trigonometry", "sub": "identities", "key_answer": null}, {"n": 3, "text": "", "options": [{"text": "20 more", "added": false}, {"text": "25 less", "added": false}, {"text": "30 less", "added": false}, {"text": "15 more", "added": false}], "options_source": "real", "image_only": true, "topic": "Data Interpretation", "sub": "table", "key_answer": null}, {"n": 4, "text": "Find the least number which is exactly divisible by 42, 56, 62 and 70.", "options": [{"text": "27010", "added": false}, {"text": "26040", "added": false}, {"text": "26082", "added": false}, {"text": "26096", "added": false}], "options_source": "real", "image_only": false, "topic": "HCF-LCM", "sub": "hcf-lcm-of-numbers", "key_answer": null}, {"n": 5, "text": "", "options": [{"text": "3.8", "added": false}, {"text": "4", "added": false}, {"text": "2.9", "added": false}, {"text": "3.9", "added": false}], "options_source": "real", "image_only": true, "topic": "Simplification", "sub": "bodmas", "key_answer": null}, {"n": 6, "text": "At a workplace, one man alone can complete a work in 32 days. If the entire staff, i.e. 6 women and 4 men can complete the work in 6 days, how many days will one woman alone take to complete the entire work?", "options": [{"text": "244", "added": false}, {"text": "86", "added": false}, {"text": "154", "added": false}, {"text": "144", "added": false}], "options_source": "real", "image_only": false, "topic": "Time-Work", "sub": "group-work", "key_answer": null}, {"n": 7, "text": "What is the total surface area of a cone having a height of 12 cm and a slant height of 13 cm? (Take π = 3.14)", "options": [], "options_source": "missing", "image_only": false, "topic": "Mensuration 3D", "sub": "cone", "key_answer": null}, {"n": 8, "text": "A can complete a task in 24 days and B can complete the same task in 36 days. They start working together but A works only for 4 days. The remaining work is completed by B. If the contract to complete the work is for ₹4,800, then what is B's share (in ₹)?", "options": [{"text": "4,400", "added": false}, {"text": "2,400", "added": false}, {"text": "4,000", "added": false}, {"text": "3,600", "added": false}], "options_source": "real", "image_only": false, "topic": "Time-Work", "sub": "wages", "key_answer": null}, {"n": 9, "text": "The sum of the coefficients of x4 y2 and x2 y4 in the product of (-3xy2 + 1) and 7x3 - 5x2 y - 2y3 + 3xy2 + 2x - 5 is __________.", "options": [{"text": "30", "added": false}, {"text": "28", "added": false}, {"text": "-30", "added": false}, {"text": "-28", "added": false}], "options_source": "real", "image_only": false, "topic": "Algebra", "sub": "polynomials-and-factorisation", "key_answer": null}, {"n": 10, "text": "Shyamal takes a loan from Shubham for 2 years at the rate of 8% per annum on simple interest and after 2 years he gave back Rs.41,296 to Shubham and completed the payment of his loan. Find the interest paid by Shyamal.", "options": [{"text": "Rs.5,680", "added": false}, {"text": "Rs.5,696", "added": false}, {"text": "Rs.5,690", "added": false}, {"text": "Rs.5,699", "added": false}], "options_source": "real", "image_only": false, "topic": "Simple Interest", "sub": "si-formula", "key_answer": null}, {"n": 11, "text": "A man increases his speed to 11/6 times of his original speed. By doing this he reaches his office 20 minutes before the usual time. Find the time he usually takes.", "options": [{"text": "40 minutes", "added": false}, {"text": "44 minutes", "added": false}, {"text": "25 minutes", "added": false}, {"text": "42 minutes", "added": false}], "options_source": "real", "image_only": false, "topic": "Time-Speed-Distance", "sub": "early-late", "key_answer": null}, {"n": 12, "text": "The area of a sector of a circle of radius 18 cm is 54π cm2. Find the length of the corresponding arc of the sector.", "options": [{"text": "8π cm", "added": false}, {"text": "5π cm", "added": false}, {"text": "7π cm", "added": false}, {"text": "6π cm", "added": false}], "options_source": "real", "image_only": false, "topic": "Mensuration 2D", "sub": "circle-sector-ring", "key_answer": null}, {"n": 13, "text": "Which of the following is the smallest fraction?", "options": [], "options_source": "missing", "image_only": false, "topic": "Number System", "sub": "fractions-decimals", "key_answer": null}, {"n": 14, "text": "In an election contested by two candidates, one candidate got 26% of the total votes casted and lost by 2280 votes. Find the total number of votes casted.", "options": [{"text": "4780", "added": false}, {"text": "4250", "added": false}, {"text": "4750", "added": false}, {"text": "4080", "added": false}], "options_source": "real", "image_only": false, "topic": "Percentage", "sub": "basic-percentage", "key_answer": null}, {"n": 15, "text": "What will be the simple to compound interest (compounded annually) ratio on two identical funds put in a bank at an interest rate of 8% (per annum) for three years?", "options": [{"text": "3 : 4", "added": false}, {"text": "1875 : 2029", "added": false}, {"text": "3 : 5", "added": false}, {"text": "243 : 342", "added": false}], "options_source": "real", "image_only": false, "topic": "Mixed / Composite", "sub": "two-topic-composite", "key_answer": null}, {"n": 16, "text": "If the sum of all the prime numbers is ‘x’ and that of all the odd prime numbers is ‘y’, then what is the value of x - y?", "options": [{"text": "1", "added": false}, {"text": "0", "added": false}, {"text": "2", "added": false}, {"text": "∞", "added": false}], "options_source": "real", "image_only": false, "topic": "Number System", "sub": "types-of-numbers", "key_answer": null}, {"n": 17, "text": "", "options": [], "options_source": "missing", "image_only": true, "topic": "Algebra", "sub": "expression-values", "key_answer": null}, {"n": 18, "text": "", "options": [{"text": "578", "added": false}, {"text": "629", "added": false}, {"text": "721", "added": false}, {"text": "427", "added": false}], "options_source": "real", "image_only": true, "topic": "Mensuration 3D", "sub": "cone", "key_answer": null}, {"n": 19, "text": "Gita bought two dresses for ₹2,800 each. If she sells one at a profit of 10%, then at what profit percentage she should sell the other dress to make a profit of 15% on the whole?", "options": [{"text": "5%", "added": false}, {"text": "20%", "added": false}, {"text": "10%", "added": false}, {"text": "15%", "added": false}], "options_source": "real", "image_only": false, "topic": "Profit-Loss", "sub": "successive-transactions", "key_answer": null}, {"n": 20, "text": "Kalpana receives 25% discount on the purchase of an oven marked for Rs.3,600. She receives an additional 2% discount for paying cash. How much does she pay for the oven?", "options": [{"text": "Rs.2,708", "added": false}, {"text": "Rs.2,646", "added": false}, {"text": "Rs.2,520", "added": false}, {"text": "Rs.2,545", "added": false}], "options_source": "real", "image_only": false, "topic": "Discount", "sub": "successive-discounts", "key_answer": null}]}