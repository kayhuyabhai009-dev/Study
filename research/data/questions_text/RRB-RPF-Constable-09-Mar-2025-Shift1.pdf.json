ext": "26", "added": false}], "options_source": "real", "image_only": false, "topic": "Simplification", "sub": "bodmas", "key_answer": "27"}, {"n": 11, "text": "A bus travelling at 84 km/h completes a journey in 7 hours. At what speed will it have to cover the same distance in 14 hours?", "options": [{"text": "42 km/h", "added": false}, {"text": "44 km/h", "added": false}, {"text": "40 km/h", "added": false}, {"text": "45 km/h", "added": false}], "options_source": "real", "image_only": false, "topic": "Time-Speed-Distance", "sub": "basic-tsd", "key_answer": "42 km/h"}, {"n": 12, "text": "A 375 m long train crosses a man walking at a speed of 10.2 km/h in the opposite direction in 15 seconds. What is the speed (in km/h) of the train?", "options": [{"text": "77.3", "added": false}, {"text": "77.6", "added": false}, {"text": "76.2", "added": false}, {"text": "79.8", "added": false}], "options_source": "real", "image_only": false, "topic": "Trains", "sub": "train-vs-platform", "key_answer": "79.8"}, {"n": 13, "text": "If a pipe can fill a tank in 5 hours and another pipe can empty the tank in 8 hours, then what part of the tank will be filled by both pipes in 1 hour, if both pipes are open simultaneously?", "options": [], "options_source": "missing", "image_only": false, "topic": "Pipes-Cisterns", "sub": "fill-empty", "key_answer": null}, {"n": 14, "text": "Evaluate: 2 × {17 - 3 × (8 -6)}", "options": [{"text": "21", "added": false}, {"text": "19", "added": false}, {"text": "22", "added": false}, {"text": "26", "added": false}], "options_source": "real", "image_only": false, "topic": "Simplification", "sub": "bodmas", "key_answer": "22"}, {"n": 15, "text": "The sum of 8 numbers is 924. Find their average.", "options": [{"text": "114.5", "added": false}, {"text": "116.5", "added": false}, {"text": "113.5", "added": false}, {"text": "115.5", "added": false}], "options_source": "real", "image_only": false, "topic": "Average", "sub": "simple-average", "key_answer": "115.5"}