{"paper": "RRB-RPF-Constable-09-Mar-2025-Shift1.pdf", "status": "ok", "mode": "answer-anchored", "splitter": "qdot", "section_slice": false, "extracted_count": 120, "tagged_count": 33, "questions": [{"n": 1, "text": "The sum of five numbers is 655. The average of the first two numbers is 77 and the third number is 132. Find the average of the remaining two numbers?", "options": [{"text": "185.5", "added": false}, {"text": "184.5", "added": false}, {"text": "210", "added": false}, {"text": "209", "added": false}], "options_source": "real", "image_only": false, "topic": "Average", "sub": "series-average", "key_answer": "184.5"}, {"n": 2, "text": "There are 2664 students in a school and the ratio of boys to girls in the school is 41 : 31, then find the number of boys in school.", "options": [{"text": "1499", "added": false}, {"text": "1509", "added": false}, {"text": "1515", "added": false}, {"text": "1517", "added": false}], "options_source": "real", "image_only": false, "topic": "Ratio-Proportion", "sub": "ratio-basics", "key_answer": "1517"}, {"n": 3, "text": "", "options": [], "options_source": "missing", "image_only": true, "topic": "Simplification", "sub": "surds-and-indices", "key_answer": "1/32"}, {"n": 4, "text": "A number when increased by 40 %', gives 3290. The number is:", "options": [{"text": "4700", "added": false}, {"text": "7050", "added": false}, {"text": "1175", "added": false}, {"text": "2350", "added": false}], "options_source": "real", "image_only": false, "topic": "Percentage", "sub": "increase-decrease", "key_answer": "2350"}, {"n": 5, "text": "In what ratio should sugar costing ₹27 per kg be mixed with sugar costing ₹55 per kg so that by selling the mixture at ₹57.6 per kg, there is a profit of 44%?", "options": [{"text": "15 : 13", "added": false}, {"text": "14 : 16", "added": false}, {"text": "15 : 11", "added": false}, {"text": "15 : 17", "added": false}], "options_source": "real", "image_only": false, "topic": "Mixture-Alligation", "sub": "a