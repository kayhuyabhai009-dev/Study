{"paper": "RRB-RPF-Constable-10-Mar-2025-Shift2.pdf", "status": "ok", "mode": "answer-anchored", "splitter": "qdot", "section_slice": false, "extracted_count": 120, "tagged_count": 35, "questions": [{"n": 1, "text": "Find the value of 37 -14 ÷ 37 4 × 37 -12", "options": [{"text": "37 -30", "added": false}, {"text": "37 -20", "added": false}, {"text": "37 -38", "added": false}, {"text": "37 -24", "added": false}], "options_source": "real", "image_only": false, "topic": "Simplification", "sub": "bodmas", "key_answer": "37 -30"}, {"n": 2, "text": "In a race, an athlete covers a distance of 312 m in 156 sec in the first lap. He covers the second lap of the same length in 52 sec. What is the average speed (in m/sec) of the athlete?", "options": [{"text": "3", "added": false}, {"text": "2", "added": false}, {"text": "6", "added": false}, {"text": "12", "added": false}], "options_source": "real", "image_only": false, "topic": "Time-Speed-Distance", "sub": "basic-tsd", "key_answer": "3"}, {"n": 3, "text": "A man can row 12 km/hr in still water. When the river is running at 2.2 km/hr, it takes him 1.2 hours to row to a place and come back. How far is the place?", "options": [{"text": "6.758 kilometres", "added": false}, {"text": "6.958 kilometres", "added": false}, {"text": "6.858 kilometres", "added": false}, {"text": "6.658 kilometres", "added": false}], "options_source": "real", "image_only": false, "topic": "Time-Speed-Distance", "sub": "basic-tsd", "key_answer": "6.958 kilometres"}, {"n": 4, "text": "", "options": [], "options_source": "missing", "image_only": true, "topic": "Profit-Loss", "sub": "profit-loss-percent", "key_answer": "33 1/3% loss"}, {"n": 5, "text": "What is the value of p such that 579p46 is divisible by 11?", "options": [{"text": "8", "added": false}, {"text": "6", "added": false}, {"text": "9", "added": false}, {"text": "5", "added": false}], "options_source": "real", "image_only": false, "topic": "Number System", "sub": "divisibility-rules", "key_an