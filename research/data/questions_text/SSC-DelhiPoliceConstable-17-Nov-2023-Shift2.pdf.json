{"paper": "SSC-DelhiPoliceConstable-17-Nov-2023-Shift2.pdf", "status": "ok", "mode": "sequential", "splitter": "qdot", "section_slice": true, "extracted_count": 15, "tagged_count": 15, "questions": [{"n": 1, "text": "The ratio of the age of a father to that of his son is 7 : 4. If the product of their ages (in years) is 1008, then what is the ratio of the age of the father to that of the son after 10 years?", "options": [{"text": "26 : 17", "added": false}, {"text": "17 : 13", "added": false}, {"text": "11 : 13", "added": false}, {"text": "23 : 21", "added": false}], "options_source": "real", "image_only": false, "topic": "Ages", "sub": "ratio-of-ages", "key_answer": null}, {"n": 2, "text": "", "options": [], "options_source": "missing", "image_only": true, "topic": "Number System", "sub": "fractions-decimals", "key_answer": null}, {"n": 3, "text": "If the simple interest for 8 years is equal to 40% of the principal, then after how many years will it be equal to the principal?", "options": [{"text": "20", "added": false}, {"text": "15", "added": false}, {"text": "18", "added": false}, {"text": "25", "added": false}], "options_source": "real", "image_only": false, "topic": "Simple Interest", "sub": "si-formula", "key_answer": null}, {"n": 4, "text": "The average of four numbers is 20, and one of these four numbers is 26. What is the average of the remaining three numbers?", "options": [{"text": "18", "added": false}, {"text": "16", "added": false}, {"text": "19", "added": false}, {"text": "17", "added": false}], "options_source": "real", "image_only": false, "topic": "Average", "sub": "simple-average", "key_answer": null}, {"n": 5, "text": "A temple top is a hollow hemispherical dome with an inner radius of 2 units and an outer radius of 3 units. How much concrete (in cubic units) is used to make the top of the temple?", "options": [], "options_source": "missing", "image_only": false, "topic": "Mensuration 3D", "sub": "sphere-hemisphere", "key_answer": null}, {"n": 6, "text": "After successive discounts of 15% and 20%, an article was sold for ₹680. What is the marked price of the article?", "options": [{"text": "₹3,000", "added": false}, {"text": "₹1,000", "added": false}, {"text": "₹2,000", "added": false}, {"text": "₹1,500", "added": false}], "options_source": "real", "image_only": false, "topic": "Discount", "sub": "successive-discounts", "key_answer": null}, {"n": 7, "text": "A camp has provisions for 60 pupils for 18 days. In how many days will the same provisions finish off if the strength of the camp is increased to 72 pupils?", "options": [{"text": "18 days", "added": false}, {"text": "15 days", "added": false}, {"text": "12 days", "added": false}, {"text": "8 days", "added": false}], "options_source": "real", "image_only": false, "topic": "Time-Work", "sub": "group-work", "key_answer": null}, {"n": 8, "text": "The compound interest on a certain sum of money at 8% per annum for 3 years is ₹4,058. Find the simple interest on the same sum for 4 years at 10% p.a.", "options": [{"text": "₹6,520", "added": false}, {"text": "₹6,052", "added": false}, {"text": "₹6,250", "added": false}, {"text": "₹6,025", "added": false}], "options_source": "real", "image_only": false, "topic": "Mixed / Composite", "sub": "two-topic-composite", "key_answer": null}, {"n": 9, "text": "The selling price of an item is 15% more than the cost price and shopkeeper is able to earn ₹25. What is the selling price of the item?", "options": [{"text": "₹166.67", "added": false}, {"text": "₹177.67", "added": false}, {"text": "₹191.67", "added": false}, {"text": "₹181.67", "added": false}], "options_source": "real", "image_only": false, "topic": "Profit-Loss", "sub": "basic-cp-sp", "key_answer": null}, {"n": 10, "text": "", "options": [], "options_source": "missing", "image_only": true, "topic": "HCF-LCM", "sub": "hcf-lcm-of-fractions", "key_answer": null}, {"n": 11, "text": "", "options": [], "options_source": "missing", "image_only": true, "topic": "Mensuration 3D", "sub": "conversion-and-melting", "key_answer": null}, {"n": 12, "text": "What will be the HCF of (2×2×3×3×5×7×7×11), (2×3×3×5×11), (2×3×3×5×7×11×11), (2×3×3×5×5×11), (2×3×5×7×7)?", "options": [{"text": "66", "added": false}, {"text": "42", "added": false}, {"text": "30", "added": false}, {"text": "105", "added": false}], "options_source": "real", "image_only": false, "topic": "HCF-LCM", "sub": "hcf-lcm-of-numbers", "key_answer": null}, {"n": 13, "text": "It takes eight hours for a 600 km journey, if 120 km is done by train and the rest by car. It takes 20 minutes more, if 200 km is done by train and the rest by car. The ratio of the speed of the train to that of the cars is", "options": [{"text": "2 : 3", "added": false}, {"text": "1 : 3", "added": false}, {"text": "3 : 4", "added": false}, {"text": "1 : 2", "added": false}], "options_source": "real", "image_only": false, "topic": "Time-Speed-Distance", "sub": "basic-tsd", "key_answer": null}, {"n": 14, "text": "Kiran sells an object to Varun at a profit of 10%. Varun sells that object to Arun for ₹1,155 and makes a profit of 5%. At what cost did Kiran purchase the object?", "options": [{"text": "₹1,000", "added": false}, {"text": "₹1,500", "added": false}, {"text": "₹2,500", "added": false}, {"text": "₹2,000", "added": false}], "options_source": "real", "image_only": false, "topic": "Profit-Loss", "sub": "successive-transactions", "key_answer": null}, {"n": 15, "text": "The price of a commodity increased by 22%. By what percentage (correct to two decimal places) should its consumption be reduced so that the total expenditure remains the same?", "options": [{"text": "19.89%", "added": false}, {"text": "20.03%", "added": false}, {"text": "21.22%", "added": false}, {"text": "18.03%", "added": false}], "options_source": "real", "image_only": false, "topic": "Percentage", "sub": "increase-decrease", "key_answer": null}]}