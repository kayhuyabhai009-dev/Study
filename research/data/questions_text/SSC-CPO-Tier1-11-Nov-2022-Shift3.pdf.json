{"paper": "SSC-CPO-Tier1-11-Nov-2022-Shift3.pdf", "status": "ok", "mode": "sequential", "splitter": "qdot", "section_slice": true, "extracted_count": 50, "tagged_count": 50, "questions": [{"n": 1, "text": "A car starts at 3 p.m.at a speed of 50 km/h. Another car follows it at 4 p.m.at a speed of 75 km/h. At what time will the two cars will meet?", "options": [{"text": "6 p.m.", "added": false}, {"text": "5 p.m.", "added": false}, {"text": "7 p.m.", "added": false}, {"text": "8 p.m.", "added": false}], "options_source": "real", "image_only": false, "topic": "Time-Speed-Distance", "sub": "basic-tsd", "key_answer": null}, {"n": 2, "text": "The area of a trapezium shaped field is 1785 square feet. The distance between the two parallel sides is 35 feet and one of the parallel sides is 42 feet long. What is the length of the other parallel side?", "options": [{"text": "60 feet", "added": false}, {"text": "35 feet", "added": false}, {"text": "40 feet", "added": false}, {"text": "65 feet", "added": false}], "options_source": "real", "image_only": false, "topic": "Mensuration 2D", "sub": "triangle-and-quadrilaterals", "key_answer": null}, {"n": 3, "text": "The LCM and ratio of three numbers are 1386 and 3 : 7 : 11, respectively. The sum of the greatest and least numbers is:", "options": [{"text": "60", "added": false}, {"text": "64", "added": false}, {"text": "84", "added": false}, {"text": "108", "added": false}], "options_source": "real", "image_only": false, "topic": "HCF-LCM", "sub": "hcf-lcm-of-numbers", "key_answer": null}, {"n": 4, "text": "If 1 + sin2 θ – 3sinθ cosθ = 0, then the value of cotθ is:", "options": [], "options_source": "missing", "image_only": false, "topic": "Trigonometry", "sub": "ratios-and-tables", "key_answer": null}, {"n": 5, "text": "", "options": [], "options_source": "missing", "image_only": true, "topic": "Trigonometry", "sub": "identities", "key_answer": null}, {"n": 6, "text": "", "options": [{"text": "140", "added": false}, {"text": "150", "added": false}, {"text": "154", "added": false}, {"text": "156", "added": false}], "options_source": "real", "image_only": true, "topic": "Average", "sub": "simple-average", "key_answer": null}, {"n": 7, "text": "", "options": [], "options_source": "missing", "image_only": true, "topic": "Number System", "sub": "divisibility-rules", "key_answer": null}, {"n": 8, "text": "In a circle of radius 5 m, AB and CD are two equal and parallel chords of length 8 m each. What is the distance between the chords?", "options": [{"text": "5 m", "added": false}, {"text": "6 m", "added": false}, {"text": "3 m", "added": false}, {"text": "8 m", "added": false}], "options_source": "real", "image_only": false, "topic": "Circles-Polygons", "sub": "circle-theorems", "key_answer": null}, {"n": 9, "text": "Simplify the following expression. 25 ÷ 5 of 12 × 2 − 9 ÷ 27 of 3 × 5 − 14 ÷ 28 × 4", "options": [], "options_source": "missing", "image_only": false, "topic": "Algebra", "sub": "identities", "key_answer": null}, {"n": 10, "text": "In ∆ABC, 2∠A = 3∠B = 6∠C. What is the value of the largest angle among these three angles?", "options": [], "options_source": "missing", "image_only": false, "topic": "Simplification", "sub": "bodmas", "key_answer": null}, {"n": 11, "text": "The salary of an employee was first increased by 15% and thereafter it was reduced by 10%. What was the percentage change in his salary?", "options": [{"text": "10%", "added": false}, {"text": "103.5%", "added": false}, {"text": "3.5%", "added": false}, {"text": "15%", "added": false}], "options_source": "real", "image_only": false, "topic": "Percentage", "sub": "income-expenditure", "key_answer": null}, {"n": 12, "text": "If the hypotenuse of an isosceles right-angled triangle is 10 cm, then the other two sides (in cm) are __________.", "options": [{"text": "10√2 and 10√2", "added": false}, {"text": "8√2 and 8√2", "added": false}, {"text": "6√2 and 6√2", "added": false}, {"text": "5√2 and 5√2", "added": false}], "options_source": "real", "image_only": false, "topic": "Geometry", "sub": "triangles", "key_answer": null}, {"n": 13, "text": "", "options": [], "options_source": "missing", "image_only": true, "topic": "Data Interpretation", "sub": "table", "key_answer": null}, {"n": 14, "text": "", "options": [{"text": "2011", "added": false}, {"text": "2007", "added": false}, {"text": "2010", "added": false}, {"text": "2008", "added": false}], "options_source": "real", "image_only": true, "topic": "Data Interpretation", "sub": "table", "key_answer": null}, {"n": 15, "text": "", "options": [{"text": "3850 cm2", "added": false}, {"text": "3704 cm2", "added": false}, {"text": "3750 cm2", "added": false}, {"text": "3675 cm2", "added": false}], "options_source": "real", "image_only": true, "topic": "Mensuration 3D", "sub": "cone", "key_answer": null}, {"n": 16, "text": "", "options": [{"text": "20.4%", "added": false}, {"text": "30.2%", "added": false}, {"text": "28.8%", "added": false}, {"text": "14.6%", "added": false}], "options_source": "real", "image_only": true, "topic": "Discount", "sub": "mp-sp-relation", "key_answer": null}, {"n": 17, "text": "If the area of the base of a cone is 154 cm2 and the area of its curved surface is 550 cm2, then its volume is:", "options": [], "options_source": "missing", "image_only": false, "topic": "Mensuration 3D", "sub": "cone", "key_answer": null}, {"n": 18, "text": "Ankita can write a manuscript in 20 days. Ankita, along her friend Somya, can write the manuscript in 12 days. In how many days can Somya alone write the manuscript ?", "options": [{"text": "22", "added": false}, {"text": "32", "added": false}, {"text": "28", "added": false}, {"text": "30", "added": false}], "options_source": "real", "image_only": false, "topic": "Time-Work", "sub": "together-apart", "key_answer": null}, {"n": 19, "text": "", "options": [{"text": "1", "added": false}, {"text": "4", "added": false}, {"text": "3", "added": false}, {"text": "2", "added": false}], "options_source": "real", "image_only": true, "topic": "Trigonometry", "sub": "ratios-and-tables", "key_answer": null}, {"n": 20, "text": "In a test (+5) marks are given for every correct answer and (−2) marks are given for every incorrect answer. Jay answered all the questions and scored (−12) marks, though he got 4 correct answers. How many of his answers were INCORRECT?", "options": [{"text": "8", "added": false}, {"text": "32", "added": false}, {"text": "16", "added": false}, {"text": "20", "added": false}], "options_source": "real", "image_only": false, "topic": "Algebra", "sub": "linear-equations", "key_answer": null}, {"n": 21, "text": "A sum becomes Rs.7436 in two years when interest is compounded annually at the rate of 4% per annum. What was the sum?", "options": [{"text": "Rs.7,075", "added": false}, {"text": "Rs.6,275", "added": false}, {"text": "Rs.6,575", "added": false}, {"text": "Rs.6,875", "added": false}], "options_source": "real", "image_only": false, "topic": "Compound Interest", "sub": "ci-formula", "key_answer": null}, {"n": 22, "text": "", "options": [{"text": "65", "added": false}, {"text": "58", "added": false}, {"text": "47", "added": false}, {"text": "52", "added": false}], "options_source": "real", "image_only": true, "topic": "Data Interpretation", "sub": "table", "key_answer": null}, {"n": 23, "text": "During a journey of 120 km, Rahi drives first 60 km at the speed of 60 km/h, next 30 km at 60 km/h and the remaining 30 km at the speed of 30 km/h. Determine the average speed.", "options": [{"text": "48 km/h", "added": false}, {"text": "33.33 km/h", "added": false}, {"text": "50 km/h", "added": false}, {"text": "40 km/h", "added": false}], "options_source": "real", "image_only": false, "topic": "Time-Speed-Distance", "sub": "average-speed", "key_answer": null}, {"n": 24, "text": "Elizabeth went to a furniture store and purchased a study table. She received a 20% discount on it. She would have saved Rs.1,000 more if she had received a 25% discount. What was the marked price of the sofa?", "options": [{"text": "Rs.21,100", "added": false}, {"text": "Rs.20,000", "added": false}, {"text": "Rs.18,900", "added": false}, {"text": "Rs.19,200", "added": false}], "options_source": "real", "image_only": false, "topic": "Data Interpretation", "sub": "table", "key_answer": null}, {"n": 25, "text": "", "options": [], "options_source": "missing", "image_only": true, "topic": "Data Interpretation", "sub": "pie-chart", "key_answer": null}, {"n": 26, "text": "", "options": [{"text": "1324", "added": false}, {"text": "1764", "added": false}, {"text": "1864", "added": false}, {"text": "1944", "added": false}], "options_source": "real", "image_only": true, "topic": "Algebra", "sub": "expression-values", "key_answer": null}, {"n": 27, "text": "", "options": [{"text": "10", "added": false}, {"text": "8", "added": false}, {"text": "7", "added": false}, {"text": "9", "added": false}], "options_source": "real", "image_only": true, "topic": "Algebra", "sub": "expression-values", "key_answer": null}, {"n": 28, "text": "", "options": [], "options_source": "missing", "image_only": true, "topic": "Number System", "sub": "remainder", "key_answer": null}, {"n": 29, "text": "", "options": [], "options_source": "missing", "image_only": true, "topic": "Data Interpretation", "sub": "pie-chart", "key_answer": null}, {"n": 30, "text": "Reena, Veena and Vimla can do a work in 4 h, 8 h and 12 h respectively. In how much time will they finish the work working together?", "options": [], "options_source": "missing", "image_only": false, "topic": "Time-Work", "sub": "together-apart", "key_answer": null}, {"n": 31, "text": "The highest common factor of 120, 360 and 210 is :", "options": [{"text": "12", "added": false}, {"text": "30", "added": false}, {"text": "3", "added": false}, {"text": "15", "added": false}], "options_source": "real", "image_only": false, "topic": "HCF-LCM", "sub": "hcf-lcm-of-numbers", "key_answer": null}, {"n": 32, "text": "", "options": [{"text": "626", "added": false}, {"text": "529", "added": false}, {"text": "721", "added": false}, {"text": "579", "added": false}], "options_source": "real", "image_only": true, "topic": "Simplification", "sub": "bodmas", "key_answer": null}, {"n": 33, "text": "In an election between two candidates, 85% of the voters cast their votes, out which 4% of the votes were declared invalid. A candidate got 6936 votes which were 85% of the valid votes. Find the total number of voters enrolled in that election.", "options": [{"text": "10,500", "added": false}, {"text": "10,800", "added": false}, {"text": "10,000", "added": false}, {"text": "10,700", "added": false}], "options_source": "real", "image_only": false, "topic": "Percentage", "sub": "basic-percentage", "key_answer": null}, {"n": 34, "text": "In an election between two candidates, a candidate secured 60% of the valid votes and is elected by a majority of 180 votes. The total number of valid votes is:", "options": [{"text": "1200", "added": false}, {"text": "1000", "added": false}, {"text": "800", "added": false}, {"text": "900", "added": false}], "options_source": "real", "image_only": false, "topic": "Percentage", "sub": "basic-percentage", "key_answer": null}, {"n": 35, "text": "A train crosses two persons travelling at 4 km/h and 6 km/h in the same direction in 12 sec and 14 sec, respectively. The speed of the train is ________.", "options": [{"text": "18 km/h", "added": false}, {"text": "26 km/h", "added": false}, {"text": "20 km/h", "added": false}, {"text": "24 km/h", "added": false}], "options_source": "real", "image_only": false, "topic": "Trains", "sub": "two-trains", "key_answer": null}, {"n": 36, "text": "", "options": [{"text": "69 : 125", "added": false}, {"text": "69 : 124", "added": false}, {"text": "124 : 69", "added": false}, {"text": "31 : 69", "added": false}], "options_source": "real", "image_only": true, "topic": "Data Interpretation", "sub": "pie-chart", "key_answer": null}, {"n": 37, "text": "The total surface area of a hemisphere is 462 cm2.The diameter of this hemisphere is:", "options": [{"text": "28 cm", "added": false}, {"text": "21 cm", "added": false}, {"text": "7 cm", "added": false}, {"text": "14 cm", "added": false}], "options_source": "real", "image_only": false, "topic": "Mensuration 3D", "sub": "sphere-hemisphere", "key_answer": null}, {"n": 38, "text": "", "options": [{"text": "2545", "added": false}, {"text": "2450", "added": false}, {"text": "2540", "added": false}, {"text": "2455", "added": false}], "options_source": "real", "image_only": true, "topic": "Average", "sub": "simple-average", "key_answer": null}, {"n": 39, "text": "The mean proportion of 0.03 and 0.27 is:", "options": [{"text": "0.09", "added": false}, {"text": "0.06", "added": false}, {"text": "0.03", "added": false}, {"text": "0.15", "added": false}], "options_source": "real", "image_only": false, "topic": "Ratio-Proportion", "sub": "ratio-basics", "key_answer": null}, {"n": 40, "text": "", "options": [{"text": "112", "added": false}, {"text": "97", "added": false}, {"text": "100", "added": false}, {"text": "99", "added": false}], "options_source": "real", "image_only": true, "topic": "Data Interpretation", "sub": "table", "key_answer": null}, {"n": 41, "text": "A can run 250m in 25 sec and B in 30 sec. How many metres start can A give to B in a km race so that the race may end in a dead-heat?", "options": [{"text": "169.53 m", "added": false}, {"text": "173.82 m", "added": false}, {"text": "166.67 m", "added": false}, {"text": "186.34 m", "added": false}], "options_source": "real", "image_only": false, "topic": "Trigonometry", "sub": "ratios-and-tables", "key_answer": null}, {"n": 42, "text": "Swastik purchased a laptop for Rs.75,000 and sold it to Anju suffering a loss of 10%. Anju sold the same laptop after earning a profit of 20%. At what price (in Rs.) did Anju sell the laptop?", "options": [{"text": "Rs.78,500", "added": false}, {"text": "Rs.85,000", "added": false}, {"text": "Rs.81,000", "added": false}, {"text": "Rs.90,000", "added": false}], "options_source": "real", "image_only": false, "topic": "Profit-Loss", "sub": "profit-loss-percent", "key_answer": null}, {"n": 43, "text": "Let x = 224 and,y = 322. If the highest common factor of 23x and a×y is divisible by x and y, then what can be the possible value of a?", "options": [{"text": "16", "added": false}, {"text": "8", "added": false}, {"text": "12", "added": false}, {"text": "4", "added": false}], "options_source": "real", "image_only": false, "topic": "HCF-LCM", "sub": "hcf-lcm-of-numbers", "key_answer": null}, {"n": 44, "text": "After successive discounts of 10% and 5%, an article was sold for Rs.342. What was the original price of the article?", "options": [{"text": "Rs.400", "added": false}, {"text": "Rs.342", "added": false}, {"text": "Rs.300", "added": false}, {"text": "Rs.442", "added": false}], "options_source": "real", "image_only": false, "topic": "Discount", "sub": "successive-discounts", "key_answer": null}, {"n": 45, "text": "AB is a chord in a circle of radius 13 cm. From centre O, a perpendicular is drawn through AB intersecting AB at point C. The length of OC is 5 cm. What is the length of AB?", "options": [{"text": "24 cm", "added": false}, {"text": "12 cm", "added": false}, {"text": "20 cm", "added": false}, {"text": "15 cm", "added": false}], "options_source": "real", "image_only": false, "topic": "Circles-Polygons", "sub": "circle-theorems", "key_answer": null}, {"n": 46, "text": "", "options": [], "options_source": "missing", "image_only": true, "topic": "Algebra", "sub": "quadratic-equations", "key_answer": null}, {"n": 47, "text": "The ratio of first and second sum of money is 7:8. If the first sum is 35, the second sum is:", "options": [{"text": "56", "added": false}, {"text": "40", "added": false}, {"text": "45", "added": false}, {"text": "44", "added": false}], "options_source": "real", "image_only": false, "topic": "Ratio-Proportion", "sub": "ratio-basics", "key_answer": null}, {"n": 48, "text": "The difference between the semi-perimeter and the sides of ∆PQR are 18 cm, 17 cm and 25 cm, respectively. Find the area of the triangle.", "options": [], "options_source": "missing", "image_only": false, "topic": "Mensuration 2D", "sub": "triangle-and-quadrilaterals", "key_answer": null}, {"n": 49, "text": "The average score in an English exam of a class of 45 students in a coaching centre is 52. A group of 6 boys having an average score of 40 leave the class and another group of eight boys having an average score of 43 join the class. What is the new average score of the class?", "options": [{"text": "48", "added": false}, {"text": "53", "added": false}, {"text": "49.5", "added": false}, {"text": "52", "added": false}], "options_source": "real", "image_only": false, "topic": "Average", "sub": "simple-average", "key_answer": null}, {"n": 50, "text": "What are the values of ‘&’ and ‘#’, respectively, if the following number is perfectly divisible by 9? 51&918#0", "options": [{"text": "9 and 8", "added": false}, {"text": "2 and 2", "added": false}, {"text": "4 and 5", "added": false}, {"text": "8 and 4", "added": false}], "options_source": "real", "image_only": false, "topic": "Number System", "sub": "divisibility-rules", "key_answer": null}]}