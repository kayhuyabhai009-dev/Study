{"paper": "SSC-DelhiPoliceHC-20-Oct-2022-Shift2.pdf", "status": "ok", "mode": "sequential", "splitter": "qdot", "section_slice": true, "extracted_count": 20, "tagged_count": 20, "questions": [{"n": 1, "text": "A two-digit number, 9A, is a prime number. Find A.", "options": [{"text": "3", "added": false}, {"text": "1", "added": false}, {"text": "9", "added": false}, {"text": "7", "added": false}], "options_source": "real", "image_only": false, "topic": "Number System", "sub": "types-of-numbers", "key_answer": null}, {"n": 2, "text": "Two concentric circles of radii 10 cm and 8 cm are given, the length of the chord of the larger circle which touches the smaller circle is:", "options": [{"text": "10 cm", "added": false}, {"text": "8 cm", "added": false}, {"text": "14 cm", "added": false}, {"text": "12 cm", "added": false}], "options_source": "real", "image_only": false, "topic": "Circles-Polygons", "sub": "circle-theorems", "key_answer": null}, {"n": 3, "text": "Successive discounts of 12%, 15% and 18% amount to a single discount of x%. Find x.", "options": [{"text": "38.646", "added": false}, {"text": "36.684", "added": false}, {"text": "38.664", "added": false}, {"text": "36.864", "added": false}], "options_source": "real", "image_only": false, "topic": "Discount", "sub": "successive-discounts", "key_answer": null}, {"n": 4, "text": "P is four times as good a workman as Q, and therefore is able to finish a task in 36 days less than Q. Working together, both can finish the work in:", "options": [], "options_source": "missing", "image_only": false, "topic": "Time-Work", "sub": "efficiency", "key_answer": null}, {"n": 5, "text": "A person sold an item to B at 38% gain and B sold it to C at a loss of 28%. If C bought the item for ₹9,936, then at what price did A purchase it? @Qmaths", "options": [{"text": "₹15,000", "added": false}, {"text": "₹8,000", "added": false}, {"text": "₹10,000", "added": false}, {"text": "₹12,000", "added": false}], "options_source": "real", "image_only": false, "topic": "Profit-Loss", "sub": "successive-transactions", "key_answer": null}, {"n": 6, "text": "", "options": [{"text": "(x - 4)", "added": false}, {"text": "(x - 2)", "added": false}, {"text": "(x - 8)", "added": false}, {"text": "(x - 1)", "added": false}], "options_source": "real", "image_only": true, "topic": "Algebra", "sub": "polynomials-and-factorisation", "key_answer": null}, {"n": 7, "text": "The value of sin10° .sin50° .sin60° .sin70° is:", "options": [], "options_source": "missing", "image_only": false, "topic": "Trigonometry", "sub": "identities", "key_answer": null}, {"n": 8, "text": "Find the smallest 5-digit number which when divided by 15, 20 and 25 leaves remainders 7, 12 and 17, respectively.", "options": [{"text": "10192", "added": false}, {"text": "10194", "added": false}, {"text": "10195", "added": false}, {"text": "10193", "added": false}], "options_source": "real", "image_only": false, "topic": "HCF-LCM", "sub": "remainder-based", "key_answer": null}, {"n": 9, "text": "", "options": [{"text": "49", "added": false}, {"text": "55", "added": false}, {"text": "36", "added": false}, {"text": "47", "added": false}], "options_source": "real", "image_only": true, "topic": "Algebra", "sub": "expression-values", "key_answer": null}, {"n": 10, "text": "P’s salary is 30% of Q’s salary and Q’s salary is 20% of R’s salary. What percentage of R’s salary is P’s salary?", "options": [{"text": "5%", "added": false}, {"text": "6%", "added": false}, {"text": "8%", "added": false}, {"text": "10%", "added": false}], "options_source": "real", "image_only": false, "topic": "Percentage", "sub": "basic-percentage", "key_answer": null}, {"n": 11, "text": "Twenty men take 10 days to complete a job, working 8 hours a day. How many hours a day would 25 men take in 10 days to complete the job?", "options": [{"text": "6.8", "added": false}, {"text": "6.2", "added": false}, {"text": "6.4", "added": false}, {"text": "6.6", "added": false}], "options_source": "real", "image_only": false, "topic": "Time-Work", "sub": "group-work", "key_answer": null}, {"n": 12, "text": "A boat takes 20 hours to travel downstream from point P to point Q and to come back to a point R which is at midway between P and Q. If the velocity of the stream is 6 km/h and the speed of the boat in still water is 18 km/h, what is the distance between P and Q?", "options": [{"text": "280 km", "added": false}, {"text": "240 km", "added": false}, {"text": "320 km", "added": false}, {"text": "180 km", "added": false}], "options_source": "real", "image_only": false, "topic": "Boats-Streams", "sub": "round-trip", "key_answer": null}, {"n": 13, "text": "Three solid metallic cubes having sides 2 cm, 12 cm and 16 cm, respectively, are melted and recast into a single cube. What is the length of the side (in cm) of the cube so obtained?", "options": [{"text": "14", "added": false}, {"text": "20", "added": false}, {"text": "18", "added": false}, {"text": "17", "added": false}], "options_source": "real", "image_only": false, "topic": "Mensuration 3D", "sub": "conversion-and-melting", "key_answer": null}, {"n": 14, "text": "A solid cylinder of radius 20 units is melted so as to make solid cones with radius 4 units but same height as that of the cylinder. How many such cones can be made?", "options": [{"text": "75", "added": false}, {"text": "100", "added": false}, {"text": "150", "added": false}, {"text": "85", "added": false}], "options_source": "real", "image_only": false, "topic": "Mensuration 3D", "sub": "conversion-and-melting", "key_answer": null}, {"n": 15, "text": "A mobile phone is available for Rs.25,000 or Rs.5,200 down payment, followed by 4 equal monthly instalments. If the rate of interest is 25% p.a. simple interest, calculate the amount of each instalment.", "options": [{"text": "Rs.5,020", "added": false}, {"text": "Rs.5,200", "added": false}, {"text": "Rs.5,362", "added": false}, {"text": "Rs.4,950", "added": false}], "options_source": "real", "image_only": false, "topic": "Simple Interest", "sub": "si-instalments", "key_answer": null}, {"n": 16, "text": "In what ratio must 45% milk be mixed with that of 25% grape juice so as to get a mixture of 40% grape juice?", "options": [{"text": "2 : 3", "added": false}, {"text": "4 : 1", "added": false}, {"text": "4 : 3", "added": false}, {"text": "3 : 1", "added": false}], "options_source": "real", "image_only": false, "topic": "Mixture-Alligation", "sub": "alligation", "key_answer": null}, {"n": 17, "text": "", "options": [{"text": "15", "added": false}, {"text": "30", "added": false}, {"text": "25", "added": false}, {"text": "20", "added": false}], "options_source": "real", "image_only": true, "topic": "Algebra", "sub": "identities", "key_answer": null}, {"n": 18, "text": "What is the difference between compound interest and simple interest for 2 years on the sum of Rs.6,800 at 15% per annum?", "options": [{"text": "Rs.148", "added": false}, {"text": "Rs.153", "added": false}, {"text": "Rs.163", "added": false}, {"text": "Rs.155", "added": false}], "options_source": "real", "image_only": false, "topic": "Compound Interest", "sub": "si-ci-difference", "key_answer": null}, {"n": 19, "text": "", "options": [{"text": "B", "added": false}, {"text": "A", "added": false}, {"text": "D", "added": false}, {"text": "C", "added": false}], "options_source": "real", "image_only": true, "topic": "Data Interpretation", "sub": "table", "key_answer": null}, {"n": 20, "text": "Sanju and Manju had 20% and 30% rupees less than Anju, respectively. Find the ratio of the money with Sanju to that with Manju.", "options": [{"text": "2 ∶ 3", "added": false}, {"text": "7 ∶ 8", "added": false}, {"text": "8 ∶ 7", "added": false}, {"text": "3 ∶ 2", "added": false}], "options_source": "real", "image_only": false, "topic": "Ratio-Proportion", "sub": "ratio-basics", "key_answer": null}]}