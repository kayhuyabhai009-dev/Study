+#!/usr/bin/env python3
+"""Convert old PATTERN_DATABASE (34) -> js/data-patterns-legacy.js (32, minus 2 exact dupes).
+Hindi name+signal (hand-translated); bodies math-cleaned English reference."""
+import json, re, sys
