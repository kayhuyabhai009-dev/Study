+    .drill-question { font-size: 1.3rem; }
+    table.exam-table { font-size: .78rem; }
+    .exam-detail { padding: 1.1rem; }
+}
+@media (max-width: 480px) {
+    .dashboard-grid { grid-template-columns: 1fr 1fr; gap: .7rem; }
+    .stat-card { padding: .9rem; gap: .5rem; }
+    .stat-value { font-size: 1.15rem; }
+    .actions-grid { grid-template-columns: 1fr 1fr; }
+    .level-tab { padding: .6rem 1rem; font-size: .85rem; }
+    .quiz-hud { font-size: .8rem; gap: .7rem; }
+    .profile-stats { grid-template-columns: 1fr; }
+}
+
+/* ---------------- PYQ बैंक: बैज व बटन ---------------- */
+.lang-badge { display: inline-block; font-size: .68rem; font-weight: 800; padding: .1rem .45rem; border-radius: 20px; margin-right: .35rem; vertical-align: middle; }
+.lang-badge.hi { background: var(--success-soft); color: var(--success); }
+.lang-badge.en { background: var(--info-soft); color: var(--accent-blue); }
+.src-badge { display: inline-block; font-size: .68rem; font-weight: 800; padding: .1rem .45rem; border-radius: 20px; margin-right: .35rem; vertical-align: middle; background: var(--warning-soft); color: var(--warning); }
+.en-note { margin-top: .5rem; font-size: .83rem; color: var(--text-muted); background: var(--info-soft); border-radius: 8px; padding: .5rem .8rem; }
+.load-more-wrap { text-align: center; margin: 1.2rem 0 2rem; }
+
+/* ---------------- क्विज़ कॉन्फ़िग ---------------- */
+.quiz-config { display: flex; gap: 1rem; flex-wrap: wrap; justify-content: center; margin-bottom: 1.2rem; }
+.quiz-config label { display: flex; flex-direction: column; gap: .3rem; font-weight: 700; font-size: .9rem; min-width: 150px; text-align: left; }
+
+/* ---------------- पिल बटन (नोट्स/मास्टरी) ---------------- */
+.notes-pills { display: flex; flex-wrap: wrap; gap: .5rem; margin-bottom: 1.2rem; }
+.pill { border: 1px solid var(--border-light); background: var(--bg-card-light); color: var(--text-dark); border-radius: 30px; padding: .45rem 1rem; font-size: .85rem; font-weight: 600; cursor: pointer; font-family: inherit; }
+.pill:hover { border-color: var(--primary); color: var(--primary); }
+.pill.active { background: var(--primary); border-color: var(--primary); color: #fff; }
+
+/* ---------------- फ्लैशकार्ड ---------------- */
+.flash-wrap { max-width: 640px; margin: 0 auto; }
+.flash-card { background: var(--bg-card-light); border: 2px solid var(--primary); border-radius: 16px; padding: 2.5rem 1.5rem; text-align: center; cursor: pointer; min-height: 220px; display: flex; flex-direction: column; justify-content: center; gap: .8rem; box-shadow: var(--shadow-md); transition: transform .15s ease; }
+.flash-card:hover { transform: translateY(-2px); }
+.flash-card.flipped { border-color: var(--success); background: var(--success-soft); }
+.flash-topic { font-size: .8rem; color: var(--text-muted); font-weight: 600; }
+.flash-face { font-size: 1.25rem; font-weight: 700; line-height: 1.6; }
+.flash-hint { font-size: .78rem; color: var(--text-muted); }
+.flash-actions { display: flex; gap: 1rem; justify-content: center; margin-top: 1.2rem; }
+
+/* ---------------- नोट्स ---------------- */
+.notes-head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-bottom: 1rem; }
+.notes-head h3 { font-size: 1.3rem; font-weight: 800; }
+.note-sec { background: var(--bg-card-light); border: 1px solid var(--border-light); border-radius: var(--radius); padding: 1.1rem 1.3rem; margin-bottom: 1rem; box-shadow: var(--shadow-sm); }
+.note-sec h4 { font-size: 1.05rem; font-weight: 800; margin-bottom: .6rem; color: var(--primary); }
+.note-sec p { margin-bottom: .5rem; line-height: 1.7; font-size: .93rem; }
+.note-formula { background: var(--primary-soft); border-left: 3px solid var(--primary); border-radius: 8px; padding: .45rem .8rem; margin: .35rem 0; font-size: .88rem; font-weight: 600; }
+.note-ex { background: var(--success-soft); border-radius: 8px; padding: .5rem .8rem; margin: .35rem 0; font-size: .87rem; line-height: 1.65; }
+
+/* ---------------- मास्टरी ---------------- */
+.mastery-master .rules-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: .7rem; margin-bottom: .5rem; }
+.rule-card { background: var(--bg-card-light); border: 1px solid var(--border-light); border-radius: 10px; padding: .7rem .9rem; font-size: .85rem; }
+.rule-card p { color: var(--text-muted); margin-top: .25rem; font-size: .82rem; }
+.weight-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: .7rem; margin: .8rem 0; }
+.weight-box { background: var(--bg-card-light); border: 1px solid var(--border-light); border-radius: 10px; padding: .6rem; text-align: center; display: flex; flex-direction: column; gap: .2rem; font-size: .85rem; }
+.weight-box span { color: var(--text-muted); font-size: .8rem; }
+.do-avoid { display: grid; grid-template-columns: 1fr 1fr; gap: .8rem; margin: .8rem 0; }
+.do-box, .avoid-box { border-radius: 10px; padding: .8rem 1rem; }
+.do-box { background: var(--success-soft); }
+.avoid-box { background: var(--error-soft); }
+.do-box h4, .avoid-box h4 { margin-bottom: .4rem; }
+.do-box ul, .avoid-box ul { padding-left: 1.1rem; font-size: .88rem; line-height: 1.7; }
+/* pd-box ग्लोबल (पैटर्न-डिटेल के बाहर भी: मास्टरी/प्लान में) */
+.pd-box { background: var(--primary-soft); border-radius: 8px; padding: .8rem 1rem; margin: .5rem 0; font-size: .9rem; line-height: 1.65; }
+.pd-box.formula { border-left: 3px solid var(--primary); }
+.pd-box.pyq { border-left: 3px solid var(--accent-gold); background: var(--warning-soft); }
+.pd-box ul { padding-left: 1.1rem; margin-top: .3rem; }
+
+/* ---------------- टाइमर ---------------- */
+.timer-card { max-width: 560px; margin: 0 auto; background: var(--bg-card-light); border: 1px solid var(--border-light); border-radius: 16px; padding: 2rem 1.5rem; text-align: center; box-shadow: var(--shadow-md); }
+.timer-display { font-size: 4rem; font-weight: 800; letter-spacing: 2px; color: var(--primary); font-variant-numeric: tabular-nums; }
+.timer-bar { margin: 1rem 0; }
+.timer-presets { display: flex; gap: .5rem; flex-wrap: wrap; justify-content: center; margin-bottom: 1rem; }
+.timer-custom { display: flex; gap: .5rem; justify-content: center; margin-bottom: 1.2rem; }
+.timer-custom .drill-input { max-width: 160px; }
+.timer-controls { display: flex; gap: .8rem; justify-content: center; flex-wrap: wrap; margin-bottom: .8rem; }
+
+@media (max-width: 640px) {
+    .do-avoid { grid-template-columns: 1fr; }
+    .weight-grid { grid-template-columns: 1fr 1fr 1fr; gap: .4rem; }
+    .timer-display { font-size: 3rem; }
+    .flash-face { font-size: 1.05rem; }
+    .quiz-config label { min-width: 130px; flex: 1; }
+}
+
+/* ---------------- टॉपिक गाइड पैनल + Learn बैज ---------------- */
+.learn-badges { display: flex; flex-wrap: wrap; gap: .35rem; margin: .5rem 0; }
+.learn-badge { font-size: .72rem; font-weight: 700; background: var(--primary-soft); color: var(--primary); border-radius: 20px; padding: .15rem .6rem; }
+.learn-badge.wt { background: var(--warning-soft); color: var(--warning); }
+.learn-badge.soon { background: var(--info-soft); color: var(--accent-blue); }
+.guide-panel { background: var(--bg-card-light); border: 1px solid var(--border-light); border-radius: var(--radius); padding: 1.2rem 1.3rem; margin-bottom: 1.2rem; box-shadow: var(--shadow-sm); }
+.guide-panel h3 { font-size: 1.02rem; font-weight: 800; margin: 1rem 0 .5rem; color: var(--primary); }
+.guide-panel h3:first-child { margin-top: 0; }
+.guide-panel ul { padding-left: 1.2rem; font-size: .9rem; line-height: 1.75; }
+.wt-table { display: grid; grid-template-columns: repeat(5, 1fr); gap: .5rem; margin-bottom: .5rem; }
+.wt-table > div { background: var(--primary-soft); border-radius: 10px; padding: .55rem .3rem; text-align: center; display: flex; flex-direction: column; gap: .15rem; font-size: .78rem; }
+.wt-table span { color: var(--text-muted); font-size: .75rem; }
+.gtype { background: var(--bg-light); border: 1px solid var(--border-light); border-radius: 10px; padding: .6rem .9rem; margin-bottom: .5rem; font-size: .88rem; line-height: 1.65; }
+@media (max-width: 640px) { .wt-table { grid-template-columns: repeat(2, 1fr); } }
+
+/* ---------------- Print ---------------- */
+@media print {
+    .main-nav, .nav-actions, .theme-toggle, .skip-link, .quiz-actions, .drill-area, .daily-start { display: none; }
+    .section { padding: 0; break-inside: avoid; }
+}
