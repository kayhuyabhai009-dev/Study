+/* ============================================================
+   गणित गुरु — SSC & Railway Maths Mastery (हिंदी) — Main Styles
+   ============================================================ */
+
+:root {
+    --bg-light: #f6f7fb;
+    --bg-dark: #14142b;
+    --bg-card-light: #ffffff;
+    --bg-card-dark: #1d1d3a;
+    --primary: #4f46e5;
+    --primary-dark: #4338ca;
+    --primary-soft: #eef2ff;
+    --accent-gold: #d4a853;
+    --accent-silver: #c0c0c0;
+    --accent-bronze: #cd7f32;
+    --accent-green: #16a34a;
+    --accent-blue: #0284c7;
+    --accent-purple: #9333ea;
+    --accent-orange: #ea580c;
+    --accent-red: #dc2626;
+    --text-dark: #1f2430;
+    --text-light: #e8eaf2;
+    --text-muted: #6b7280;
+    --border-light: #e2e4ee;
+    --border-dark: #33335c;
+    --success: #16a34a;
+    --success-soft: #e8f9ee;
+    --warning: #d97706;
+    --warning-soft: #fef3e2;
+    --error: #dc2626;
+    --error-soft: #fdeaea;
+    --info-soft: #eaf4fd;
+    --shadow-sm: 0 2px 8px rgba(31,36,48,.06);
+    --shadow-md: 0 6px 24px rgba(31,36,48,.10);
+    --radius: 12px;
+}
+
+[data-theme="dark"] {
+    --bg-light: #14142b;
+    --bg-dark: #0f0f21;
+    --bg-card-light: #1d1d3a;
+    --bg-card-dark: #161630;
+    --primary: #818cf8;
+    --primary-dark: #6366f1;
+    --primary-soft: #26264a;
+    --text-dark: #e8eaf2;
+    --text-light: #c9cbe0;
+    --text-muted: #8b8fa8;
+    --border-light: #33335c;
+    --border-dark: #26264a;
+    --success-soft: #16301f;
+    --warning-soft: #3a2c12;
+    --error-soft: #3a1a1a;
+    --info-soft: #172a3a;
+    --shadow-sm: 0 2px 8px rgba(0,0,0,.35);
+    --shadow-md: 0 6px 24px rgba(0,0,0,.45);
+}
+
+* { box-sizing: border-box; margin: 0; padding: 0; }
+
+html { font-size: 16px; scroll-behavior: smooth; }
+
+@media (prefers-reduced-motion: reduce) {
+    html { scroll-behavior: auto; }
+    *, *::before, *::after { animation-duration: 0s !important; transition-duration: 0s !important; }
+}
+
+body {
+    font-family: 'Mukta', 'Noto Sans Devanagari', 'Inter', sans-serif;
+    background: var(--bg-light);
+    color: var(--text-dark);
+    line-height: 1.7;
+    overflow-x: hidden;
+}
+
+img, svg { max-width: 100%; height: auto; }
+a { text-decoration: none; color: inherit; transition: color .2s ease; }
+ul { list-style: none; }
+button { font-family: inherit; cursor: pointer; border: none; background: none; padding: 0; font-size: inherit; }
+
+.muted { color: var(--text-muted); font-size: .875rem; }
+.card { background: var(--bg-card-light); border-radius: var(--radius); padding: 1.5rem; border: 1px solid var(--border-light); box-shadow: var(--shadow-sm); }
+
+.skip-link { position: absolute; left: -9999px; top: auto; width: 1px; height: 1px; overflow: hidden; }
+.skip-link:focus { left: 0; top: 0; width: auto; height: auto; padding: .5rem; background: var(--primary); color: #fff; z-index: 999; }
+
+button:focus-visible, a:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible { outline: 2px solid var(--primary); outline-offset: 2px; }
+
+/* ---------------- Navigation ---------------- */
+.main-nav {
+    background: var(--bg-card-light);
+    backdrop-filter: blur(10px);
+    -webkit-backdrop-filter: blur(10px);
+    border-bottom: 1px solid var(--border-light);
+    padding: .75rem 1.5rem;
+    position: sticky;
+    width: 100%;
+    top: 0;
+    z-index: 100;
+    display: flex;
+    align-items: center;
+    gap: 1rem;
+    flex-wrap: wrap;
+}
+.nav-logo { display: flex; align-items: center; gap: .5rem; }
+.nav-logo svg { width: 26px; height: 26px; color: var(--primary); }
+.nav-logo span { font-weight: 800; font-size: 1.25rem; color: var(--primary); letter-spacing: -.01em; }
+.nav-links { display: flex; gap: .25rem; align-items: center; flex-wrap: wrap; }
+.nav-links li a {
+    font-weight: 600; font-size: .875rem; color: var(--text-dark);
+    padding: .35rem .7rem; border-radius: 8px; position: relative; transition: all .2s ease; white-space: nowrap;
+}
+.nav-links li a:hover { color: var(--primary); background: var(--primary-soft); }
+.nav-links li a.active { color: #fff; background: var(--primary); }
+.nav-actions { margin-left: auto; display: flex; align-items: center; gap: .5rem; }
+.btn-icon { width: 40px; height: 40px; border-radius: 10px; display: flex; align-items: center; justify-content: center; background: var(--bg-card-light); color: var(--text-dark); border: 1px solid var(--border-light); transition: all .2s ease; }
+.btn-icon:hover { background: var(--primary); color: #fff; border-color: var(--primary); }
+.menu-toggle { display: none; }
+
+/* ---------------- Sections ---------------- */
+.section { padding: 4rem 1.5rem 2rem; max-width: 1280px; margin: 0 auto; display: none; }
+.section.active { display: block; animation: fadeIn .3s ease; }
+@keyframes fadeIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
+
+.section-header { text-align: center; margin-bottom: 2rem; }
+.section-header h2 { font-weight: 800; font-size: 2rem; margin-bottom: .4rem; letter-spacing: -.02em; }
+.section-header p { color: var(--text-muted); font-size: 1.05rem; max-width: 720px; margin: 0 auto; }
+
+/* ---------------- Buttons ---------------- */
+.btn { padding: .65rem 1.4rem; border-radius: 10px; font-weight: 700; font-size: .95rem; transition: all .2s ease; display: inline-flex; align-items: center; gap: .4rem; justify-content: center; }
+.btn-primary { background: var(--primary); color: #fff; }
+.btn-primary:hover { background: var(--primary-dark); transform: translateY(-1px); box-shadow: var(--shadow-md); }
+.btn-danger { background: var(--error-soft); color: var(--error); border: 1px solid var(--error); }
+.btn-danger:hover { background: var(--error); color: #fff; }
+.btn-lg { padding: 1rem 2.2rem; font-size: 1.1rem; }
+.btn:active { transform: scale(.97); }
+
+/* ---------------- Dashboard ---------------- */
+.dashboard-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 1rem; margin-bottom: 1.5rem; }
+.stat-card {
+    background: var(--bg-card-light); border-radius: var(--radius); padding: 1.25rem;
+    border: 1px solid var(--border-light); display: flex; align-items: center; gap: .9rem;
+    transition: transform .2s ease, box-shadow .2s ease; box-shadow: var(--shadow-sm);
+}
+.stat-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); }
+.stat-icon { font-size: 1.8rem; }
+.stat-value { font-weight: 800; font-size: 1.7rem; line-height: 1.2; color: var(--primary); }
+.stat-label { font-size: .78rem; color: var(--text-muted); }
+.card-gold { border-color: var(--accent-gold); }
+.card-silver { border-color: var(--accent-silver); }
+.card-bronze { border-color: var(--accent-bronze); }
+.card-green { border-color: var(--accent-green); }
+.card-blue { border-color: var(--accent-blue); }
+.card-purple { border-color: var(--accent-purple); }
+
+.today-focus { margin-bottom: 1.5rem; border-left: 4px solid var(--accent-gold); }
+.today-focus h3 { margin-bottom: .5rem; font-weight: 800; }
+.today-focus li { list-style: none; padding: .25rem 0; }
+.today-focus li::before { content: "• "; color: var(--primary); font-weight: 800; }
+
+.quick-actions { margin-top: 1rem; }
+.quick-actions h3 { font-weight: 800; margin-bottom: .8rem; }
+.actions-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: .75rem; }
+.action-btn {
+    width: 100%; padding: .9rem 1rem; background: var(--bg-card-light); border-radius: 10px;
+    border: 1px solid var(--border-light); color: var(--text-dark); font-weight: 700; font-size: .9rem;
+    transition: all .2s ease; display: flex; align-items: center; justify-content: center; gap: .5rem; box-shadow: var(--shadow-sm);
+}
+.action-btn:hover { background: var(--primary); color: #fff; border-color: var(--primary); transform: translateY(-2px); }
+.action-btn:active { transform: scale(.98); }
+
+/* ---------------- Learn cards ---------------- */
+.learn-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.25rem; }
+.learn-card {
+    background: var(--bg-card-light); border-radius: var(--radius); padding: 1.4rem;
+    border: 1px solid var(--border-light); transition: all .2s ease; cursor: pointer; box-shadow: var(--shadow-sm);
+    display: flex; flex-direction: column; gap: .6rem;
+}
+.learn-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); border-color: var(--primary); }
+.learn-card .lc-icon { font-size: 2rem; }
+.learn-card h4 { font-size: 1.1rem; font-weight: 800; color: var(--primary); }
+.learn-card p { color: var(--text-muted); font-size: .85rem; flex-grow: 1; }
+.learn-card .tags { display: flex; flex-wrap: wrap; gap: .3rem; }
+.tag { display: inline-block; padding: .2rem .55rem; background: var(--primary-soft); color: var(--primary); border-radius: 6px; font-size: .72rem; font-weight: 700; }
+
+/* ---------------- Search ---------------- */
+.search-wrap { max-width: 640px; margin: 0 auto 1.5rem; }
+.search-input, .form-input, .filter-select, .drill-input {
+    width: 100%; padding: .7rem 1rem; background: var(--bg-card-light); border: 1px solid var(--border-light);
+    border-radius: 10px; color: var(--text-dark); font-size: .95rem; font-family: inherit;
+}
+.search-input:focus, .form-input:focus { border-color: var(--primary); }
+.form-input { margin-bottom: .9rem; }
+.form-input option { background: var(--bg-card-light); }
+
+/* ---------------- Formula book ---------------- */
+#formula-chapters { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1rem; }
+.chapter-card {
+    background: var(--bg-card-light); border-radius: var(--radius); padding: 1.3rem;
+    border: 1px solid var(--border-light); cursor: pointer; transition: all .2s ease; box-shadow: var(--shadow-sm);
+}
+.chapter-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); border-color: var(--primary); }
+.chapter-card .cc-head { display: flex; align-items: center; gap: .7rem; margin-bottom: .4rem; }
+.chapter-card .cc-icon { font-size: 1.7rem; }
+.chapter-card h3 { font-weight: 800; font-size: 1.05rem; }
+.chapter-card p { color: var(--text-muted); font-size: .82rem; }
+.chapter-card .cc-count { display: inline-block; margin-top: .5rem; background: var(--primary-soft); color: var(--primary); font-size: .72rem; font-weight: 700; padding: .15rem .6rem; border-radius: 20px; }
+
+#formula-detail { margin-top: 1.5rem; }
+.formula-block { background: var(--bg-card-light); border: 1px solid var(--border-light); border-radius: var(--radius); padding: 1.5rem; margin-bottom: 1.25rem; box-shadow: var(--shadow-sm); }
+.formula-block h3 { font-weight: 800; font-size: 1.15rem; margin-bottom: .8rem; color: var(--primary); }
+.fb-row { margin-bottom: .8rem; }
+.fb-row .fb-label { display: block; font-size: .75rem; font-weight: 800; text-transform: uppercase; letter-spacing: .05em; color: var(--text-muted); margin-bottom: .2rem; }
+.fb-box { background: var(--bg-light); border: 1px solid var(--border-light); border-radius: 10px; padding: .9rem 1.1rem; font-size: .95rem; }
+.fb-box.formula { border-left: 4px solid var(--primary); background: var(--primary-soft); font-weight: 700; }
+.fb-box.example { border-left: 4px solid var(--accent-green); background: var(--success-soft); }
+.fb-box.trap { border-left: 4px solid var(--accent-red); background: var(--error-soft); }
+.fb-box.pyq { border-left: 4px solid var(--accent-gold); background: var(--warning-soft); }
