+{"id": "P3173", "q": "( sec θ − tan θ)² ( 1 + sin θ)² ÷ = ? sin 2 θ", "o": ["cos", "sec", "θ cot 2 θ θ cos 2 θ"], "ol": ["a", "c", "d"], "a": "b", "e": "SSC CGL", "y": "2019", "t": "त्रिकोणमिति", "d": "कठिन", "p": "general", "lang": "en", "sol": "( sec θ − tan θ)² ( 1 + sin θ)² ÷ sin 2 θ = ( )²¹ cos θ − sin θ cos θ ( 1 + sin θ)² ÷ sin 2 θ = ( )²¹ − sin θ cos θ ( 1 + sin θ)² ÷ sin 2 θ = [ 1 cos 2 θ ( 1 + sin θ) ( 1 − sin θ) ]² ÷ = sin 2 θ 1 cos 2 θ [( 1 − sin 2 θ) ]² ÷ sin 2 θ = = 1 cos 2 θ [ cos 2 θ ]² ÷ sin 2 θ cot 2 θ = = 1 sin 2 θ [ cos 2 θ ] cot 2 θ"},
+{"id": "P3174", "q": "The value of cosec θ − cot θ cosec θ + cot θ is equal to : ÷ sin θ 1 + cos θ", "o": ["cosec", "sec", "1 θ 1² θ"], "ol": ["a", "c", "d"], "a": "d", "e": "SSC CGL", "y": "2019", "t": "त्रिकोणमिति", "d": "कठिन", "p": "general", "lang": "en", "sol": "cosec θ − cot θ cosec θ + cot θ ÷ sin θ 1 + cos θ ⇒ cosec θ − cot θ cosec θ + cot θ × cosec θ − cot θ cosec θ − cot θ ÷ sin θ 1 + cos θ ⇒ ( cosec θ − cot θ)² cosec 2 θ − cot 2 θ ÷ sin θ 1 + cos θ ⇒ cosec θ − cot θ ÷ sin θ 1 + cos θ ⇒ 1 sin θ − cos θ sin θ ÷ sin θ 1 + cos θ = 1 ⇒ 1 − cos θ sin θ × 1 + cos θ sin θ (1- cos² = sin² ) ⇒ θ θ"},
+{"id": "P3175", "q": "If sec + tan = p, (p > 1) then θ θ = ? cosec θ + 1 cosec θ − 1", "o": ["2", "p", "+", "1"], "ol": ["a", "b", "c", "d"], "a": "b", "e": "SSC CGL", "y": "2019", "t": "त्रिकोणमिति", "d": "कठिन", "p": "general", "lang": "en", "sol": "Given, sec + tan = p …… (1) θ θ sec - tan = …… (2) ⇒ θ θ 1 p Add (1) and (2)²sec = p + ⇒ θ 1 p Put p = 2, sec = = ⇒ θ Hypotenuse Base 5⁴ cosec = = ⇒ θ Hypotenuse Perpendicular 5³ = = = 4 cosec θ + 1 cosec θ − 1⁵ 3 + 1⁵ 3 − 1⁸ 3² 3 Going through options Chose option b = = 4 ⇒ p² 2² Condition satisfied."},
