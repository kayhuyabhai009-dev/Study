+{"id": "P2781", "q": "Simplify the following: 7(cot 11° cot 13° cot 19° cot 29° cot 61°cot 71° cot 77° cot 79°)", "o": ["7", "- 7", "- 1", "1"], "ol": ["a", "b", "c", "d"], "a": "a", "e": "SSC CHSL", "y": "2023", "t": "त्रिकोणमिति", "d": "मध्यम", "p": "general", "lang": "en", "sol": "If A + B = 90° , then cot A × cot B = 1 = 7(cot 11° cot 13° cot 19° cot 29° cot 61° cot 71° cot 77° cot 79°) = 7(cot 11° × cot 79°)( cot 13° × cot 77°) (cot 19° × cot 71°) (cot 29° × cot 61°) = 7(1 × 1 × 1 × 1) = 7"},
+{"id": "P2782", "q": "The given expression is equal to : sin 4 A + cos 4 A¹ − 2 sin 2 A cos 2 A", "o": ["1", "-1", "0", "2"], "ol": ["a", "b", "c", "d"], "a": "a", "e": "SSC CHSL", "y": "2023", "t": "त्रिकोणमिति", "d": "मध्यम", "p": "general", "lang": "en", "sol": "+ = 1 sin 2 A cos 2 A + + = 1 sin 4 A cos 4 A² sin 2 A . cos 2 A + = 1 sin 4 A cos 4 A − 2 sin 2 A . cos 2 A = 1 sin 4 A + cos 4 A¹ − 2 sin 2 A cos 2 A"},
