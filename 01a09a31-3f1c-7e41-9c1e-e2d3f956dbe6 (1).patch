+        ${isBest ? '<p class="drill-best">🏆 नया रिकॉर्ड!</p>' : '<p class="muted">सर्वश्रेष्ठ: ' + prevBest + ' — और अभ्यास कीजिए!</p>'}
+        <button class="btn btn-primary" onclick="startDrill('${d.gen}')">🔁 फिर से खेलें</button>`;
+    activeDrill = null;
+    updateDashboard();
+    updateProfile();
+}
