+{"id": "P3013", "q": "If tan A tan B + = 1, cos x cosAcosB then x = ?", "o": ["B", "A", "A + B", "A – B"], "ol": ["a", "b", "c", "d"], "a": "c", "e": "SSC CGL", "y": "2022", "t": "त्रिकोणमिति", "d": "मध्यम", "p": "general", "lang": "en", "sol": "tanA tanB + = 1 cos x cosAcosB = + = 1 sinAsinB cosAcosB cos x cosAcosB = = 1 sinAsinB + cos x cosAcosB = sinA sinB + cos x = cosA cosB = cos x = cosAcosB - sinAsinB = cos x = cos(A + B) x = A + B ⇒"},
