+{"id": "P0261", "q": "(a + 1)² + (a + 2)² = 16 then what is the value of 40 + 12a + 4a² ?", "o": ["56", "62", "74", "52"], "ol": ["a", "b", "c", "d"], "a": "b", "e": "SSC CGL", "y": "2022", "t": "बीजगणित", "d": "मध्यम", "p": "general", "lang": "en", "sol": "( a + 1 )² + ( a + 2 )² = 16 ⇒ a² + 2 a + 1 + a² + 4 a + 4 = 16 ⇒ 2 a² + 6 a + 5 = 16 ⇒ 2 ( 2 a² + 6 a + 5 ) = 16 × 2 ⇒ 4 a² + 12 a + 10 = 32 So, 4 a² + 12 a + 10 + 30 = 32 + 30 ⇒ 4 a² + 12 a + 40 = 62"},
