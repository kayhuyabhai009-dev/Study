+    padding: 2rem;
+    text-align: center;
+    transition: all 0.3s ease;
+    margin-bottom: 1rem;
+    cursor: pointer;
+}
+
+.pdf-library-zone:hover {
+    border-color: var(--primary);
+    background: var(--bg-light);
+}
+
+.pdf-library-zone.drag-over {
+    border-color: var(--primary);
+    background: var(--bg-light);
+}
+
+.pdf-library-icon {
+    width: 48px;
+    height: 48px;
+    margin: 0 auto 0.5rem;
+    opacity: 0.6;
+}
+
+.pdf-library-zone p {
+    color: var(--text-muted);
+    font-size: 0.875rem;
+}
+
+.pdf-library-zone small {
+    color: var(--text-muted);
+    font-size: 0.7rem;
+}
+
+.pdf-library-input {
+    display: none;
+}
+
+.pdf-file-item {
+    background: var(--bg-light);
+    border-radius: 6px;
+    padding: 0.75rem 1rem;
+    margin-bottom: 0.5rem;
+    border: 1px solid var(--border-light);
+    display: flex;
+    justify-content: space-between;
+    align-items: center;
+    flex-wrap: wrap;
+    gap: 0.5rem;
+}
+
+.pdf-file-item .file-info {
+    display: flex;
+    flex-direction: column;
+}
+
+.pdf-file-item .file-name {
+    font-weight: 500;
+    color: var(--text-dark);
+    font-size: 0.875rem;
+    white-space: nowrap;
+    overflow: hidden;
+    text-overflow: ellipsis;
+    max-width: 60%;
+}
+
+.pdf-file-item .file-details {
+    font-size: 0.7rem;
+    color: var(--text-muted);
+    display: flex;
+    align-items: center;
+    gap: 0.5rem;
+}
+
+.pdf-file-item .remove-btn {
+    background: var(--error);
+    color: white;
+    border: none;
+    border-radius: 4px;
+    padding: 0.25rem 0.5rem;
+    font-size: 0.7rem;
+    cursor: pointer;
+}
+
+.pdf-file-item .remove-btn:hover {
+    background: #c0392b;
+}
+
+.pdf-summary {
+    background: var(--bg-card-light);
+    border-radius: 8px;
+    padding: 1rem;
+    border: 1px solid var(--border-light);
+    margin-top: 1rem;
+}
+
+.pdf-summary-item {
+    display: flex;
+    justify-content: space-between;
+    align-items: center;
+    padding: 0.25rem 0;
+    border-bottom: 1px solid var(--border-light);
+}
+
+.pdf-summary-item:last-child {
+    border-bottom: none;
+}
+
+.pdf-summary-label {
+    font-size: 0.75rem;
+    color: var(--text-muted);
+}
+
+.pdf-summary-value {
+    font-family: 'DM Sans', sans-serif;
+    font-weight: 600;
+    color: var(--primary);
+}
+
+/* Focus states */
+button:focus-visible, a:focus-visible {
+    outline: 2px solid var(--primary);
+    outline-offset: 2px;
+}
+
+/* Reduced motion */
+@media (prefers-reduced-motion: reduce) {
+    .stat-card, .learn-card, .pyq-item, .pattern-card, .trap-card, .speed-module, .error-item, .rev-option {
+        transition: none;
+    }
+    .progress-fill {
+        transition: width 0s;
+    }
+}
+
+/* Loading skeleton */
+.skeleton {
+    background: var(--border-light);
+    border-radius: 4px;
+    animation: skeleton-loading 1.5s infinite ease-in-out;
+}
+
+@keyframes skeleton-loading {
+    0% { background-color: #f0f0f0; }
+    50% { background-color: #e0e0e0; }
+    100% { background-color: #f0f0f0; }
+}
+
+.skeleton-text {
+    height: 12px;
+    width: 70%;
+    margin: 5px 0;
+}
+
+/* Print styles */
+@media print {
+    .main-nav, .theme-toggle, .skip-link {
+        display: none;
+    }
+    
+    .section {
+        padding: 0;
+        break-inside: avoid;
+    }
+}
