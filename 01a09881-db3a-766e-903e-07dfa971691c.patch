+        flex-direction: column;
+        gap: 1rem;
+        padding: 1rem;
+    }
+    
+    .main-nav .nav-links.active {
+        display: flex;
+    }
+    
+    .main-nav .menu-toggle {
+        display: block;
+    }
+    
+    .actions-grid {
+        grid-template-columns: 1fr;
+    }
+}
+
