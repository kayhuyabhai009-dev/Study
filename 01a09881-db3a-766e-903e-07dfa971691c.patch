+/* ============================================================
+   Ultimate Mathematics Mastery Engine - Main Styles
+   ============================================================ */
+
+:root {
+    --bg-light: #f8f9fa;
+    --bg-dark: #1a1a2e;
+    --bg-card-light: #ffffff;
+    --bg-card-dark: #16213e;
+    --primary: #2c3e50;
+    --primary-light: #34495e;
+    --accent-gold: #d4a853;
+    --accent-silver: #c0c0c0;
+    --accent-bronze: #cd7f32;
+    --accent-green: #27ae60;
+    --accent-blue: #3498db;
+    --accent-purple: #9b59b6;
+    --text-dark: #2c3e50;
+    --text-light: #ecf0f1;
+    --text-muted: #7f8c8d;
+    --border-light: #e0e0e0;
+    --border-dark: #2d3a4f;
+    --success: #27ae60;
+    --warning: #f39c11;
+    --error: #e74c3c;
+}
+
+/* Dark mode */
+[data-theme="dark"] {
+    --bg-light: #1a1a2e;
+    --bg-dark: #16213e;
+    --bg-card-light: #16213e;
+    --bg-card-dark: #0f0f23;
+    --primary: #3498db;
+    --primary-light: #2c3e50;
+    --text-dark: #e8e6e3;
+    --text-light: #bdc3c7;
+    --text-muted: #6c757d;
+    --border-light: #354157;
+    --border-dark: #1a252f;
+}
+
+/* Base styles */
+* {
+    box-sizing: border-box;
+    margin: 0;
+    padding: 0;
+}
+
+html {
+    font-size: 16px;
+}
+
+@media (prefers-reduced-motion: reduce) {
+    html { scroll-behavior: auto; }
+    *, *::before, *::after { animation-duration: 0s !important; transition-duration: 0s !important; }
+}
+
+body {
+    font-family: 'Inter', sans-serif;
+    background: var(--bg-light);
+    color: var(--text-dark);
+    line-height: 1.6;
+    overflow-x: hidden;
+}
+
+/* When system prefers dark mode */
+@media (prefers-color-scheme: dark) and (forced-colors: none) {
+    body { background: var(--bg-dark); color: var(--text-light); }
+}
+
+img, svg, video {
+    max-width: 100%;
+    height: auto;
+}
+
+a {
+    text-decoration: none;
+    color: inherit;
+    transition: color 0.2s ease;
+}
+
+ul {
+    list-style: none;
+}
+
+button {
+    font-family: inherit;
+    cursor: pointer;
+    border: none;
+    background: none;
+    padding: 0;
+    font-size: inherit;
+}
+
+@media (forced-colors: active) {
+    :root {
+        --bg-light: WindowColor;
+        --bg-dark: WindowText;
+        --text-dark: WindowText;
+    }
+}
+
+/* Skip link for accessibility */
+.skip-link {
+    position: absolute;
+    left: -9999px;
+    top: auto;
+    width: 1px; height: 1px;
+    overflow: hidden;
+}
+
+.skip-link:focus {
+    left: 0;
+    top: 0;
+    width: auto;
+    height: auto;
+    padding: 0.5rem;
+    background: var(--primary);
+    color: white;
+}
+
+/* Navigation */
+.main-nav {
+    background: var(--bg-card-light);
+    backdrop-filter: blur(10px);
+    -webkit-backdrop-filter: blur(10px);
+    border-bottom: 1px solid var(--border-light);
+    padding: 1rem 2rem;
+    position: fixed;
+    width: 100%;
+    top: 0;
+    z-index: 100;
+}
+
+.main-nav .nav-logo {
+    display: flex;
+    align-items: center;
+    gap: 0.5rem;
+}
+
+.main-nav .nav-logo svg {
+    width: 24px;
+    height: 24px;
+}
+
+.main-nav .nav-logo span {
+    font-family: 'DM Sans', sans-serif;
+    font-weight: 700;
+    font-size: 1.2rem;
+    color: var(--primary);
+}
+
+.main-nav .nav-links {
+    display: flex;
+    gap: 2rem;
+    align-items: center;
+}
+
+.main-nav .nav-links li a {
+    font-family: 'DM Sans', sans-serif;
+    font-weight: 500;
+    font-size: 0.875rem;
+    color: var(--text-dark);
+    position: relative;
+    padding-bottom: 0.25rem;
+}
+
+.main-nav .nav-links li a::after {
+    content: '';
+    position: absolute;
+    bottom: 0;
+    left: 0;
+    width: 0;
+    height: 2px;
+    background: var(--primary);
+    transition: width 0.3s ease;
+}
+
+.main-nav .nav-links li a:hover {
+    color: var(--primary);
+}
+
+.main-nav .nav-links li a:hover::after {
+    width: 100%;
+}
+
+.main-nav .nav-actions {
+    margin-left: auto;
+    display: flex;
+    align-items: center;
+    gap: 1rem;
+}
+
+.main-nav .btn-icon {
+    width: 44px;
+    height: 44px;
+    border-radius: 8px;
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    background: var(--bg-card-light);
+    color: var(--text-dark);
+    transition: background 0.2s ease, color 0.2s ease;
+}
+
+.main-nav .btn-icon:hover {
+    background: var(--primary);
+    color: white;
+}
+
+/* Sections */
+.section {
+    padding: 8rem 2rem 2rem;
+    max-width: 1200px;
+    margin: 0 auto;
+}
+
+.section-header {
+    text-align: center;
+    margin-bottom: 3rem;
+}
+
+.section-header h2 {
+    font-family: 'DM Sans', sans-serif;
+    font-weight: 700;
+    font-size: 2.25rem;
+    margin-bottom: 0.5rem;
+    background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
+    -webkit-background-clip: text;
+    -webkit-text-fill-color: transparent;
+    background-clip: text;
+}
+
+.section-header p {
+    color: var(--text-muted);
+    font-size: 1.125rem;
+}
+
+/* Dashboard */
+.dashboard-grid {
+    display: grid;
+    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
+    gap: 1.5rem;
+    margin-top: 2rem;
+}
+
+.stat-card {
+    background: var(--bg-card-light);
+    border-radius: 12px;
+    padding: 1.5rem;
+    border: 1px solid var(--border-light);
+    transition: transform 0.2s ease, box-shadow 0.2s ease;
+}
+
+.stat-card:hover {
+    transform: translateY(-2px);
+    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
+}
+
+.stat-card:hover .stat-icon svg {
+    stroke: var(--primary);
+}
+
+.stat-icon {
+    width: 40px;
+    height: 40px;
+    margin-bottom: 1rem;
+}
+
+.stat-value {
+    font-family: 'DM Sans', sans-serif;
+    font-weight: 800;
+    font-size: 2.25rem;
+    color: var(--primary);
+    margin-bottom: 0.25rem;
+}
+
+.stat-label {
+    font-size: 0.875rem;
+    color: var(--text-muted);
+}
+
+.card-gold { border: 1px solid #ffd700; }
+.card-silver { border: 1px solid var(--accent-silver); }
+.card-bronze { border: 1px solid var(--accent-bronze); }
+.card-green { border: 1px solid var(--accent-green); }
+.card-blue { border: 1px solid var(--accent-blue); }
+.card-purple { border: 1px solid var(--accent-purple); }
+
+/* Quick Actions */
+.quick-actions {
+    margin-top: 2rem;
+}
+
+.quick-actions h3 {
+    font-size: 1rem;
+    font-weight: 600;
+    margin-bottom: 1rem;
+    color: var(--text-dark);
+}
+
+.actions-grid {
+    display: grid;
+    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
+    gap: 1rem;
+}
+
+.action-btn {
+    width: 100%;
+    padding: 0.875rem 1rem;
+    background: var(--bg-card-light);
+    border-radius: 8px;
+    border: 1px solid var(--border-light);
+    color: var(--text-dark);
+    font-weight: 500;
+    font-size: 0.875rem;
+    transition: all 0.2s ease;
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    gap: 0.5rem;
+}
+
+.action-btn:hover {
+    background: var(--primary);
+    color: white;
+    border-color: var(--primary);
+}
+
+.action-btn:active {
+    transform: scale(0.98);
+}
+
+/* Learn Mathematics */
+.learn-filters {
+    background: var(--bg-card-light);
+    padding: 1rem 1.5rem;
+    border-radius: 8px;
+    border: 1px solid var(--border-light);
+    margin-bottom: 2rem;
+    display: flex;
+    gap: 1rem;
+    flex-wrap: wrap;
+    justify-content: center;
+}
+
+.filter-select {
+    padding: 0.5rem 1rem;
+    background: var(--bg-light);
+    border: 1px solid var(--border-light);
+    border-radius: 6px;
+    color: var(--text-dark);
+    font-size: 0.875rem;
+    min-width: 150px;
+}
+
+.learn-cards {
+    display: grid;
+    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
+    gap: 1.5rem;
+}
+
+.learn-card {
+    background: var(--bg-card-light);
+    border-radius: 10px;
+    padding: 1.5rem;
+    border: 1px solid var(--border-light);
+    transition: transform 0.2s ease, box-shadow 0.2s ease;
+}
+
+.learn-card:hover {
+    transform: translateY(-4px);
+    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);
+}
+
+.learn-card h4 {
+    font-size: 1rem;
+    font-weight: 600;
+    margin-bottom: 0.75rem;
+    color: var(--primary);
+}
+
+.learn-card p {
+    color: var(--text-muted);
+    font-size: 0.875rem;
+    line-height: 1.5;
+}
+
+.learn-card .tag {
+    display: inline-block;
+    padding: 0.25rem 0.5rem;
+    background: var(--primary-light);
+    color: white;
+    border-radius: 4px;
+    font-size: 0.7rem;
+    margin-right: 0.25rem;
+    margin-bottom: 0.25rem;
+}
+
+/* PYQ Database */
+.pyq-filters {
+    background: var(--bg-card-light);
+    padding: 1rem 1.5rem;
+    border-radius: 8px;
+    border: 1px solid var(--border-light);
+    margin-bottom: 2rem;
+    display: flex;
+    gap: 1rem;
+    flex-wrap: wrap;
+    justify-content: center;
+}
+
+.pyq-list {
+    display: grid;
+    gap: 1rem;
+}
+
+.pyq-item {
+    background: var(--bg-card-light);
+    border-radius: 8px;
+    padding: 1rem;
+    border: 1px solid var(--border-light);
+    transition: all 0.2s ease;
+    cursor: pointer;
+}
+
+.pyq-item:hover {
+    border-color: var(--primary);
+    transform: translateX(4px);
+}
+
+.pyq-item .pyq-header {
+    display: flex;
+    justify-content: space-between;
+    align-items: flex-start;
+    margin-bottom: 0.5rem;
+}
+
+.pyq-item .pyq-topic {
+    font-size: 0.75rem;
+    color: var(--primary);
+    font-weight: 500;
+}
+
+.pyq-item .pyq-exam {
+    font-size: 0.7rem;
+    color: var(--text-muted);
+}
+
+.pyq-item .pyq-question {
+    font-size: 0.875rem;
+    color: var(--text-dark);
+    margin-bottom: 0.5rem;
+    white-space: nowrap;
+    overflow: hidden;
+    text-overflow: ellipsis;
+    max-width: 80%;
+}
+
+.pyq-item .pyq-options {
+    font-size: 0.7rem;
+    color: var(--text-muted);
+    margin-top: 0.25rem;
+}
+
+.no-data {
+    padding: 2rem;
+    text-align: center;
+    color: var(--text-muted);
+    background: var(--bg-card-light);
+    border-radius: 8px;
+    border: 1px solid var(--border-light);
+}
+
+/* Pattern Recognition */
+.patterns-grid {
+    display: grid;
+    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
+    gap: 1.5rem;
+}
+
+.pattern-card {
+    background: var(--bg-card-light);
+    border-radius: 10px;
+    padding: 1.5rem;
+    border: 1px solid var(--border-light);
+    transition: transform 0.2s ease, box-shadow 0.2s ease;
+    cursor: pointer;
+}
+
+.pattern-card:hover {
+    transform: translateY(-4px);
+    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);
+}
+
+.pattern-card h3 {
+    font-size: 1.125rem;
+    font-weight: 600;
+    margin-bottom: 0.75rem;
+    color: var(--primary);
+}
+
+.pattern-card .pattern-name {
+    display: inline-block;
+    padding: 0.2rem 0.5rem;
+    background: var(--primary-light);
+    color: white;
+    border-radius: 4px;
+    font-size: 0.7rem;
+    font-weight: 500;
+    margin-bottom: 0.75rem;
+}
+
+.pattern-card .recognition-signal {
+    font-size: 0.875rem;
+    color: var(--text-muted);
+    margin-bottom: 0.5rem;
+    font-family: 'DM Sans', sans-serif;
+    font-weight: 500;
+}
+
+.pattern-card .concept {
+    font-size: 0.8rem;
+    color: var(--text-muted);
+    margin: 0.25rem 0;
+}
+
+.pattern-card .best-method {
+    font-size: 0.75rem;
+    background: #e8f4fd;
+    color: var(--primary);
+    padding: 0.25rem 0.5rem;
+    border-radius: 4px;
+    margin: 0.25rem 0;
+    font-family: 'DM Sans', sans-serif;
+}
+
+.pattern-card .examiner-trap {
+    font-size: 0.7rem;
+    background: #fdf2f2;
+    color: var(--error);
+    padding: 0.25rem 0.5rem;
+    border-radius: 4px;
+    margin: 0.25rem 0;
+    font-family: 'DM Sans', sans-serif;
+}
+
+/* Trap Database */
+.trap-grid {
+    display: grid;
+    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
+    gap: 1.5rem;
+}
+
+.trap-card {
+    background: var(--bg-card-light);
+    border-radius: 10px;
+    padding: 1.5rem;
+    border: 1px solid var(--border-light);
+    transition: transform 0.2s ease, box-shadow 0.2s ease;
+    cursor: pointer;
+}
+
+.trap-card:hover {
+    transform: translateY(-2px);
+    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
+}
+
+.trap-card:hover .trap-icon svg {
+    stroke: var(--error);
+}
+
+.trap-icon {
+    width: 28px;
+    height: 28px;
+    margin-bottom: 1rem;
+}
+
+.trap-card h3 {
+    font-size: 1rem;
+    font-weight: 600;
+    margin-bottom: 0.5rem;
+    color: var(--error);
+}
+
+.trap-card .trap-type {
+    display: inline-block;
+    padding: 0.15rem 0.4rem;
+    background: #fdf2f2;
+    color: var(--error);
+    border-radius: 3px;
+    font-size: 0.7rem;
+    font-weight: 500;
+    margin-bottom: 0.5rem;
+}
+
+.trap-card .why-students {
+    font-size: 0.8rem;
+    color: var(--text-muted);
+    margin: 0.25rem 0;
+    font-style: italic;
+}
+
+.trap-card .detection {
+    font-size: 0.75rem;
+    background: #e8f4fd;
+    color: var(--primary);
+    padding: 0.2rem 0.4rem;
+    border-radius: 3px;
+    margin: 0.2rem 0;
+}
+
+.trap-card .prevention {
+    font-size: 0.75rem;
+    background: #f0fdf4;
+    color: var(--success);
+    padding: 0.2rem 0.4rem;
+    border-radius: 3px;
+    margin: 0.2rem 0;
+}
+
+/* Speed Maths */
+.speed-modules {
+    display: grid;
+    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
+    gap: 1rem;
+}
+
+.speed-module {
+    background: var(--bg-card-light);
+    border-radius: 8px;
+    padding: 1rem;
+    border: 1px solid var(--border-light);
+    text-align: center;
+    transition: all 0.2s ease;
+    cursor: pointer;
+}
+
+.speed-module:hover {
+    border-color: var(--primary);
+    transform: translateY(-2px);
+}
+
+.speed-module:hover .module-icon svg {
+    stroke: var(--primary);
+}
+
+.module-icon {
+    width: 40px;
+    height: 40px;
+    margin: 0 auto 0.75rem;
+    stroke: var(--primary);
+    stroke-width: 1.5;
+}
+
+.module-title {
+    font-family: 'DM Sans', sans-serif;
+    font-weight: 600;
+    font-size: 0.875rem;
+    margin-bottom: 0.25rem;
+}
+
+.module-progress {
+    width: 100%;
+    height: 4px;
+    background: var(--border-light);
+    border-radius: 2px;
+    overflow: hidden;
+    margin-top: 0.25rem;
+}
+
+.module-progress .progress {
