+    font-weight: 700;
+    font-size: 1.5rem;
+    margin-bottom: 0.5rem;
+}
+
+.profile-card p {
+    color: var(--text-muted);
+    margin-bottom: 1rem;
+}
+
+.progress-bar {
+    width: 100%;
+    height: 8px;
+    background: var(--border-light);
+    border-radius: 4px;
+    overflow: hidden;
+    margin: 1rem 0;
+}
+
+.progress-fill {
+    height: 100%;
+    width: 0%;
+    background: linear-gradient(90deg, var(--accent-green), var(--accent-blue));
+    transition: width 0.5s ease;
+    border-radius: 4px;
+}
+
+.achievements-list {
+    margin-top: 1rem;
+    padding-top: 1rem;
+    border-top: 1px solid var(--border-light);
+}
+
+.achievement {
+    background: var(--primary-light);
+    color: white;
+    padding: 0.5rem 0.75rem;
+    border-radius: 6px;
+    font-size: 0.75rem;
+    margin: 0.25rem 0;
+    display: inline-block;
+}
+
+/* Theme Toggle */
+.theme-toggle {
+    width: 44px;
+    height: 44px;
+    border-radius: 8px;
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    background: var(--bg-card-light);
+    color: var(--text-dark);
+    transition: background 0.2s ease, color 0.2s ease;
+}
+
+.theme-toggle:hover {
+    background: var(--primary);
+    color: white;
+}
+
+#sun-icon, #moon-icon {
+    width: 20px;
+    height: 20px;
+}
+
+/* Responsive */
+@media (max-width: 768px) {
+    .main-nav .nav-links {
+        display: none;
+    }
+    
+    .section {
+        padding: 4rem 1rem 1rem;
+    }
+    
+    .dashboard-grid {
+        grid-template-columns: 1fr;
+    }
+    
+    .learn-filters {
+        flex-direction: column;
+        align-items: stretch;
+    }
+    
+    .filter-select {
+        width: 100%;
+    }
+    
+    .pyq-filters {
+        flex-direction: column;
+        align-items: stretch;
+    }
+    
+    .plan-tabs {
+        flex-direction: column;
+        gap: 0.5rem;
+    }
+    
+    .plan-tab {
+        width: 100%;
+        text-align: left;
+    }
+    
+    .error-stats {
+        grid-template-columns: 1fr;
+    }
+    
+    .rev-option {
+        grid-template-columns: 1fr;
+    }
+}
+
